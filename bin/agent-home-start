#!/bin/sh
# Standalone supervisor; briq recipes may supply their own command.
set -eu
umask 077
: "${RUNNER_TOKEN:?Set RUNNER_TOKEN to a private random value}"
export RUNNER_CWD="${RUNNER_CWD:-/work}"
export RUNNER_STATE="${RUNNER_STATE:-$RUNNER_CWD/.runner}"
export RUNNER_LOGINS="${RUNNER_LOGINS:-$RUNNER_CWD/.logins}"
: "${CLAUDE_CONFIG_DIR:=$RUNNER_LOGINS/claude}"
: "${CODEX_HOME:=$RUNNER_LOGINS/codex}"
: "${COPILOT_HOME:=$RUNNER_LOGINS/copilot}"
: "${GROK_HOME:=$RUNNER_LOGINS/grok}"
: "${VIBE_HOME:=$RUNNER_LOGINS/vibe}"
: "${XDG_CONFIG_HOME:=$RUNNER_LOGINS/config}"
: "${GEMINI_CLI_HOME:=$RUNNER_LOGINS/gemini}"
export CLAUDE_CONFIG_DIR CODEX_HOME COPILOT_HOME GROK_HOME VIBE_HOME XDG_CONFIG_HOME GEMINI_CLI_HOME
mkdir -p "$RUNNER_CWD" "$RUNNER_STATE" "$RUNNER_LOGINS" \
  "$CLAUDE_CONFIG_DIR" "$CODEX_HOME" "$COPILOT_HOME" "$GROK_HOME" "$VIBE_HOME" \
  "$XDG_CONFIG_HOME" "$GEMINI_CLI_HOME" "$XDG_CONFIG_HOME/cursor"
chmod 700 "$RUNNER_STATE" "$RUNNER_LOGINS" \
  "$CLAUDE_CONFIG_DIR" "$CODEX_HOME" "$COPILOT_HOME" "$GROK_HOME" "$VIBE_HOME" \
  "$XDG_CONFIG_HOME" "$XDG_CONFIG_HOME/cursor" "$GEMINI_CLI_HOME"
cursor_config="$XDG_CONFIG_HOME/cursor/cli-config.json"
if [ -f "$cursor_config" ]; then
  jq '.channel = "static"' "$cursor_config" > "$cursor_config.new"
  chmod 600 "$cursor_config.new"
  mv "$cursor_config.new" "$cursor_config"
else
  printf '%s\n' '{"version":1,"editor":{"vimMode":false},"permissions":{"allow":[],"deny":[]},"channel":"static"}' > "$cursor_config"
  chmod 600 "$cursor_config"
fi
vibe_config="$VIBE_HOME/config.toml"
[ -f "$vibe_config" ] || printf '%s\n' 'enable_update_checks = false' > "$vibe_config"
chmod 600 "$vibe_config"
cd "$RUNNER_CWD"
terminal_pid=''
runner_pid=''
stop() {
  trap - TERM INT
  [ -z "$runner_pid" ] || kill "$runner_pid" 2>/dev/null || true
  [ -z "$terminal_pid" ] || kill "$terminal_pid" 2>/dev/null || true
  [ -z "$runner_pid" ] || wait "$runner_pid" 2>/dev/null || true
  [ -z "$terminal_pid" ] || wait "$terminal_pid" 2>/dev/null || true
}
trap stop TERM INT EXIT
if [ "${RUNNER_TERMINAL_ENABLED:-1}" = 1 ]; then
  ttyd --interface 127.0.0.1 --port "${RUNNER_TTYD_PORT:-7681}" --base-path /terminal --writable tmux new-session -A -s home > "$RUNNER_STATE/terminal.log" 2>&1 &
  terminal_pid=$!
fi
agent-home-runner &
runner_pid=$!
code=0
wait "$runner_pid" || code=$?
exit "$code"
