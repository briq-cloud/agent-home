#!/bin/sh
# What this agent home has, as Markdown: the agent CLIs and the terminal. The build writes
# REFERENCE.md from it; inside a home, it prints the same. The base image's tools are in its own
# reference (`sandbox-versions`, github.com/briq-cloud/sandbox).
set -u

ver() { "$@" 2> /dev/null | head -n 1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n 1; }
row() { printf '| %s | %s | %s |\n' "$1" "$2" "$3"; }

. /etc/os-release
echo "# What is in the agent home"
echo
echo "\`$(uname -m)\`, ${PRETTY_NAME}, built $(date -u +%Y-%m-%d). Printed by \`agent-home-versions\` inside the image. Everything in the [briq sandbox](https://github.com/briq-cloud/sandbox/blob/main/REFERENCE.md) is here too."
echo
echo "## Agent CLIs"
echo
echo "The vendors' own binaries, unmodified, with their self-update off: a newer version comes with the next build. Each one is signed in with the person's own account; the variable sets where it keeps the sign-in."
echo
echo "| CLI | Version | Sign-in kept under |"
echo "| --- | --- | --- |"
row "Claude Code (\`claude\`)" "$(ver claude --version)" "\`CLAUDE_CONFIG_DIR\`"
row "Codex (\`codex\`)" "$(ver codex --version)" "\`CODEX_HOME\`"
row "Copilot CLI (\`copilot\`)" "$(ver copilot --version)" "\`COPILOT_HOME\`"
row "Cursor (\`agent\`)" "$(cat /opt/cursor-agent/VERSION)" "\`XDG_CONFIG_HOME\`/cursor"
row "Grok Build (\`grok\`)" "$(ver grok --version)" "\`GROK_HOME\`"
row "Mistral Vibe (\`vibe\`)" "$(ver vibe --version)" "\`VIBE_HOME\`"
row "Gemini CLI (\`gemini\`), API key only" "$(ver gemini --version)" "\`GEMINI_CLI_HOME\`/.gemini"
echo
echo "DSH preview $(jq -r .version /opt/dsh/node_modules/@deepseek-ai/dsh/package.json) is installed at \`/opt/dsh/node_modules/.bin/dsh\`, disabled until explicitly configured ([dsh/README.md](dsh/README.md))."
echo
echo "## Terminal"
echo
echo "\`ttyd\` $(ver ttyd --version) serves it. A link a CLI opens (\`BROWSER\`, \`xdg-open\`) shows as plain text in a window of its own: \`show-url\`."
echo
echo "## Coding workspace"
echo
echo "T3 Code is available separately in the t3-cloud image."
echo "Briq CLI $(ver briq --version) is installed with a complete integrity-checked npm lockfile. Its native sign-in uses \`BRIQ_CONFIG_DIR\` (default \`RUNNER_LOGINS/config/briq\`)."
echo
echo "## Runner"
echo
echo "\`agent-home-runner\` $(jq -r .version /opt/agent-home-runner/package.json) drives the CLIs over ACP for apps ([runner/README.md](runner/README.md)), with \`claude-agent-acp\` $(jq -r .version /opt/agent-home-runner/node_modules/@agentclientprotocol/claude-agent-acp/package.json) and \`codex-acp\` $(jq -r .version /opt/agent-home-runner/node_modules/@agentclientprotocol/codex-acp/package.json), on \`@agentclientprotocol/sdk\` $(jq -r .version /opt/agent-home-runner/node_modules/@agentclientprotocol/sdk/package.json)."
echo
echo "## Downloads"
echo
echo "Each one checked against its publisher's checksum at build, or recorded where none is published."
echo
echo "| Download | sha256 | Checked against |"
echo "| --- | --- | --- |"
while IFS="$(printf '\t')" read -r what sum how; do
  row "$what" "\`$sum\`" "$how"
done < /etc/agent-home/downloads
