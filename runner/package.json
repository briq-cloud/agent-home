{
  "name": "agent-home-runner",
  "version": "0.4.0",
  "private": true,
  "description": "Drives the agent CLIs of an agent home over ACP, for apps, while nobody is connected.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "benchmark": "node benchmarks/foundation.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.98.0",
    "@agentclientprotocol/codex-acp": "2.3.0",
    "@agentclientprotocol/sdk": "2.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openrouter/sdk": "1.5.21",
    "vscode-jsonrpc": "9.0.3",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
