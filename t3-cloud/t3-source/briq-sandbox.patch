+  expect(receipts.complete(entry)).toBe(false);
+  expect(receipts.observe("child-request", "session", 2, true)).toBe(entry);
+  expect(receipts.complete(entry)).toBe(true);
+  expect(receipts.observe("child-request", "session", 2, false)).toBeUndefined();
+  expect(receipts.written("ordinary-unmanaged-request", 2)).toBeUndefined();
+});
+
