+import { describe, expect, it } from "vite-plus/test";
+import {
+  sandboxCommandRejection,
+  sandboxCreationRejection,
+  sandboxRole,
+  sandboxSessionRejection,
+  sandboxAdmittedProviders,
+} from "./briqSandbox.ts";
+
+const child = { T3_CLOUD_ROLE: "child", T3_CLOUD_THREAD_ID: "allocated" };
+const created = {
+  type: "thread.created",
+  threadId: "allocated",
+  payload: {
+    createdBy: "user",
+    modelSelection: { instanceId: "codex" },
+  },
+};
+
+describe("sandbox creation authority", () => {
+  it("denies every home creation source before event append", () => {
+    for (const createdBy of ["user", "agent", "automation", undefined])
+      expect(
+        sandboxCreationRejection(
+          { ...created, payload: { ...created.payload, createdBy } },
+          { T3_CLOUD_ROLE: "central" },
+        ),
+      ).toBeDefined();
+    for (const type of [
+      "thread.create",
+      "thread.fork",
+      "message.dispatch",
+      "thread.created.record",
+      "subagent.start",
+    ])
+      expect(
+        sandboxCommandRejection({ type, threadId: "allocated" }, { T3_CLOUD_ROLE: "central" }),
+      ).toBeDefined();
+  });
+  it("allows only the bound user thread and Codex provider", () => {
+    expect(sandboxCreationRejection(created, child)).toBeUndefined();
+    expect(sandboxCreationRejection({ ...created, threadId: "other" }, child)).toBeDefined();
+    expect(
+      sandboxCreationRejection(
+        { ...created, payload: { ...created.payload, createdBy: "agent" } },
+        child,
+      ),
+    ).toBeDefined();
+    expect(
+      sandboxCreationRejection(
+        { ...created, payload: { ...created.payload, modelSelection: { instanceId: "claude" } } },
+        child,
+      ),
+    ).toBeDefined();
+    for (const type of [
+      "thread.fork",
+      "thread.created.record",
+      "subagent.start",
+      "automation.run",
+      "multi-model.start",
+    ])
+      expect(sandboxCommandRejection({ type, threadId: "allocated" }, child)).toBeDefined();
+    expect(
+      sandboxCommandRejection({ type: "message.dispatch", threadId: "allocated" }, child),
+    ).toBeUndefined();
+  });
+  it("fails closed on missing binding or invalid role, preserving standalone", () => {
+    expect(sandboxRole({ T3_CLOUD_ROLE: "typo" })).toBe("invalid");
+    expect(sandboxCreationRejection(created, { T3_CLOUD_ROLE: "typo" })).toBeDefined();
+    expect(sandboxCreationRejection(created, { T3_CLOUD_ROLE: "child" })).toBeDefined();
+    expect(sandboxCreationRejection(created, {})).toBeUndefined();
+  });
+});
+
+describe("immutable sandbox provider admission", () => {
+  it("admits only runtime-derived central providers and rejects malformed admission", () => {
+    expect(sandboxAdmittedProviders({ T3_CLOUD_ROLE: "central" })).toEqual(["codex"]);
+    expect(
+      sandboxAdmittedProviders({
+        T3_CLOUD_ROLE: "central",
+        T3_CLOUD_ADMITTED_PROVIDERS: '["codex","claudeAgent"]',
+      }),
+    ).toEqual(["codex", "claudeAgent"]);
+    for (const value of ['["claude"]', '["codex","codex"]', "true", "[]"])
+      expect(
+        sandboxAdmittedProviders({ T3_CLOUD_ROLE: "central", T3_CLOUD_ADMITTED_PROVIDERS: value }),
+      ).toEqual([]);
+    expect(
+      sandboxAdmittedProviders({ ...child, T3_CLOUD_ADMITTED_PROVIDERS: '["claudeAgent"]' }),
+    ).toEqual([]);
+  });
+  it("rejects omitted creation, cross-provider defaults and persisted restart identity", () => {
+    const assigned = { ...child, T3_CLOUD_PROVIDER_INSTANCE_ID: "claudeAgent" };
+    const selection = { instanceId: "claudeAgent" };
+    expect(
+      sandboxCommandRejection(
+        { type: "thread.create", threadId: "allocated", modelSelection: selection },
+        assigned,
+      ),
+    ).toBeUndefined();
+    expect(
+      sandboxCommandRejection({ type: "thread.create", threadId: "allocated" }, assigned),
+    ).toBeDefined();
+    expect(
+      sandboxCommandRejection(
+        { type: "project.update", defaultModelSelection: { instanceId: "codex" } },
+        assigned,
+      ),
+    ).toBeDefined();
+    for (const instanceId of ["codex", "claude", "custom-claude"])
+      expect(
+        sandboxSessionRejection({ threadId: "allocated", instanceId }, assigned),
+      ).toBeDefined();
+    expect(
+      sandboxSessionRejection(
+        { threadId: "allocated", instanceId: "claudeAgent", persistedInstanceId: "codex" },
+        assigned,
+      ),
+    ).toBeDefined();
+    expect(
+      sandboxSessionRejection(
+        { threadId: "allocated", instanceId: "claudeAgent", persistedDriver: "codex" },
+        assigned,
+      ),
+    ).toBeDefined();
+    expect(
+      sandboxSessionRejection(
+        { threadId: "allocated", instanceId: "claudeAgent", persistedDriver: "claudeAgent" },
+        assigned,
+      ),
+    ).toBeUndefined();
+    expect(
+      sandboxSessionRejection({ threadId: "other", instanceId: "claudeAgent" }, assigned),
+    ).toBeDefined();
+  });
+});
diff --git a/apps/server/src/briqSandbox.ts b/apps/server/src/briqSandbox.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8900ed354926eec0cc726cd996616af8c9d19684
--- /dev/null
+++ b/apps/server/src/briqSandbox.ts
@@ -0,0 +1,138 @@
+type SandboxEnvironment = Readonly<Record<string, string | undefined>>;
+
+export function sandboxRole(
+  env: SandboxEnvironment = process.env,
+): "central" | "child" | "standalone" | "invalid" {
+  const role = env.T3_CLOUD_ROLE;
+  if (role === undefined || role === "standalone") return "standalone";
+  return role === "central" || role === "child" ? role : "invalid";
+}
+
+export type SandboxProviderInstanceId = "codex" | "claudeAgent";
+
+export function sandboxAssignedProvider(
+  env: SandboxEnvironment = process.env,
+): SandboxProviderInstanceId | undefined {
+  if (env.T3_CLOUD_PURPOSE === "project-source") return undefined;
+  const id = env.T3_CLOUD_PROVIDER_INSTANCE_ID ?? "codex";
+  return id === "codex" || id === "claudeAgent" ? id : undefined;
+}
+
+// Only the supervised central process receives this runtime-derived admission list.
+export function sandboxAdmittedProviders(
+  env: SandboxEnvironment = process.env,
+): ReadonlyArray<SandboxProviderInstanceId> {
+  if (sandboxRole(env) !== "central") return [];
+  if (env.T3_CLOUD_ADMITTED_PROVIDERS === undefined) return ["codex"];
+  try {
+    const ids: unknown = JSON.parse(env.T3_CLOUD_ADMITTED_PROVIDERS);
+    if (
+      Array.isArray(ids) &&
+      ids.length > 0 &&
+      ids.length <= 2 &&
+      ids.every((id) => id === "codex" || id === "claudeAgent") &&
+      new Set(ids).size === ids.length
+    )
+      return ids;
+  } catch {
+    /* Invalid supervised configuration denies allocation. */
+  }
+  return [];
+}
+
+export function sandboxCommandRejection(
+  command: {
+    readonly type: string;
+    readonly threadId?: string | undefined;
+    readonly modelSelection?: { readonly instanceId: string } | undefined;
+    readonly defaultModelSelection?: { readonly instanceId: string } | null | undefined;
+  },
+  env: SandboxEnvironment = process.env,
+): string | undefined {
+  const role = sandboxRole(env);
+  if (role === "standalone") return;
+  if (role === "invalid") return "Invalid sandbox role.";
+  if (
+    role === "child" &&
+    env.T3_CLOUD_PURPOSE === "project-source" &&
+    !command.type.startsWith("project.")
+  )
+    return "Project source sandboxes cannot run threads or models.";
+  if (command.type.startsWith("project.")) {
+    if (
+      role === "child" &&
+      (command.defaultModelSelection ?? command.modelSelection) &&
+      (command.defaultModelSelection ?? command.modelSelection)?.instanceId !==
+        sandboxAssignedProvider(env)
+    )
+      return "Project defaults must match the allocated provider.";
+    return;
+  }
+  if (role === "central")
+    return "Create a sandbox through the cloud allocator before running a thread.";
+  if (!env.T3_CLOUD_THREAD_ID || command.threadId !== env.T3_CLOUD_THREAD_ID)
+    return "This environment is bound to one allocated thread.";
+  const assigned = sandboxAssignedProvider(env);
+  if (!assigned) return "Invalid sandbox provider assignment.";
+  if (command.modelSelection && command.modelSelection.instanceId !== assigned)
+    return "The effective provider must match this sandbox allocation.";
+  if (command.type === "thread.create" && !command.modelSelection)
+    return "Sandbox thread creation requires its assigned provider explicitly.";
+  if (
+    /fork|multi-model|automation|delegated|thread.created.record|subagent.start/.test(command.type)
+  )
+    return "This operation requires a broker allocation and is unavailable in this sandbox.";
+}
+
+export function sandboxCreationRejection(
+  event: {
+    readonly type: string;
+    readonly threadId: string;
+    readonly payload?: {
+      readonly modelSelection?: { readonly instanceId: string };
+      readonly createdBy?: string | undefined;
+    };
+  },
+  env: SandboxEnvironment = process.env,
+): string | undefined {
+  if (event.type !== "thread.created" || sandboxRole(env) === "standalone") return;
+  return (
+    sandboxCommandRejection(
+      {
+        type: "thread.create",
+        threadId: event.threadId,
+        ...(event.payload?.modelSelection ? { modelSelection: event.payload.modelSelection } : {}),
+      },
+      env,
+    ) ??
+    (event.payload?.createdBy !== "user"
+      ? "Only the allocated user thread can be created in this sandbox."
+      : undefined)
+  );
+}
+
+export function sandboxSessionRejection(
+  input: {
+    readonly threadId: string;
+    readonly instanceId: string;
+    readonly persistedInstanceId?: string;
+    readonly persistedDriver?: string;
+  },
+  env: SandboxEnvironment = process.env,
+): string | undefined {
+  if (sandboxRole(env) === "standalone") return;
+  if (
+    sandboxRole(env) !== "child" ||
+    !env.T3_CLOUD_THREAD_ID ||
+    input.threadId !== env.T3_CLOUD_THREAD_ID
+  )
+    return "Provider execution requires the allocated child thread.";
+  const assigned = sandboxAssignedProvider(env);
+  if (
+    !assigned ||
+    input.instanceId !== assigned ||
+    (input.persistedInstanceId !== undefined && input.persistedInstanceId !== assigned) ||
+    (input.persistedDriver !== undefined && input.persistedDriver !== assigned)
+  )
+    return "Effective and persisted providers must match the sandbox assignment.";
+}
