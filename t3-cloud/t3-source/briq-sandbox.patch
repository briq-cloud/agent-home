+import { OrchestrationV2UserInputQuestion } from "@t3tools/contracts";
+import type { AcpAdapterV2Flavor } from "@t3tools/provider-acp/server/adapter";
+import * as Schema from "effect/Schema";
+import {
+  MANAGED_BRIDGE_REQUEST_META,
+  MANAGED_BRIDGE_ACCEPTED_METHOD,
+  MANAGED_BRIDGE_WITHDRAW_METHOD,
+} from "./managedBridgeBootstrap.ts";
+
+export const managedResponseReceipts = {
+  metadataKey: MANAGED_BRIDGE_REQUEST_META,
+  acceptedMethod: MANAGED_BRIDGE_ACCEPTED_METHOD,
+  withdrawnMethod: MANAGED_BRIDGE_WITHDRAW_METHOD,
+};
+const requestMetadata = Schema.Struct({
+  requestId: Schema.NonEmptyString,
+  questions: Schema.Array(OrchestrationV2UserInputQuestion),
+});
+export const extractManagedElicitationForm: NonNullable<
+  AcpAdapterV2Flavor["extractElicitationForm"]
+> = (request) => {
+  const metadata = request._meta?.[MANAGED_BRIDGE_REQUEST_META];
+  const parsed = Schema.decodeUnknownExit(requestMetadata)(metadata);
+  if (parsed._tag === "Failure") return undefined;
+  const questions = parsed.value.questions;
+  return {
+    questions,
+    respond: (answers) => {
+      const content: Record<string, string | ReadonlyArray<string>> = {};
+      for (const question of questions) {
+        const value = answers[question.id];
+        if (typeof value === "string") content[question.id] = value;
+        else if (Array.isArray(value))
+          content[question.id] = value.filter((item): item is string => typeof item === "string");
+      }
+      return { action: "accept", content };
+    },
+  };
+};
