+++ b/apps/server/src/sandbox/ManagedProjectSource.ts
@@ -0,0 +1,512 @@
+import { hashTelemetryId as sha256Hex } from "@t3tools/shared/telemetryId";
+import * as Crypto from "effect/Crypto";
+import {
+  EnvironmentId,
+  ProjectId,
+  type CommandId,
+  type ProjectCloneStartInput,
+  type ProjectCloneSnapshot,
+} from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import * as SqlClient from "effect/sql/SqlClient";
+import * as Stream from "effect/Stream";
+
+export class ManagedProjectError extends Schema.TaggedError<ManagedProjectError>()(
+  "ManagedProjectError",
+  {
+    reason: Schema.Literals([
+      "invalid-source",
+      "invalid-root",
+      "conflict",
+      "not-found",
+      "not-ready",
+      "identity",
+      "persistence",
+      "reconciliation",
+      "unsupported-import",
+    ]),
+  },
+) {
+  override get message() {
+    return this.reason === "unsupported-import"
+      ? "Select the existing managed project; importing its root with a new project ID is unavailable."
+      : `Managed project ${this.reason}.`;
+  }
+}
+
+export const SourceId = Schema.String.check(Schema.isPattern(/^[A-Za-z0-9_-]{16,128}$/));
+export const SourceDigest = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/));
+export const ManagedProjectSource = Schema.Struct({
+  version: Schema.Literal(1),
+  sourceId: SourceId,
+  hostProjectId: ProjectId,
+  logicalRoot: Schema.String,
+  clone: Schema.Struct({ remoteUrl: Schema.String, protocol: Schema.Literal("https") }),
+  sourceDigest: SourceDigest,
+});
+export type ManagedProjectSource = typeof ManagedProjectSource.Type;
+export const ManagedSourceAllocation = Schema.Struct({
+  purpose: Schema.Literal("project-source"),
+  sourceId: SourceId,
+  sourceDigest: SourceDigest,
+  allocationId: Schema.String,
+  environmentId: EnvironmentId,
+  projectId: ProjectId,
+  workspaceRoot: Schema.String,
+});
+export type ManagedSourceAllocation = typeof ManagedSourceAllocation.Type;
+
+export function canonicalManagedJson(value: unknown): string {
+  if (value === null || typeof value !== "object") return JSON.stringify(value) ?? "null";
+  if (Array.isArray(value)) return `[${value.map(canonicalManagedJson).join(",")}]`;
+  return `{${Object.entries(value)
+    .filter(([, v]) => v !== undefined)
+    .sort(([a], [b]) => a.localeCompare(b, "en"))
+    .map(([k, v]) => `${JSON.stringify(k)}:${canonicalManagedJson(v)}`)
+    .join(",")}}`;
+}
+
+export function publicCloneUrl(value: string): string {
+  const invalid = () => new ManagedProjectError({ reason: "invalid-source" });
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    throw invalid();
+  }
+  if (
+    url.protocol !== "https:" ||
+    !["github.com", "gitlab.com", "bitbucket.org"].includes(url.hostname) ||
+    url.username ||
+    url.password ||
+    url.port ||
+    url.search ||
+    url.hash ||
+    !/^https:\/\/[^/]+\/[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(value) ||
+    !/^\/[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(url.pathname) ||
+    url.pathname.includes("..") ||
+    url.pathname.split("/").some((part) => part === "." || part === "..")
+  )
+    throw invalid();
+  // URL normalizes explicit default ports; reject them in the original authority too.
+  if (value.slice(8).split("/")[0]?.includes(":")) throw invalid();
+  return `https://${url.hostname}${url.pathname}`;
+}
+
+export function managedSourceDigest(source: Omit<ManagedProjectSource, "sourceDigest">): string {
+  return sha256Hex(canonicalManagedJson(source));
+}
+export function validateManagedSource(source: ManagedProjectSource): ManagedProjectSource {
+  Schema.decodeSync(ManagedProjectSource, { onExcessProperty: "error" })(source);
+  if (
+    source.logicalRoot !== `/projects/${source.sourceId}` ||
+    publicCloneUrl(source.clone.remoteUrl) !== source.clone.remoteUrl
+  )
+    throw new ManagedProjectError({ reason: "invalid-source" });
+  const { sourceDigest, ...identity } = source;
+  if (managedSourceDigest(identity) !== sourceDigest)
+    throw new ManagedProjectError({ reason: "identity" });
+  return source;
+}
+export function assertSourceAllocation(
+  source: ManagedProjectSource,
+  allocation: ManagedSourceAllocation,
+) {
+  validateManagedSource(source);
+  if (
+    allocation.purpose !== "project-source" ||
+    allocation.sourceId !== source.sourceId ||
+    allocation.sourceDigest !== source.sourceDigest ||
+    !allocation.allocationId ||
+    !allocation.environmentId ||
+    !allocation.projectId ||
+    allocation.workspaceRoot !== `/work/projects/${source.sourceId}`
+  )
+    throw new ManagedProjectError({ reason: "identity" });
+}
+
+export type ManagedSourceReadMethod =
+  | "vcs.listRefs"
+  | "vcs.refreshStatus"
+  | "filesystem.browse"
+  | "filesystem.getMetadata";
+export interface ManagedSourceReadClient {
+  readonly request: (
+    method: ManagedSourceReadMethod,
+    input: unknown,
+  ) => Effect.Effect<unknown, ManagedProjectError>;
+}
+export interface ManagedSourceRemoteProject {
+  readonly projectId: ProjectId;
+  readonly workspaceRoot: string;
+  readonly rpc: ManagedSourceReadClient;
+}
+
+export class ManagedSourceTransport extends Context.Service<
+  ManagedSourceTransport,
+  {
+    readonly changes: Stream.Stream<void, ManagedProjectError>;
+    readonly allocate: (
+      source: ManagedProjectSource,
+    ) => Effect.Effect<ManagedSourceAllocation, ManagedProjectError>;
+    readonly prepare: (
+      source: ManagedProjectSource,
+      allocation: ManagedSourceAllocation,
+      metadata: {
+        readonly title: string;
+        readonly createdAt: string;
+        readonly cloneOperationId: string;
+      },
+    ) => Effect.Effect<void, ManagedProjectError>;
+    readonly readClone: (
+      source: ManagedProjectSource,
+      allocation: ManagedSourceAllocation,
+    ) => Effect.Effect<ProjectCloneSnapshot | null, ManagedProjectError>;
+    readonly cancel: (
+      source: ManagedProjectSource,
+      allocation: ManagedSourceAllocation,
+    ) => Effect.Effect<boolean, ManagedProjectError>;
+    readonly retry: (
+      source: ManagedProjectSource,
+      allocation: ManagedSourceAllocation,
+    ) => Effect.Effect<boolean, ManagedProjectError>;
+    readonly revokeSource: (
+      source: ManagedProjectSource,
+      allocation: ManagedSourceAllocation,
+    ) => Effect.Effect<void, ManagedProjectError>;
+    readonly withProject: <A>(
+      source: ManagedProjectSource,
+      allocation: ManagedSourceAllocation,
+      operation: (project: ManagedSourceRemoteProject) => Effect.Effect<A, ManagedProjectError>,
+    ) => Effect.Effect<A, ManagedProjectError>;
+  }
+>()("t3/sandbox/ManagedProjectSource/ManagedSourceTransport") {}
+
+const CatalogEntry = Schema.Struct({
+  source: ManagedProjectSource,
+  intent: Schema.Struct({
+    remoteUrl: Schema.String,
+    destinationPath: Schema.String,
+    createdAt: Schema.String,
+  }),
+  title: Schema.String,
+  allocation: Schema.NullOr(ManagedSourceAllocation),
+});
+type CatalogEntry = typeof CatalogEntry.Type;
+const codec = Schema.fromJsonString(CatalogEntry);
+export interface ManagedSourceProjectContext extends ManagedSourceRemoteProject {
+  readonly source: ManagedProjectSource;
+  readonly allocation: ManagedSourceAllocation;
+}
+export interface ManagedSourceCatalogEntry {
+  readonly source: ManagedProjectSource;
+  readonly title: string;
+  readonly createdAt: string;
+  readonly allocation: ManagedSourceAllocation | null;
+}
+
+export class ManagedProjectSourceService extends Context.Service<
+  ManagedProjectSourceService,
+  {
+    readonly list: Effect.Effect<ReadonlyArray<ManagedSourceCatalogEntry>, ManagedProjectError>;
+    readonly revokeSource: (
+      projectId: ProjectId,
+      commandId: CommandId,
+    ) => Effect.Effect<void, ManagedProjectError>;
+    readonly route: (
+      projectId: ProjectId,
+    ) => Effect.Effect<Omit<ManagedSourceProjectContext, "rpc">, ManagedProjectError>;
+    readonly registerClone: (
+      input: ProjectCloneStartInput,
+    ) => Effect.Effect<ManagedProjectSource, ManagedProjectError>;
+    readonly read: (
+      projectId: ProjectId,
+    ) => Effect.Effect<ManagedProjectSource, ManagedProjectError>;
+    readonly addExisting: (
+      projectId: ProjectId,
+      logicalRoot: string,
+    ) => Effect.Effect<ManagedProjectSource, ManagedProjectError>;
+    readonly subscribeClones: Stream.Stream<
+      ReadonlyArray<ProjectCloneSnapshot>,
+      ManagedProjectError
+    >;
+    readonly cancel: (projectId: ProjectId) => Effect.Effect<boolean, ManagedProjectError>;
+    readonly retry: (projectId: ProjectId) => Effect.Effect<boolean, ManagedProjectError>;
+    readonly withSourceProject: <A>(
+      projectId: ProjectId,
+      operation: (project: ManagedSourceProjectContext) => Effect.Effect<A, ManagedProjectError>,
+    ) => Effect.Effect<A, ManagedProjectError>;
+  }
+>()("t3/sandbox/ManagedProjectSource/ManagedProjectSourceService") {}
+
+export const make = Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+  const crypto = yield* Crypto.Crypto;
+  const transport = yield* ManagedSourceTransport;
+  const decode = Effect.fn("ManagedProjectSource.decode")(function* (json: string) {
+    const entry = yield* Schema.decodeEffect(codec)(json).pipe(
+      Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+    );
+    yield* Effect.try({
+      try: () => validateManagedSource(entry.source),
+      catch: () => new ManagedProjectError({ reason: "identity" }),
+    });
+    if (entry.allocation)
+      yield* Effect.try({
+        try: () => assertSourceAllocation(entry.source, entry.allocation!),
+        catch: () => new ManagedProjectError({ reason: "identity" }),
+      });
+    return entry;
+  });
+  const readEntry = Effect.fn("ManagedProjectSource.readEntry")(function* (projectId: ProjectId) {
+    const deleting = yield* sql<{
+      project_id: string;
+    }>`SELECT project_id FROM managed_project_source_deletions WHERE project_id = ${projectId}`.pipe(
+      Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+    );
+    if (deleting.length > 0) return yield* new ManagedProjectError({ reason: "conflict" });
+    const rows = yield* sql<{
+      entry_json: string;
+    }>`SELECT entry_json FROM managed_project_sources WHERE project_id = ${projectId}`.pipe(
+      Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+    );
+    if (!rows[0]) return yield* new ManagedProjectError({ reason: "not-found" });
+    const entry = yield* decode(rows[0].entry_json);
+    if (entry.source.hostProjectId !== projectId)
+      return yield* new ManagedProjectError({ reason: "identity" });
+    return entry;
+  });
+  const allocated = Effect.fn("ManagedProjectSource.allocated")(function* (projectId: ProjectId) {
+    const entry = yield* readEntry(projectId);
+    if (!entry.allocation) return yield* new ManagedProjectError({ reason: "reconciliation" });
+    return { ...entry, allocation: entry.allocation };
+  });
+  const cloneSnapshot = Effect.fn("ManagedProjectSource.cloneSnapshot")(function* (
+    entry: CatalogEntry,
+  ) {
+    if (!entry.allocation) return null;
+    const snapshot = yield* transport.readClone(entry.source, entry.allocation);
+    if (!snapshot) return null;
+    if (
+      snapshot.projectId !== entry.allocation.projectId ||
+      snapshot.destinationPath !== entry.allocation.workspaceRoot ||
+      snapshot.remoteUrl !== entry.source.clone.remoteUrl
+    )
+      return yield* new ManagedProjectError({ reason: "identity" });
+    return {
+      ...snapshot,
+      projectId: entry.source.hostProjectId,
+      destinationPath: entry.source.logicalRoot,
+    };
+  });
+  const withSourceProject = Effect.fn("ManagedProjectSource.withSourceProject")(function* <A>(
+    projectId: ProjectId,
+    operation: (project: ManagedSourceProjectContext) => Effect.Effect<A, ManagedProjectError>,
+  ) {
+    const entry = yield* allocated(projectId);
+    const snapshot = yield* cloneSnapshot(entry);
+    if (snapshot?.phase !== "done") return yield* new ManagedProjectError({ reason: "not-ready" });
+    return yield* transport.withProject(entry.source, entry.allocation, (project) =>
+      operation({ ...project, source: entry.source, allocation: entry.allocation }),
+    );
+  });
+  const list = Effect.gen(function* () {
+    const rows = yield* sql<{
+      entry_json: string;
+    }>`SELECT entry_json FROM managed_project_sources WHERE project_id NOT IN (SELECT project_id FROM managed_project_source_deletions)`.pipe(
+      Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+    );
+    return yield* Effect.forEach(rows, (row) =>
+      decode(row.entry_json).pipe(
+        Effect.map((entry) => ({
+          source: entry.source,
+          title: entry.title,
+          createdAt: entry.intent.createdAt,
+          allocation: entry.allocation,
+        })),
+      ),
+    );
+  });
+  return ManagedProjectSourceService.of({
+    list,
+    revokeSource: Effect.fn("ManagedProjectSource.revokeSource")(function* (projectId, commandId) {
+      const rows = yield* sql<{
+        entry_json: string;
+      }>`SELECT entry_json FROM managed_project_sources WHERE project_id = ${projectId}`.pipe(
+        Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+      );
+      // The built-in scratch project has no source allocation to revoke.
+      if (!rows[0]) return;
+      const entry = yield* decode(rows[0].entry_json);
+      if (entry.source.hostProjectId !== projectId || !entry.allocation)
+        return yield* new ManagedProjectError({ reason: "reconciliation" });
+      const allocation = entry.allocation;
+      yield* Effect.uninterruptibleMask((restore) =>
+        Effect.gen(function* () {
+          // Commit cloud ownership before issuing a destructive request. Existing intent is never replay permission.
+          const inserted = yield* sql<{
+            project_id: string;
+          }>`INSERT INTO managed_project_source_deletions (project_id, command_id, source_id, source_digest, allocation_id, state)
+          VALUES (${projectId}, ${commandId}, ${entry.source.sourceId}, ${entry.source.sourceDigest}, ${allocation.allocationId}, 'revoking')
+          ON CONFLICT(project_id) DO NOTHING RETURNING project_id`.pipe(
+            Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+          );
+          const deletions = yield* sql<{
+            command_id: string;
+            source_id: string;
+            source_digest: string;
+            allocation_id: string;
+            state: string;
+          }>`SELECT command_id, source_id, source_digest, allocation_id, state FROM managed_project_source_deletions WHERE project_id = ${projectId}`.pipe(
+            Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+          );
+          const deletion = deletions[0];
+          if (
+            !deletion ||
+            deletion.command_id !== commandId ||
+            deletion.source_id !== entry.source.sourceId ||
+            deletion.source_digest !== entry.source.sourceDigest ||
+            deletion.allocation_id !== allocation.allocationId
+          )
+            return yield* new ManagedProjectError({ reason: "identity" });
+          if (deletion.state === "revoked") return;
+          if (inserted.length === 0)
+            return yield* new ManagedProjectError({ reason: "reconciliation" });
+          yield* restore(transport.revokeSource(entry.source, allocation)).pipe(
+            Effect.catchCause((cause) =>
+              sql`UPDATE managed_project_source_deletions SET state = 'unknown' WHERE project_id = ${projectId} AND state = 'revoking'`.pipe(
+                Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+                Effect.andThen(Effect.failCause(cause)),
+              ),
+            ),
+          );
+          yield* sql`UPDATE managed_project_source_deletions SET state = 'revoked' WHERE project_id = ${projectId} AND state = 'revoking'`.pipe(
+            Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+          );
+        }),
+      );
+    }),
+    route: Effect.fn("ManagedProjectSourceService.route")((projectId) =>
+      withSourceProject(projectId, (project) =>
+        Effect.succeed({
+          projectId: project.projectId,
+          workspaceRoot: project.workspaceRoot,
+          source: project.source,
+          allocation: project.allocation,
+        }),
+      ),
+    ),
+    read: Effect.fn("ManagedProjectSourceService.read")((projectId) =>
+      readEntry(projectId).pipe(Effect.map((entry) => entry.source)),
+    ),
+    registerClone: Effect.fn("ManagedProjectSource.registerClone")(function* (input) {
+      if (
+        input.provider !== undefined ||
+        input.repository !== undefined ||
+        (input.protocol !== undefined && input.protocol !== "https") ||
+        !input.remoteUrl
+      )
+        return yield* new ManagedProjectError({ reason: "invalid-source" });
+      if (!/^\/projects\/[A-Za-z0-9_-]+$/.test(input.destinationPath))
+        return yield* new ManagedProjectError({ reason: "invalid-root" });
+      const remoteUrl = yield* Effect.try({
+        try: () => publicCloneUrl(input.remoteUrl!),
+        catch: () => new ManagedProjectError({ reason: "invalid-source" }),
+      });
+      const sourceId = (yield* crypto
+        .randomUUIDv4()
+        .pipe(
+          Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+        )).replaceAll("-", "");
+      const identity = {
+        version: 1 as const,
+        sourceId,
+        hostProjectId: input.projectId,
+        logicalRoot: `/projects/${sourceId}`,
+        clone: { remoteUrl, protocol: "https" as const },
+      };
+      const source = { ...identity, sourceDigest: managedSourceDigest(identity) };
+      const intent = {
+        remoteUrl,
+        destinationPath: input.destinationPath,
+        createdAt: input.createdAt,
+      };
+      const candidate: CatalogEntry = { source, intent, title: input.title, allocation: null };
+      const json = yield* Schema.encodeEffect(codec)(candidate).pipe(
+        Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+      );
+      // This immutable intent commits before the first remote allocation attempt.
+      yield* sql`INSERT INTO managed_project_sources (project_id, source_id, logical_root, entry_json) VALUES (${input.projectId}, ${sourceId}, ${source.logicalRoot}, ${json}) ON CONFLICT(project_id) DO NOTHING`.pipe(
+        Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+      );
+      const entry = yield* readEntry(input.projectId);
+      if (canonicalManagedJson(entry.intent) !== canonicalManagedJson(intent))
+        return yield* new ManagedProjectError({ reason: "conflict" });
+      if (entry.allocation) {
+        yield* transport.prepare(entry.source, entry.allocation, {
+          title: entry.title,
+          createdAt: entry.intent.createdAt,
+          cloneOperationId: entry.source.sourceId,
+        });
+        return entry.source;
+      }
+      const allocation = yield* transport.allocate(entry.source);
+      yield* Effect.try({
+        try: () => assertSourceAllocation(entry.source, allocation),
+        catch: () => new ManagedProjectError({ reason: "identity" }),
+      });
+      const updated = yield* Schema.encodeEffect(codec)({ ...entry, allocation }).pipe(
+        Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+      );
+      yield* sql`UPDATE managed_project_sources SET entry_json = ${updated} WHERE project_id = ${input.projectId} AND entry_json = ${yield* Schema.encodeEffect(codec)(entry).pipe(Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })))}`.pipe(
+        Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+      );
+      const persisted = yield* allocated(input.projectId);
+      if (canonicalManagedJson(persisted.allocation) !== canonicalManagedJson(allocation))
+        return yield* new ManagedProjectError({ reason: "identity" });
+      yield* transport.prepare(persisted.source, persisted.allocation, {
+        title: entry.title,
+        createdAt: entry.intent.createdAt,
+        cloneOperationId: entry.source.sourceId,
+      });
+      return persisted.source;
+    }),
+    addExisting: Effect.fn("ManagedProjectSource.addExisting")(function* (projectId, logicalRoot) {
+      const existing = (yield* list).find((entry) => entry.source.logicalRoot === logicalRoot);
+      if (existing && existing.source.hostProjectId !== projectId)
+        return yield* new ManagedProjectError({ reason: "unsupported-import" });
+      const source = yield* readEntry(projectId);
+      if (source.source.logicalRoot !== logicalRoot)
+        return yield* new ManagedProjectError({ reason: "invalid-root" });
+      return yield* withSourceProject(projectId, () => Effect.succeed(source.source));
+    }),
+    subscribeClones: Stream.concat(Stream.succeed(undefined), transport.changes).pipe(
+      Stream.mapEffect(() =>
+        Effect.gen(function* () {
+          const rows = yield* sql<{
+            entry_json: string;
+          }>`SELECT entry_json FROM managed_project_sources WHERE project_id NOT IN (SELECT project_id FROM managed_project_source_deletions)`.pipe(
+            Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+          );
+          const snapshots = yield* Effect.forEach(rows, (row) =>
+            decode(row.entry_json).pipe(Effect.flatMap(cloneSnapshot)),
+          );
+          return snapshots.filter((snapshot) => snapshot !== null);
+        }),
+      ),
+    ),
+    cancel: Effect.fn("ManagedProjectSource.cancel")(function* (projectId) {
+      const entry = yield* allocated(projectId);
+      return yield* transport.cancel(entry.source, entry.allocation);
+    }),
+    retry: Effect.fn("ManagedProjectSource.retry")(function* (projectId) {
+      const entry = yield* allocated(projectId);
+      return yield* transport.retry(entry.source, entry.allocation);
+    }),
+    withSourceProject,
+  });
+});
+export const layer = Layer.effect(ManagedProjectSourceService, make);
diff --git a/apps/server/src/sandbox/ManagedSourceTransportLive.ts b/apps/server/src/sandbox/ManagedSourceTransportLive.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1e29aef9deff86dec41b009f9871969b83ad6fe6
--- /dev/null
+++ b/apps/server/src/sandbox/ManagedSourceTransportLive.ts
@@ -0,0 +1,280 @@
+import {
+  WS_METHODS,
+  VcsListRefsInput,
+  VcsStatusInput,
+  FilesystemBrowseInput,
+  FilesystemGetMetadataInput,
+  type ProjectCloneSnapshot,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import type * as Scope from "effect/Scope";
+import * as Schema from "effect/Schema";
+import { HttpClient } from "effect/http";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as PubSub from "effect/PubSub";
+import * as Stream from "effect/Stream";
+import {
+  ManagedSourceTransport,
+  ManagedProjectError,
+  type ManagedSourceAllocation,
+  type ManagedProjectSource,
+  type ManagedSourceRemoteProject,
+} from "./ManagedProjectSource.ts";
+import { makeManagedBridgeManager } from "./managedBridgeManager.ts";
+import { connectManagedPreparation } from "./managedBridgeClient.ts";
+
+const failure = () => new ManagedProjectError({ reason: "reconciliation" });
+const binding = (source: ManagedProjectSource, allocation: ManagedSourceAllocation) => ({
+  sourceId: source.sourceId,
+  sourceDigest: source.sourceDigest,
+  allocationId: allocation.allocationId,
+  projectId: allocation.projectId,
+  workspaceRoot: allocation.workspaceRoot,
+  cloneOperationId: source.sourceId,
+});
+
+export const layer = Layer.effect(
+  ManagedSourceTransport,
+  Effect.gen(function* () {
+    const http = yield* HttpClient.HttpClient;
+    const manager = yield* makeManagedBridgeManager({
+      role: process.env.T3_CLOUD_ROLE,
+      allocatorUrl: process.env.T3_CLOUD_ALLOCATOR_URL,
+      allocatorToken: process.env.T3_CLOUD_ALLOCATOR_TOKEN,
+    });
+    const scope = yield* Effect.scope;
+    const events = yield* PubSub.unbounded<void>();
+    const snapshots = new Map<string, ProjectCloneSnapshot>();
+    const active = new Map<
+      string,
+      Effect.Success<ReturnType<typeof connectManagedPreparation>>["client"]
+    >();
+    const running = new Set<string>();
+    const use = Effect.fn("ManagedSourceTransport.use")(function* <A, E>(
+      source: ManagedProjectSource,
+      allocation: ManagedSourceAllocation,
+      operation: (
+        connection: Effect.Success<ReturnType<typeof connectManagedPreparation>>,
+      ) => Effect.Effect<A, E, Scope.Scope>,
+    ): Effect.fn.Return<A, ManagedProjectError> {
+      return yield* manager
+        .withPreparation(allocation, source, (link) =>
+          Effect.gen(function* () {
+            const connection = yield* connectManagedPreparation(link).pipe(
+              Effect.provideService(HttpClient.HttpClient, http),
+            );
+            return yield* operation(connection);
+          }),
+        )
+        .pipe(Effect.mapError(failure));
+    });
+    const update = Effect.fn("ManagedSourceTransport.update")((snapshot: ProjectCloneSnapshot) =>
+      Effect.sync(() => snapshots.set(snapshot.projectId, snapshot)).pipe(
+        Effect.andThen(PubSub.publish(events, undefined)),
+        Effect.asVoid,
+      ),
+    );
+    return ManagedSourceTransport.of({
+      changes: Stream.fromPubSub(events),
+      allocate: Effect.fn("ManagedSourceTransport.allocate")((source: ManagedProjectSource) =>
+        manager.allocateSource(source).pipe(Effect.mapError(failure)),
+      ),
+      prepare: Effect.fn("ManagedSourceTransport.prepare")(function* (
+        source: ManagedProjectSource,
+        allocation: ManagedSourceAllocation,
+        metadata: Parameters<ManagedSourceTransport["Service"]["prepare"]>[2],
+      ) {
+        if (running.has(allocation.allocationId)) return;
+        running.add(allocation.allocationId);
+        yield* update({
+          projectId: allocation.projectId,
+          remoteUrl: source.clone.remoteUrl,
+          destinationPath: allocation.workspaceRoot,
+          repository: null,
+          phase: "running",
+          stage: "connecting",
+          percent: null,
+          detail: null,
+          error: null,
+          startedAt: metadata.createdAt,
+          endedAt: null,
+          sequence: 0,
+        });
+        // The scoped native connection and manager lease stay alive for the entire real clone.
+        yield* use(source, allocation, ({ client }) =>
+          Effect.gen(function* () {
+            active.set(allocation.allocationId, client);
+            const pull = yield* client[WS_METHODS.subscribeProjectClones]({}).pipe(Stream.toPull);
+            yield* pull;
+            let receipt = yield* client["managedProject.prepare"]({
+              ...binding(source, allocation),
+              ...metadata,
+              projectSource: source,
+            });
+            while (true) {
+              if (receipt.phase !== "started") break;
+              const values = yield* pull;
+              for (const list of values)
+                for (const snapshot of list) {
+                  if (snapshot.projectId === allocation.projectId) yield* update(snapshot);
+                }
+              receipt = yield* client["managedProject.read"](binding(source, allocation));
+            }
+            // Only the durable exact operation receipt can turn a native snapshot into done.
+            if (
+              receipt.allocationId !== allocation.allocationId ||
+              receipt.sourceDigest !== source.sourceDigest ||
+              receipt.sourceId !== source.sourceId ||
+              receipt.cloneOperationId !== source.sourceId ||
+              receipt.projectId !== allocation.projectId ||
+              receipt.workspaceRoot !== allocation.workspaceRoot ||
+              receipt.remoteUrl !== source.clone.remoteUrl
+            )
+              return yield* failure();
+            const previous = snapshots.get(allocation.projectId);
+            if (previous)
+              yield* update({
+                ...previous,
+                phase:
+                  receipt.phase === "done" && receipt.headCommit
+                    ? "done"
+                    : receipt.phase === "cancelled"
+                      ? "cancelled"
+                      : "failed",
+              });
+          }),
+        ).pipe(
+          Effect.ensuring(
+            Effect.sync(() => {
+              active.delete(allocation.allocationId);
+              running.delete(allocation.allocationId);
+            }).pipe(Effect.andThen(PubSub.publish(events, undefined)), Effect.asVoid),
+          ),
+          Effect.catchCause(() => PubSub.publish(events, undefined).pipe(Effect.asVoid)),
+          Effect.forkIn(scope),
+        );
+      }),
+      readClone: Effect.fn("ManagedSourceTransport.readClone")(
+        (
+          source: ManagedProjectSource,
+          allocation: ManagedSourceAllocation,
+        ): Effect.Effect<ProjectCloneSnapshot | null, ManagedProjectError> => {
+          const previous = snapshots.get(allocation.projectId);
+          if (previous && running.has(allocation.allocationId))
+            return Effect.succeed(
+              previous.phase === "done" ? { ...previous, phase: "running" as const } : previous,
+            );
+          return use(source, allocation, ({ client }) =>
+            Effect.gen(function* () {
+              const receipt = yield* client["managedProject.read"](binding(source, allocation));
+              if (
+                receipt.sourceId !== source.sourceId ||
+                receipt.sourceDigest !== source.sourceDigest ||
+                receipt.cloneOperationId !== source.sourceId ||
+                receipt.projectId !== allocation.projectId ||
+                receipt.workspaceRoot !== allocation.workspaceRoot ||
+                receipt.allocationId !== allocation.allocationId ||
+                receipt.remoteUrl !== source.clone.remoteUrl
+              )
+                return yield* failure();
+              return {
+                projectId: allocation.projectId,
+                remoteUrl: receipt.remoteUrl,
+                destinationPath: allocation.workspaceRoot,
+                repository: null,
+                phase:
+                  receipt.phase === "done" && receipt.headCommit
+                    ? ("done" as const)
+                    : receipt.phase === "failed"
+                      ? ("failed" as const)
+                      : receipt.phase === "cancelled"
+                        ? ("cancelled" as const)
+                        : ("running" as const),
+                stage: "connecting" as const,
+                percent: null,
+                detail:
+                  receipt.phase === "unknown" ? "Clone outcome requires reconciliation." : null,
+                error: null,
+                startedAt: previous?.startedAt ?? DateTime.formatIso(yield* DateTime.now),
+                endedAt: null,
+                sequence: previous?.sequence ?? 0,
+              };
+            }),
+          );
+        },
+      ),
+      cancel: Effect.fn("ManagedSourceTransport.cancel")(
+        (source: ManagedProjectSource, allocation: ManagedSourceAllocation) => {
+          const client = active.get(allocation.allocationId);
+          return client
+            ? client["managedProject.cancel"](binding(source, allocation)).pipe(
+                Effect.mapError(failure),
+              )
+            : use(source, allocation, ({ client }) =>
+                client["managedProject.cancel"](binding(source, allocation)),
+              );
+        },
+      ),
+      retry: Effect.fn("ManagedSourceTransport.retry")(() =>
+        Effect.fail(new ManagedProjectError({ reason: "reconciliation" })),
+      ),
+      revokeSource: Effect.fn("ManagedSourceTransport.revokeSource")(
+        (source: ManagedProjectSource, allocation: ManagedSourceAllocation) =>
+          manager.revokeSource(source, allocation).pipe(
+            Effect.mapError(failure),
+            Effect.asVoid,
+            Effect.tap(() =>
+              Effect.sync(() => {
+                snapshots.delete(allocation.projectId);
+              }).pipe(Effect.andThen(PubSub.publish(events, undefined))),
+            ),
+          ),
+      ),
+      withProject: Effect.fn("ManagedSourceTransport.withProject")(function* <A>(
+        source: ManagedProjectSource,
+        allocation: ManagedSourceAllocation,
+        operation: (project: ManagedSourceRemoteProject) => Effect.Effect<A, ManagedProjectError>,
+      ): Effect.fn.Return<A, ManagedProjectError> {
+        return yield* use(source, allocation, ({ client }) =>
+          operation({
+            projectId: allocation.projectId,
+            workspaceRoot: allocation.workspaceRoot,
+            rpc: {
+              request: (method, input) => {
+                // Methods are selected only by the catalog adapter, never from an RPC payload.
+                switch (method) {
+                  case "vcs.listRefs":
+                    return Schema.decodeUnknownEffect(VcsListRefsInput)(input).pipe(
+                      Effect.flatMap((input) => client[WS_METHODS.vcsListRefs](input)),
+                      Effect.mapError(failure),
+                    );
+                  case "vcs.refreshStatus":
+                    return Schema.decodeUnknownEffect(
+                      Schema.Struct({
+                        ...VcsStatusInput.fields,
+                        localOnly: Schema.optional(Schema.Boolean),
+                      }),
+                    )(input).pipe(
+                      Effect.flatMap((input) => client[WS_METHODS.vcsRefreshStatus](input)),
+                      Effect.mapError(failure),
+                    );
+                  case "filesystem.browse":
+                    return Schema.decodeUnknownEffect(FilesystemBrowseInput)(input).pipe(
+                      Effect.flatMap((input) => client[WS_METHODS.filesystemBrowse](input)),
+                      Effect.mapError(failure),
+                    );
+                  case "filesystem.getMetadata":
+                    return Schema.decodeUnknownEffect(FilesystemGetMetadataInput)(input).pipe(
+                      Effect.flatMap((input) => client[WS_METHODS.filesystemGetMetadata](input)),
+                      Effect.mapError(failure),
+                    );
+                }
+              },
+            },
+          }),
+        );
+      }),
+    });
+  }),
+);
diff --git a/apps/server/src/sandbox/ManagedThreadBinding.test.ts b/apps/server/src/sandbox/ManagedThreadBinding.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..01a1027b5a6333f19c71f68157223cc3a3109e17
--- /dev/null
+++ b/apps/server/src/sandbox/ManagedThreadBinding.test.ts
@@ -0,0 +1,114 @@
+import { it, assert } from "@effect/vitest";
+import { EnvironmentId, ProjectId, ProviderInstanceId, ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as SqlClient from "effect/sql/SqlClient";
+import * as Sqlite from "../persistence/Sqlite.ts";
+import { ManagedBridgeError } from "./managedBridgeLink.ts";
+import { managedSourceDigest } from "./ManagedProjectSource.ts";
+import { make } from "./ManagedThreadBinding.ts";
+
+it.effect(
+  "native binding reconstruction reuses the immutable allocation without another manager mutation",
+  () =>
+    Effect.gen(function* () {
+      let allocations = 0;
+      const threadId = ThreadId.make("native/thread%literal");
+      const host = {
+        threadId,
+        modelSelection: { instanceId: ProviderInstanceId.make("codex"), model: "model-a" },
+        runtimeMode: "full-access" as const,
+        interactionMode: "default" as const,
+      };
+      const allocation = {
+        threadId,
+        allocationId: "allocation-one",
+        environmentId: EnvironmentId.make("child-environment"),
+        providerInstanceId: "codex" as const,
+        project: { id: ProjectId.make("child-project"), title: "Child", workspaceRoot: "/work" },
+      };
+      const manager = {
+        allocate: () =>
+          Effect.sync(() => {
+            allocations++;
+            return allocation;
+          }),
+        providerStatus: () => Effect.die("No provider status in binding test"),
+        revokeSource: () => Effect.die("No source revocation in binding test"),
+        allocateSource: () => Effect.die("No source allocation in binding test"),
+        withPreparation: () => Effect.die("No preparation in scratch test"),
+        withLink: () => Effect.die("Binding cache must never issue child credentials"),
+      };
+      const first = yield* make(manager);
+      const bound = yield* first.allocate(host);
+      const reconstructed = yield* make(manager);
+      assert.deepEqual(yield* reconstructed.read(threadId), bound);
+      assert.deepEqual(yield* reconstructed.allocate(host), bound);
+      assert.equal(allocations, 1);
+      const changed = yield* reconstructed
+        .allocate({ ...host, modelSelection: { ...host.modelSelection, model: "model-b" } })
+        .pipe(Effect.exit);
+      assert.isTrue(Exit.isFailure(changed));
+      assert.equal(allocations, 1);
+      const sql = yield* SqlClient.SqlClient;
+      yield* sql`UPDATE managed_thread_bindings SET binding_json = ${'{"host":{}}'} WHERE thread_id = ${threadId}`;
+      assert.isTrue(Exit.isFailure(yield* reconstructed.read(threadId).pipe(Effect.exit)));
+      assert.equal(allocations, 1);
+    }).pipe(Effect.provide(Sqlite.layerMemory)),
+);
+
+it.effect("an uncertain allocation cannot rewrite the durable source or workspace intent", () =>
+  Effect.gen(function* () {
+    const threadId = ThreadId.make("intent-thread");
+    const identity = {
