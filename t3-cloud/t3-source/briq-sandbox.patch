diff --git a/apps/web/src/hooks/openBriqSandboxThread.ts b/apps/web/src/hooks/openBriqSandboxThread.ts
new file mode 100644
index 00000000..c1f68711
--- /dev/null
+++ b/apps/web/src/hooks/openBriqSandboxThread.ts
@@ -0,0 +1,142 @@
+import type { AnyRouter } from "@tanstack/react-router";
+import { ProviderInstanceId, type EnvironmentId, type ThreadId } from "@t3tools/contracts";
+import { runAtomCommand } from "@t3tools/client-runtime/state/runtime";
+import { allocateSandboxThread } from "../state/briqSandbox";
+import { appAtomRegistry } from "../rpc/atomRegistry";
+import { connectPairing, waitForSandboxConnection } from "../connection/onboarding";
+import { projectEnvironment } from "../state/projects";
+import { threadEnvironment } from "../state/threads";
+import { environmentServerConfigsAtom } from "../state/server";
+import { readLocalApi } from "../localApi";
+
+export async function openBriqSandboxThread(
+  router: AnyRouter,
+  environmentId: EnvironmentId,
+  threadId: ThreadId,
+  requestedProvider?: "codex" | "claudeAgent",
+) {
+  const options = { reportFailure: false, reportDefect: false };
+  const home = appAtomRegistry.get(environmentServerConfigsAtom).get(environmentId);
+  if (home?.briqSandboxRole !== "central")
+    throw new Error("Connect the cloud home before allocating a sandbox.");
+  const admitted = home.briqSandboxProviders ?? ["codex"];
+  let providerInstanceId = requestedProvider;
+  if (providerInstanceId === undefined && admitted.length > 1) {
+    const api = readLocalApi();
+    if (!api) throw new Error("Cloud provider selection is unavailable.");
+    const selected = await api.contextMenu.show(
+      admitted.map((id) => ({
+        id,
+        label: id === "codex" ? "Codex" : "Claude",
+      })),
+      { x: window.innerWidth / 2, y: window.innerHeight / 2 },
+    );
+    if (selected === null) return;
+    if (selected !== "codex" && selected !== "claudeAgent")
+      throw new Error("Invalid cloud provider selection.");
+    providerInstanceId = selected;
+  }
+  providerInstanceId ??= admitted.length === 1 ? admitted[0] : "codex";
+  if (!providerInstanceId) throw new Error("No cloud provider is admitted.");
+  if (!admitted.includes(providerInstanceId))
+    throw new Error("This provider is not admitted by the cloud home.");
+  const result = await runAtomCommand(
+    appAtomRegistry,
+    allocateSandboxThread,
+    {
+      environmentId,
+      input: { threadId, providerInstanceId },
+    },
+    options,
+  );
+  if (result._tag === "Failure")
+    throw new Error(
+      "Sandbox allocation failed. Check cloud connections before retrying; no local thread was created.",
+    );
+  const allocation = result.value;
+  const destination = new URL(allocation.connection.url);
+  if (
+    allocation.providerInstanceId !== providerInstanceId ||
+    allocation.threadId !== threadId ||
+    destination.protocol !== "https:" ||
+    destination.username ||
+    destination.password ||
+    destination.search ||
+    destination.hash ||
+    destination.pathname !== "/"
+  )
+    throw new Error("Invalid sandbox allocation destination.");
+  const connected = await runAtomCommand(
+    appAtomRegistry,
+    connectPairing,
+    {
+      host: destination.origin,
+      pairingCode: allocation.connection.credential,
+      expectedEnvironmentId: allocation.environmentId,
+    },
+    options,
+  );
+  if (connected._tag === "Failure") throw new Error("Could not pair the allocated sandbox.");
+  const ready = await runAtomCommand(
+    appAtomRegistry,
+    waitForSandboxConnection,
+    allocation.environmentId,
+    options,
+  );
+  if (
+    ready._tag === "Failure" ||
+    ready.value.briqSandboxRole !== "child" ||
+    ready.value.briqSandboxProviderInstanceId !== allocation.providerInstanceId
+  )
+    throw new Error("The allocated sandbox did not establish its native connection.");
+  const provider = ready.value.providers.find(
+    (item) =>
+      item.instanceId === allocation.providerInstanceId &&
+      item.driver === allocation.providerInstanceId &&
+      item.enabled &&
+      item.status === "ready" &&
+      (allocation.providerInstanceId !== "claudeAgent" || item.auth.status === "authenticated"),
+  );
+  const model = provider?.models[0]?.slug;
+  if (!model) throw new Error("The assigned sandbox bridge has no authenticated model catalog.");
+  const project = await runAtomCommand(
+    appAtomRegistry,
+    projectEnvironment.create,
+    {
+      environmentId: allocation.environmentId,
+      input: {
+        projectId: allocation.project.id,
+        title: allocation.project.title,
+        workspaceRoot: allocation.project.workspaceRoot,
+      },
+    },
+    options,
+  );
+  if (project._tag === "Failure") throw new Error("Could not create the sandbox project.");
+  const thread = await runAtomCommand(
+    appAtomRegistry,
+    threadEnvironment.create,
+    {
+      environmentId: allocation.environmentId,
+      input: {
+        threadId,
+        projectId: allocation.project.id,
+        title: "New thread",
+        modelSelection: {
+          instanceId: ProviderInstanceId.make(allocation.providerInstanceId),
+          model,
+        },
+        runtimeMode: "approval-required",
+        interactionMode: "default",
+        branch: null,
+        worktreePath: null,
+      },
+    },
+    options,
+  );
+  if (thread._tag === "Failure") throw new Error("Could not create the allocated sandbox thread.");
+  await router.navigate({
+    to: "/$environmentId/$threadId",
+    params: { environmentId: allocation.environmentId, threadId },
+  });
+}
