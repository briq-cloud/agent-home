index 0000000000000000000000000000000000000000..9adf12e05f8c9a84862340c9d7c45726ed24b415
--- /dev/null
+++ b/apps/server/src/sandbox/ManagedProjectPreparation.test.ts
@@ -0,0 +1,165 @@
+import { assert, it } from "@effect/vitest";
+import {
+  OrchestrationDispatchCommandError,
+  ProjectId,
+  type ProjectCloneSnapshot,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Stream from "effect/Stream";
+import * as SqlClient from "effect/sql/SqlClient";
+import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
+import migration from "../persistence/Migrations/078_ManagedProjectSources.ts";
+import * as ProjectCloneTracker from "../project/ProjectCloneTracker.ts";
+import { managedSourceDigest } from "./ManagedProjectSource.ts";
+import {
+  make,
+  ManagedPreparationNative,
+  type ManagedNativeCloneHooks,
+  validateWorkspaceResolution,
+} from "./ManagedProjectPreparation.ts";
+
+const identity = {
+  version: 1 as const,
+  sourceId: "source01234567890",
+  hostProjectId: ProjectId.make("host-project"),
+  logicalRoot: "/projects/source01234567890",
+  clone: { remoteUrl: "https://github.com/owner/repo", protocol: "https" as const },
+};
+const source = { ...identity, sourceDigest: managedSourceDigest(identity) };
+const binding = {
+  sourceId: source.sourceId,
+  sourceDigest: source.sourceDigest,
+  allocationId: "allocation",
+  projectId: ProjectId.make("child-project"),
+  workspaceRoot: `/work/projects/${source.sourceId}`,
+  cloneOperationId: "operation0123456789",
+};
+const config = {
+  ...binding,
+  environmentId: "child-environment",
+  ownerGeneration: "owner-generation",
+  purpose: "thread" as const,
+};
+const input = {
+  ...binding,
+  projectSource: source,
+  title: "Repo",
+  createdAt: "2026-11-06T00:00:00.000Z",
+};
+
+it.effect(
+  "durable native completion survives retention and restart; uncertain admission never replays",
+  () =>
+    Effect.gen(function* () {
+      yield* migration;
+      const sql = yield* SqlClient.SqlClient;
+      let starts = 0;
+      let hooks: ManagedNativeCloneHooks | undefined;
+      let snapshot: ProjectCloneSnapshot | null = null;
+      const tracker = ProjectCloneTracker.ProjectCloneTracker.of({
+        start: () => Effect.die("native adapter owns start"),
+        cancel: () => Effect.succeed(false),
+        retry: () => Effect.succeed(false),
+        discard: () => Effect.void,
+        get: () => Effect.sync(() => snapshot),
+        stream: Stream.succeed([]),
+      });
+      const native = ManagedPreparationNative.of({
+        createProject: () => Effect.void,
+        onCloned: () => Effect.void,
+        start: (clone, callbacks) =>
+          Effect.gen(function* () {
+            const rows = yield* sql<{
+              preparation_json: string;
+            }>`SELECT preparation_json FROM managed_project_preparations`.pipe(
+              Effect.mapError(
+                (cause) =>
+                  new OrchestrationDispatchCommandError({
+                    message: "Preparation receipt test read failed.",
+                    cause,
+                  }),
+              ),
+            );
+            assert.equal(JSON.parse(rows[0]!.preparation_json).receipt.phase, "started");
+            starts++;
+            hooks = callbacks;
+            return {
+              projectId: clone.projectId,
+              cwd: clone.destinationPath,
+              remoteUrl: clone.remoteUrl!,
+              repository: null,
+            };
+          }),
+        inspect: () =>
+          Effect.succeed({
+            projectId: binding.projectId,
+            workspaceRoot: binding.workspaceRoot,
+            repositoryRoot: binding.workspaceRoot,
+            remoteUrl: source.clone.remoteUrl,
+            headCommit: "a".repeat(40),
+          }),
+      });
+      const build = make(config).pipe(
+        Effect.provideService(ProjectCloneTracker.ProjectCloneTracker, tracker),
+        Effect.provideService(ManagedPreparationNative, native),
+      );
+      const service = yield* build;
+      assert.equal((yield* service.prepare(input)).phase, "unknown");
+      const restarted = yield* build;
+      assert.equal((yield* restarted.prepare(input)).phase, "unknown");
+      assert.equal(starts, 1);
+      assert.isTrue(Exit.isFailure(yield* restarted.cancel(binding).pipe(Effect.exit)));
+      assert.isTrue(
+        Exit.isFailure(
+          yield* service
+            .read({ ...binding, cloneOperationId: "foreign01234567890" })
+            .pipe(Effect.exit),
+        ),
+      );
+      yield* hooks!.beforeDone();
+      snapshot = null;
+      assert.equal((yield* restarted.read(binding)).phase, "done");
+      assert.equal((yield* restarted.snapshot(binding)).phase, "done");
+      assert.isTrue(
+        Exit.isFailure(
+          yield* restarted.prepare({ ...input, title: "Changed intent" }).pipe(Effect.exit),
+        ),
+      );
+      assert.equal(starts, 1);
+    }).pipe(Effect.provide(NodeSqliteClient.layer({ filename: ":memory:" }))),
+);
+
+it.effect(
+  "workspace mapping preserves optional values and never falls back from existing worktree",
+  () =>
+    Effect.sync(() => {
+      const original = {
+        type: "worktree" as const,
+        baseRef: "origin/main",
+        startFromOrigin: false,
+      };
+      const resolution = {
+        original,
+        resolved: original,
+        sourceId: source.sourceId,
+        sourceDigest: source.sourceDigest,
+        childProjectId: binding.projectId,
+        childRoot: binding.workspaceRoot,
+      };
+      assert.deepEqual(validateWorkspaceResolution(source, binding, resolution).original, original);
+      assert.throws(() =>
+        validateWorkspaceResolution(source, binding, {
+          ...resolution,
+          resolved: { type: "worktree", baseRef: "origin/main" },
+        }),
+      );
+      assert.throws(() =>
+        validateWorkspaceResolution(source, binding, {
+          ...resolution,
+          original: { type: "existing_worktree", worktreePath: "/projects/foreign" },
+          resolved: { type: "root" },
+        }),
+      );
+    }),
+);
