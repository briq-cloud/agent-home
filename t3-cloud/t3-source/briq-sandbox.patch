+        [ORCHESTRATION_V2_WS_METHODS.launchThread]: (input) =>
+          Effect.sync(() => {
+            launches.push(input);
+            return { threadId, projection, resumed: false };
+          }),
+        [ORCHESTRATION_V2_WS_METHODS.subscribeThread]: () =>
+          Stream.succeed({
+            kind: "snapshot" as const,
+            snapshotSequence: 1,
+            projection: terminalProjection,
+          }),
+      });
+      const routes = Layer.effectDiscard(
+        Effect.gen(function* () {
+          const router = yield* HttpRouter.HttpRouter;
+          const websocket = yield* RpcServer.toHttpEffectWebsocket(group);
+          yield* router.add(
+            "GET",
+            "/.well-known/t3/environment",
+            Effect.sync(() => {
+              calls.push("descriptor");
+              return HttpServerResponse.jsonUnsafe({ environmentId: bootstrap.link.environmentId });
+            }),
+          );
+          yield* router.add(
+            "POST",
+            "/api/auth/websocket-ticket/rpc",
+            Effect.sync(() => {
+              calls.push("ticket");
+              return HttpServerResponse.jsonUnsafe({
+                ticket: "fixture-ws-ticket",
+                expiresAt: "2126-01-01T00:00:00Z",
+              });
+            }),
+          );
+          yield* router.add("GET", "/ws", websocket);
+        }),
+      ).pipe(
+        Layer.provide(handlers),
+        Layer.provide(RpcSerialization.layerJson),
+        Layer.provide(Layer.succeed(RpcScopeAuthorization)((effect) => effect)),
+      );
+      const services = yield* Layer.build(
+        HttpRouter.serve(routes, { disableListenLog: true, disableLogger: true }).pipe(
+          Layer.provideMerge(
+            NodeHttpServer.layer(() => NodeHttps.createServer({ key: TEST_KEY, cert: TEST_CERT }), {
+              port: 0,
+              host: "127.0.0.1",
+            }),
+          ),
+        ),
+      );
+      const address = Context.get(services, HttpServer.HttpServer).address;
+      if (address._tag !== "InetAddressV4" && address._tag !== "InetAddressV6")
+        return yield* Effect.die("Expected loopback TCP fixture");
+      const runtime = yield* AcpSessionRuntime.make({
+        spawn: {
+          command: process.execPath,
+          args: [new URL("../bin.ts", import.meta.url).pathname, MANAGED_BRIDGE_COMMAND],
+          cwd: "/",
+          shell: false,
+          extendEnv: false,
+          env: {
+            PATH: "/usr/bin:/bin",
+            LANG: "C.UTF-8",
+            NODE_EXTRA_CA_CERTS: caPath,
+            [MANAGED_BRIDGE_BOOTSTRAP]: yield* Schema.encodeEffect(ManagedBridgeBootstrapJson)({
+              ...bootstrap,
+              link: { ...bootstrap.link, httpBaseUrl: `https://127.0.0.1:${address.port}` },
+            }),
+          },
+        },
+        cwd: "/",
+        clientInfo: { name: "managed-cli-fixture", version: "1" },
+      });
+      yield* runtime.start();
+      expect(
+        yield* runtime.prompt({
+          prompt: [{ type: "text", text: "Native child launch" }],
+          _meta: { [MANAGED_BRIDGE_MESSAGE_META]: { messageId, commandId, runId } },
+        }),
+      ).toMatchObject({ stopReason: "end_turn" });
+      expect(calls).toEqual(["descriptor", "ticket"]);
+      expect(launches).toHaveLength(1);
+      expect(launches[0]).toMatchObject({
+        commandId,
+        threadId,
+        initialMessage: { messageId, text: "Native child launch" },
+      });
+    }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
