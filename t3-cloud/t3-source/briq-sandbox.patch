+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import { assert, it } from "@effect/vitest";
+import { CommandId, EnvironmentId, ProjectId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Layer from "effect/Layer";
+import * as Stream from "effect/Stream";
+import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
+import migration from "../persistence/Migrations/078_ManagedProjectSources.ts";
+import {
+  make,
+  ManagedProjectError,
+  ManagedSourceTransport,
+  canonicalManagedJson,
+  managedSourceDigest,
+  publicCloneUrl,
+  validateManagedSource,
+} from "./ManagedProjectSource.ts";
+
+it.effect("rejects Git transport and URL authority escape before allocation", () =>
+  Effect.sync(() => {
+    for (const url of [
+      "https://u:p@github.com/a/b",
+      "https://github.com:443/a/b",
+      "https://github.com/a/b?token=x",
+      "https://github.com/a/b#",
+      "https://github.com/a/%62",
+      "https://github.com/a/../b",
+      "https://github.com/a/b/",
+      "https://evil.test/a/b",
+      "http://github.com/a/b",
+      "git@github.com:a/b",
+      "https://github.com/a/b/extra",
+    ])
+      assert.throws(() => publicCloneUrl(url));
+    assert.equal(publicCloneUrl("https://GitHub.com/a/b.git"), "https://github.com/a/b.git");
+  }),
+);
+
+it.effect("source digest excludes its own field and canonicalizes immutable key order", () =>
+  Effect.sync(() => {
+    const identity = {
+      version: 1 as const,
+      sourceId: "source01234567890",
+      hostProjectId: ProjectId.make("project-one"),
+      logicalRoot: "/projects/source01234567890",
+      clone: { protocol: "https" as const, remoteUrl: "https://github.com/a/b" },
+    };
+    const digest = managedSourceDigest(identity);
+    assert.equal(digest, "252b63e5b93f0448d97e308cb36b37e526234a546ef7a8163e42072db0e6bb5b");
+    assert.equal(
+      managedSourceDigest({
+        clone: identity.clone,
+        logicalRoot: identity.logicalRoot,
+        hostProjectId: identity.hostProjectId,
+        sourceId: identity.sourceId,
+        version: 1,
+      }),
+      digest,
+    );
+    assert.equal(
+      canonicalManagedJson({ b: false, a: { z: 1, a: 2 } }),
+      '{"a":{"a":2,"z":1},"b":false}',
+    );
+    assert.equal(validateManagedSource({ ...identity, sourceDigest: digest }).sourceDigest, digest);
+    assert.throws(() => validateManagedSource({ ...identity, sourceDigest: "0".repeat(64) }));
+  }),
+);
+
+it.effect("durable central source intent reconciles one allocation and rejects changed input", () =>
+  Effect.gen(function* () {
+    yield* migration;
+    let allocations = 0;
+    let prepared = 0;
+    const transport = ManagedSourceTransport.of({
+      changes: Stream.empty,
+      allocate: (source) =>
+        Effect.sync(() => {
+          allocations++;
+          return {
+            purpose: "project-source" as const,
+            sourceId: source.sourceId,
+            sourceDigest: source.sourceDigest,
+            allocationId: "allocation",
+            environmentId: EnvironmentId.make("child"),
+            projectId: ProjectId.make("child-project"),
+            workspaceRoot: `/work/projects/${source.sourceId}`,
+          };
+        }),
+      prepare: () =>
+        Effect.sync(() => {
+          prepared++;
+        }),
+      readClone: () => Effect.succeed(null),
+      cancel: () => Effect.succeed(false),
+      retry: () => Effect.succeed(false),
+      revokeSource: () => Effect.void,
+      withProject: (_source, allocation, operation) =>
+        operation({
+          projectId: allocation.projectId,
+          workspaceRoot: allocation.workspaceRoot,
+          rpc: { request: () => Effect.die("No ready source in this test") },
+        }),
+    });
+    const service = yield* make.pipe(Effect.provideService(ManagedSourceTransport, transport));
+    const input = {
+      projectId: ProjectId.make("phone-project"),
+      title: "Repo",
+      createdAt: "2026-11-06T00:00:00.000Z",
+      remoteUrl: "https://github.com/owner/repo",
+      destinationPath: "/projects/repo",
+    };
+    const source = yield* service.registerClone(input);
+    const reconstructed = yield* make.pipe(
+      Effect.provideService(ManagedSourceTransport, transport),
+    );
+    assert.deepEqual(yield* reconstructed.registerClone(input), source);
+    assert.equal(allocations, 1);
+    assert.equal(prepared, 2);
+    assert.isTrue(
+      Exit.isFailure(
+        yield* reconstructed
+          .registerClone({ ...input, remoteUrl: "https://github.com/owner/other" })
+          .pipe(Effect.exit),
+      ),
+    );
+    assert.isTrue(
+      Exit.isFailure(
+        yield* reconstructed.addExisting(input.projectId, source.logicalRoot).pipe(Effect.exit),
+      ),
+    );
+    assert.equal(allocations, 1);
+  }).pipe(
+    Effect.provide(
+      Layer.mergeAll(NodeSqliteClient.layer({ filename: ":memory:" }), NodeCrypto.layer),
+    ),
+  ),
+);
+
+const deletionScenario = (uncertain: boolean) =>
+  Effect.gen(function* () {
+    yield* migration;
+    let revocations = 0;
+    const transport = ManagedSourceTransport.of({
+      changes: Stream.empty,
+      allocate: (source) =>
+        Effect.succeed({
+          purpose: "project-source",
+          sourceId: source.sourceId,
+          sourceDigest: source.sourceDigest,
+          allocationId: "exact-source-allocation",
+          environmentId: EnvironmentId.make("source-environment"),
+          projectId: ProjectId.make("native-source-project"),
+          workspaceRoot: `/work/projects/${source.sourceId}`,
+        }),
+      prepare: () => Effect.void,
+      readClone: () => Effect.succeed(null),
+      cancel: () => Effect.succeed(false),
+      retry: () => Effect.succeed(false),
+      revokeSource: (source, allocation) =>
+        Effect.gen(function* () {
+          revocations++;
+          assert.equal(allocation.allocationId, "exact-source-allocation");
+          assert.equal(allocation.purpose, "project-source");
+          assert.equal(allocation.sourceId, source.sourceId);
+          if (uncertain) return yield* new ManagedProjectError({ reason: "reconciliation" });
+        }),
+      withProject: () => Effect.die("Deleted source must not become ready"),
+    });
+    const service = yield* make.pipe(Effect.provideService(ManagedSourceTransport, transport));
+    const projectId = ProjectId.make("deletion-project");
+    const commandId = CommandId.make("accepted-native-delete");
+    yield* service.registerClone({
+      projectId,
+      title: "Repo",
+      createdAt: "2026-11-06T00:00:00.000Z",
+      remoteUrl: "https://github.com/owner/repo",
+      destinationPath: "/projects/repo",
+    });
+    const first = yield* service.revokeSource(projectId, commandId).pipe(Effect.exit);
+    assert.equal(Exit.isFailure(first), uncertain);
+    const reconstructed = yield* make.pipe(
+      Effect.provideService(ManagedSourceTransport, transport),
+    );
+    const second = yield* reconstructed.revokeSource(projectId, commandId).pipe(Effect.exit);
+    assert.equal(Exit.isFailure(second), uncertain);
+    assert.equal(revocations, 1);
+    assert.deepEqual(yield* reconstructed.list, []);
+    assert.isTrue(Exit.isFailure(yield* reconstructed.read(projectId).pipe(Effect.exit)));
+    assert.isTrue(
+      Exit.isFailure(
+        yield* reconstructed
+          .revokeSource(projectId, CommandId.make("foreign-delete-command"))
+          .pipe(Effect.exit),
+      ),
+    );
+    assert.equal(revocations, 1);
+  }).pipe(
+    Effect.provide(
+      Layer.mergeAll(NodeSqliteClient.layer({ filename: ":memory:" }), NodeCrypto.layer),
+    ),
+  );
+
+it.effect("durably revokes only the exact source allocation once after native deletion", () =>
+  deletionScenario(false),
+);
+it.effect("does not replay an uncertain source revoke across service reconstruction", () =>
+  deletionScenario(true),
+);
