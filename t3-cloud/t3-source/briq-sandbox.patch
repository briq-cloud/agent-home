@@ -0,0 +1,203 @@
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as ChildProcessSpawner from "effect/process/ChildProcessSpawner";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import {
+  managedResponseReceipts,
+  extractManagedElicitationForm,
+} from "../sandbox/managedBridgeProtocol.ts";
+import {
+  ProviderDriverKind,
+  TextGenerationError,
+  type ProviderInstanceId,
+  type ServerProvider,
+} from "@t3tools/contracts";
+import { resolveSelfInvocation } from "@t3tools/shared/nodeRuntime";
+import { makeAcpAdapterV2, AcpProviderCapabilitiesV2 } from "@t3tools/provider-acp/server/adapter";
+import { ProviderDriverError } from "@t3tools/provider-core/server/errors";
+import {
+  defaultProviderContinuationIdentity,
+  type ProviderInstance,
+} from "@t3tools/provider-core/server/driver";
+import * as ModelCatalog from "@t3tools/provider-core/server/ModelCatalog";
+import { buildServerProvider } from "@t3tools/provider-core/server/snapshotProbe";
+import { makeManualOnlyProviderMaintenanceCapabilities } from "@t3tools/provider-core/server/maintenanceResolver";
+import * as Context from "effect/Context";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Scope from "effect/Scope";
+import * as Stream from "effect/Stream";
+import { ManagedThreadBinding } from "../sandbox/ManagedThreadBinding.ts";
+import {
+  makeManagedRuntimeFactory,
+  withoutManagedHostMcp,
+} from "../sandbox/managedBridgeRuntime.ts";
+import {
+  MANAGED_BRIDGE_MESSAGE_META,
+  MANAGED_BRIDGE_MODEL,
+} from "../sandbox/managedBridgeBootstrap.ts";
+
+// The generic central spawner stays denied. Only this fixed runtime receives
+// the native process facility; no caller command or provider config reaches it.
+class ManagedBridgeProcessSpawner extends Context.Service<
+  ManagedBridgeProcessSpawner,
+  ChildProcessSpawner.ChildProcessSpawner["Service"]
+>()("t3/provider/managedBridgeProvider/ManagedBridgeProcessSpawner") {}
+const layerManagedSpawner = Layer.effect(
+  ManagedBridgeProcessSpawner,
+  ChildProcessSpawner.ChildProcessSpawner,
+).pipe(Layer.provide(NodeServices.layer));
+
+const construct = Effect.fn("ManagedBridgeProvider.construct")(function* (
+  instanceId: ProviderInstanceId,
+) {
+  const bindingService = yield* Effect.serviceOption(ManagedThreadBinding);
+  if (Option.isNone(bindingService))
+    return yield* new ProviderDriverError({
+      driver: ProviderDriverKind.make(instanceId),
+      instanceId,
+      detail: "Managed thread binding unavailable.",
+    });
+  const bindings = bindingService.value;
+  const path = yield* Path.Path;
+  const managedSpawner = yield* ManagedBridgeProcessSpawner;
+  const catalog = yield* ModelCatalog.ModelCatalog;
+  const driver = ProviderDriverKind.make(instanceId);
+  const selfInvocation = yield* resolveSelfInvocation();
+  const orchestrationAdapter = yield* withoutManagedHostMcp(
+    makeAcpAdapterV2({
+      instanceId,
+      selfInvocation,
+      flavor: {
+        driver,
+        capabilities: {
+          ...AcpProviderCapabilitiesV2,
+          threads: { ...AcpProviderCapabilitiesV2.threads, canRollbackThread: false },
+          turns: { ...AcpProviderCapabilitiesV2.turns, supportsSteeringByInterruptRestart: false },
+          sessions: {
+            ...AcpProviderCapabilitiesV2.sessions,
+            supportsProviderSwitchingViaHandoff: false,
+          },
+        },
+        makeRuntime: (input) =>
+          makeManagedRuntimeFactory({ manager: bindings.manager, readBinding: bindings.read })(
+            input,
+          ).pipe(
+            Effect.provideService(Path.Path, path),
+            Effect.provideService(ChildProcessSpawner.ChildProcessSpawner, managedSpawner),
+          ),
+        permissionDisposition: () => "ask",
+        responseReceipts: managedResponseReceipts,
+        extractElicitationForm: extractManagedElicitationForm,
+        resolveModelId: () => MANAGED_BRIDGE_MODEL,
+        promptMeta: (input) => ({
+          [MANAGED_BRIDGE_MESSAGE_META]: {
+            commandId: `managed:${input.runId}:${input.message.messageId}`,
+            messageId: input.message.messageId,
+            runId: input.runId,
+            createdBy: input.message.createdBy,
+            creationSource: input.message.creationSource,
+            continuation: input.restartContinuationOfRunId !== undefined,
+          },
+        }),
+      },
+    }),
+  );
+  const models = catalog.bundled(driver);
+  const readSnapshot = Effect.fn("ManagedBridgeProvider.readSnapshot")(function* () {
+    const metadata = yield* bindings.manager.providerStatus(instanceId).pipe(
+      Effect.orElseSucceed(() => ({
+        available: false,
+        ready: false,
+        authStatus: "unknown" as const,
+        version: null,
+      })),
+    );
+    return {
+      ...buildServerProvider({
+        presentation: {
+          displayName: instanceId === "codex" ? "Codex" : "Claude",
+          supportsConversationRollback: false,
+        },
+        enabled: true,
+        checkedAt: DateTime.formatIso(yield* DateTime.now),
+        models: models?.models.map((entry) => ModelCatalog.catalogServerModel(models, entry)) ?? [],
+        skills: [],
+        probe: {
+          installed: metadata.available,
+          version: metadata.version,
+          status: metadata.ready ? "ready" : "warning",
+          auth: { status: metadata.authStatus },
+        },
+      }),
+      instanceId,
+      driver,
+    } satisfies ServerProvider;
+  });
+  const unsupported = (operation: string) =>
+    Effect.fail(
+      new TextGenerationError({
