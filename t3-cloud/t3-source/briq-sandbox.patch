new file mode 100644
index 00000000..410ac502
--- /dev/null
+++ b/apps/server/src/briqSandboxAllocator.ts
@@ -0,0 +1,72 @@
+import {
+  BriqSandboxAllocation,
+  BriqSandboxAllocationError,
+  type BriqSandboxAllocationInput,
+} from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import { sandboxRole } from "./briqSandbox.ts";
+
+export class BriqSandboxAllocator extends Context.Service<BriqSandboxAllocator, {
+  readonly allocate: (input: typeof BriqSandboxAllocationInput.Type) => Effect.Effect<
+    typeof BriqSandboxAllocation.Type, BriqSandboxAllocationError
+  >;
+}>()("t3/briqSandboxAllocator") {}
+
+const unavailable = () => new BriqSandboxAllocationError({
+  message: "Sandbox allocation is unavailable. Check the cloud home before retrying; no local thread was created.",
+});
+
+export const layer = Layer.sync(BriqSandboxAllocator, () => {
+  // Only the supervised home receives this allocation-only capability. Never use
+  // the manager owner key or a request's headers as the allocator identity.
+  const role = sandboxRole();
+  const endpoint = process.env.T3_CLOUD_ALLOCATOR_URL;
+  const token = process.env.T3_CLOUD_ALLOCATOR_TOKEN;
+  let destination: URL | undefined;
+  try {
+    const url = new URL(endpoint ?? "");
+    if (url.protocol === "http:" && url.hostname === "127.0.0.1" && url.port &&
+        url.pathname === "/_cloud/threads" && !url.username && !url.password && !url.search && !url.hash)
+      destination = url;
+  } catch { /* Missing or invalid configuration fails closed at allocation. */ }
+  return {
+    allocate: Effect.fn("BriqSandboxAllocator.allocate")(function* (input) {
+      if (role !== "central" || !destination || !token) return yield* Effect.fail(unavailable());
+      const response = yield* Effect.tryPromise({
+        try: async () => {
+          const response = await fetch(destination, {
+            method: "POST", redirect: "error", signal: AbortSignal.timeout(60_000),
+            headers: { authorization: `Bearer ${token}`, "content-type": "application/json" },
+            body: JSON.stringify({ threadId: input.threadId }),
+          });
+          if (!response.ok || !response.body) throw unavailable();
+          const reader = response.body.getReader();
+          const chunks: Uint8Array[] = [];
+          let length = 0;
+          try {
+            for (;;) {
+              const part = await reader.read();
+              if (part.done) break;
+              length += part.value.length;
+              if (length > 65_536) throw unavailable();
+              chunks.push(part.value);
+            }
+          } finally { await reader.cancel(); }
+          const bytes = new Uint8Array(length);
+          let offset = 0;
+          for (const chunk of chunks) { bytes.set(chunk, offset); offset += chunk.length; }
+          return JSON.parse(new TextDecoder().decode(bytes));
+        },
+        catch: unavailable,
+      });
+      const allocation = yield* Schema.decodeUnknownEffect(BriqSandboxAllocation)(response).pipe(
+        Effect.mapError(unavailable),
+      );
+      if (allocation.threadId !== input.threadId) return yield* Effect.fail(unavailable());
+      return allocation;
+    }),
+  };
+});
