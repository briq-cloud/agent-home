@@ -0,0 +1,44 @@
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Layer from "effect/Layer";
+import * as Logger from "effect/Logger";
+import { FetchHttpClient } from "effect/http";
+import * as AcpAgent from "effect-acp/agent";
+import { runManagedBridge, type ManagedBridgePorts } from "./managedBridgeAgent.ts";
+import { takeManagedBootstrap } from "./managedBridgeBootstrap.ts";
+import { connectManagedSandbox } from "./managedBridgeClient.ts";
+import { ManagedBridgeError } from "./managedBridgeLink.ts";
+
+export async function runManagedBridgeCli(): Promise<void> {
+  try {
+    const bootstrap = takeManagedBootstrap();
+    const ports: ManagedBridgePorts = {
+      readHostThread: () => Effect.succeed(bootstrap.host),
+      findLink: (threadId) =>
+        threadId === bootstrap.host.threadId
+          ? Effect.succeedSome(bootstrap.link)
+          : Effect.fail(
+              new ManagedBridgeError({ message: "This bridge belongs to another thread." }),
+            ),
+      connect: (link) =>
+        link === bootstrap.link
+          ? connectManagedSandbox(link).pipe(Effect.provide(FetchHttpClient.layer))
+          : Effect.fail(new ManagedBridgeError({ message: "The managed child binding changed." })),
+    };
+    const services = AcpAgent.layerStdio().pipe(
+      Layer.provideMerge(Layer.mergeAll(NodeServices.layer, NodeCrypto.layer, Logger.layer([]))),
+    );
+    const exit = await Effect.runPromiseExit(
+      runManagedBridge(ports).pipe(Effect.provide(services), Effect.scoped),
+    );
+    if (Exit.isSuccess(exit)) return;
+  } catch {
+    /* The bootstrap and transport causes can contain private credentials. */
+  }
+  process.stderr.write(
+    "The managed bridge ended; reconcile the existing child thread before retrying.\n",
+  );
+  process.exitCode = 1;
+}
