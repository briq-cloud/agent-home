+++ b/apps/server/src/sandbox/managedBridgeAgent.test.ts
@@ -0,0 +1,547 @@
+import { createAttachmentId } from "../attachmentStore.ts";
+import { expect, it } from "@effect/vitest";
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import {
+  ChatAttachmentId,
+  CommandId,
+  EnvironmentId,
+  MessageId,
+  ProjectId,
+  ProviderInstanceId,
+  ThreadId,
+  type RuntimeMode,
+  type OrchestrationV2ThreadProjection,
+  type OrchestrationV2ThreadStreamItem,
+  type OrchestrationV2Command,
+  type OrchestrationV2ThreadLaunchInput,
+} from "@t3tools/contracts";
+import type * as Cause from "effect/Cause";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as Option from "effect/Option";
+import * as Queue from "effect/Queue";
+import * as Redacted from "effect/Redacted";
+import * as Schema from "effect/Schema";
+import * as Sink from "effect/Sink";
+import * as Stdio from "effect/Stdio";
+import * as Stream from "effect/Stream";
+import * as AcpAgent from "effect-acp/agent";
+import * as AcpClient from "effect-acp/client";
+import type * as AcpSchema from "effect-acp/compat";
+import { installManagedBridge, sessionIdFor, type SandboxSession } from "./managedBridgeAgent.ts";
+import {
+  MANAGED_BRIDGE_MESSAGE_META,
+  MANAGED_BRIDGE_REQUEST_META,
+  MANAGED_BRIDGE_ACCEPTED_METHOD,
+  MANAGED_BRIDGE_WITHDRAW_METHOD,
+} from "./managedBridgeBootstrap.ts";
+import { ManagedBridgeError, ManagedBridgeLink } from "./managedBridgeLink.ts";
+
+const threadId = ThreadId.make("thread:phone:one");
+const messageId = MessageId.make("native-message");
+const link: typeof ManagedBridgeLink.Type = {
+  threadId,
+  allocationId: "allocation",
+  environmentId: EnvironmentId.make("child"),
+  projectId: ProjectId.make("project"),
+  providerInstanceId: "codex",
+  httpBaseUrl: "https://child.example",
+  token: Redacted.make("private-child-sentinel"),
+  ownerGeneration: "generation",
+  sessionId: "child-session",
+};
+const meta = {
+  [MANAGED_BRIDGE_MESSAGE_META]: {
+    messageId,
+    commandId: CommandId.make("native-command"),
+    runId: "native-run",
+    createdBy: "user",
+    creationSource: "mobile",
+  },
+};
+const event = (type: string, payload: unknown) =>
+  ({ kind: "event", sequence: 1, event: { type, payload } }) as OrchestrationV2ThreadStreamItem;
+const run = (status: string) => ({ id: "child-run", threadId, userMessageId: messageId, status });
+const projection = {
+  thread: {
+    id: threadId,
+    modelSelection: { instanceId: ProviderInstanceId.make("codex"), model: "mock" },
+    runtimeMode: "approval-required",
+    interactionMode: "default",
+  },
+  turnItems: [{ id: "user", type: "user_message", messageId, ordinal: 1, runId: "child-run" }],
+  runs: [run("completed")],
+  runtimeRequests: [],
+} as unknown as OrchestrationV2ThreadProjection;
+
+const crossedStdio = Effect.gen(function* () {
+  const input = yield* Queue.unbounded<Uint8Array, Cause.Done<void>>();
+  const output = yield* Queue.unbounded<Uint8Array, Cause.Done<void>>();
+  const encoder = new TextEncoder();
+  const end = (read: typeof input, write: typeof output) =>
+    Stdio.make({
+      args: Effect.succeed([]),
+      stdin: Stream.fromQueue(read),
+      stdout: () =>
+        Sink.forEach((chunk: string | Uint8Array) =>
+          Queue.offer(write, typeof chunk === "string" ? encoder.encode(chunk) : chunk),
+        ),
+      stderr: () => Sink.drain,
+    });
+  return { agent: end(input, output), client: end(output, input) };
+});
+const setup = Effect.fn("ManagedBridgeTest.setup")(function* (
+  options: {
+    readonly existing?: OrchestrationV2ThreadProjection;
+    readonly runtimeMode?: RuntimeMode;
+    readonly launch?: SandboxSession["launch"];
+    readonly dispatch?: SandboxSession["dispatch"];
+    readonly persistAttachments?: SandboxSession["persistAttachments"];
+    readonly elicitation?: AcpSchema.CreateElicitationResponse;
+    readonly permission?: (
+      request: AcpSchema.RequestPermissionRequest,
+    ) => Effect.Effect<AcpSchema.RequestPermissionResponse>;
+  } = {},
+) {
+  const pipes = yield* crossedStdio;
+  const agent = yield* AcpAgent.make(pipes.agent);
+  const stream = yield* Queue.unbounded<OrchestrationV2ThreadStreamItem>();
+  const launches: OrchestrationV2ThreadLaunchInput[] = [],
+    commands: OrchestrationV2Command[] = [],
+    updates: AcpSchema.SessionNotification[] = [],
+    receipts: unknown[] = [];
+  const session: SandboxSession = {
+    threadStop: true,
+    defaultModelSelection: { instanceId: ProviderInstanceId.make("codex"), model: "mock" },
+    providers: [],
+    projection: () => Effect.succeed(Option.fromNullishOr(options.existing)),
+    launch: (input) =>
+      Effect.sync(() => launches.push(input)).pipe(
+        Effect.andThen(
+          options.launch?.(input) ??
+            Queue.offer(stream, event("run.updated", run("completed"))).pipe(Effect.asVoid),
+        ),
+      ),
+    dispatch: (command) =>
+      Effect.sync(() => commands.push(command)).pipe(
+        Effect.andThen(options.dispatch?.(command) ?? Effect.void),
+      ),
+    persistAttachments:
+      options.persistAttachments ??
+      (() => Effect.fail(new ManagedBridgeError({ message: "Unsupported attachments." }))),
+    subscribe: () => Stream.fromQueue(stream),
+  };
+  yield* installManagedBridge({
+    readHostThread: () =>
+      Effect.succeed({
+        threadId,
+        modelSelection: { instanceId: ProviderInstanceId.make("codex"), model: "mock" },
+        runtimeMode: options.runtimeMode ?? "approval-required",
+        interactionMode: "default",
+      }),
+    findLink: (id) =>
+      id === threadId
+        ? Effect.succeedSome(link)
+        : Effect.fail(new ManagedBridgeError({ message: "Foreign thread." })),
+    connect: () => Effect.succeed(session),
+  }).pipe(Effect.provideService(AcpAgent.AcpAgent, agent));
+  const client = yield* AcpClient.make(pipes.client);
+  yield* client.handleSessionUpdate((notification) =>
+    Effect.sync(() => {
+      updates.push(notification);
+    }),
+  );
+  yield* client.handleRequestPermission(
+    options.permission ??
+      (() => Effect.succeed({ outcome: { outcome: "selected", optionId: "accept" } })),
+  );
+  yield* client.handleElicitation(() =>
+    Effect.succeed(options.elicitation ?? { action: "cancel" }),
+  );
+  for (const method of [MANAGED_BRIDGE_ACCEPTED_METHOD, MANAGED_BRIDGE_WITHDRAW_METHOD])
+    yield* client.handleExtNotification(method, Schema.Unknown, (notice) =>
+      Effect.sync(() => {
+        receipts.push(notice);
+      }),
+    );
+  const initialized = yield* client.agent.initialize({
+    protocolVersion: 2,
+    clientInfo: { name: "native-test", version: "1" },
+    clientCapabilities: { elicitation: { form: {} } },
+  });
+  const opened = yield* client.agent.createSession({ cwd: "/untrusted", mcpServers: [] });
+  const prompt = (metadata: typeof meta | undefined = meta) =>
+    client.agent.prompt({
+      sessionId: opened.sessionId,
+      prompt: [{ type: "text", text: "hello" }],
+      ...(metadata === undefined ? {} : { _meta: metadata }),
+    });
+  return {
+    initialized,
+    client,
+    sessionId: opened.sessionId,
+    prompt,
+    launches,
+    commands,
+    updates,
+    receipts,
+    push: (item: OrchestrationV2ThreadStreamItem) => Queue.offer(stream, item).pipe(Effect.asVoid),
+  };
+});
+const provide = <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+  effect.pipe(Effect.scoped, Effect.provide(NodeCrypto.layer));
+
+it.effect.each(["approval-required", "full-access"] as const)(
+  "preserves %s while binding native new/load/resume sessions and requiring stable prompt identity before writes",
+  (runtimeMode) =>
+    provide(
+      Effect.gen(function* () {
+        const h = yield* setup({ runtimeMode });
+        expect(h.sessionId).toBe(sessionIdFor(threadId));
+        yield* h.client.agent.loadSession({
+          sessionId: h.sessionId,
+          cwd: "/ignored",
+          mcpServers: [],
+        });
+        const foreign = yield* h.client.agent
+          .resumeSession({
+            sessionId: sessionIdFor(ThreadId.make("foreign")),
+            cwd: "/ignored",
+            mcpServers: [],
+          })
+          .pipe(Effect.exit);
+        expect(Exit.isFailure(foreign)).toBe(true);
+        const missing = yield* h.client.agent
+          .prompt({ sessionId: h.sessionId, prompt: [{ type: "text", text: "hello" }] })
+          .pipe(Effect.exit);
+        expect(Exit.isFailure(missing)).toBe(true);
+        expect(h.launches).toHaveLength(0);
+        expect(h.commands).toHaveLength(0);
+        yield* h.prompt();
+        expect(h.launches[0]?.commandId).toBe(meta[MANAGED_BRIDGE_MESSAGE_META].commandId);
+        expect(h.launches[0]?.threadId).toBe(threadId);
+        expect(h.launches[0]?.runtimeMode).toBe(runtimeMode);
+      }),
+    ),
+);
+
+it.effect("lost launch acknowledgement fails once without dispatch fallback or success state", () =>
+  provide(
+    Effect.gen(function* () {
+      const h = yield* setup({
+        launch: () => Effect.fail(new ManagedBridgeError({ message: "Unknown launch outcome." })),
+      });
+      const result = yield* h.prompt().pipe(Effect.exit);
+      expect(Exit.isFailure(result)).toBe(true);
+      expect(h.launches).toHaveLength(1);
+      expect(h.commands).toHaveLength(0);
+      expect(h.updates.some((value) => value.update.sessionUpdate === "state_update")).toBe(false);
+    }),
+  ),
+);
+
+it.effect(
+  "reconnect attaches an accepted native message without launching or dispatching again",
+  () =>
+    provide(
+      Effect.gen(function* () {
+        const h = yield* setup({ existing: projection });
+        yield* h.client.agent.resumeSession({
+          sessionId: h.sessionId,
+          cwd: "/ignored",
+          mcpServers: [],
+        });
+        yield* h.prompt();
+        expect(h.launches).toHaveLength(0);
+        expect(h.commands).toHaveLength(0);
+      }),
+    ),
+);
+
+it.effect(
+  "full-access still asks natively and publishes a response receipt only after child acceptance",
+  () =>
+    provide(
+      Effect.gen(function* () {
+        const received = yield* Deferred.make<void>(),
+          accept = yield* Deferred.make<void>();
+        const h = yield* setup({
+          runtimeMode: "full-access",
+          launch: () => Effect.void,
+          dispatch: () =>
+            Deferred.succeed(received, undefined).pipe(Effect.andThen(Deferred.await(accept))),
+        });
+        const prompted = yield* h.prompt().pipe(Effect.forkScoped);
+        yield* h.push(event("run.created", run("running")));
+        yield* h.push(
+          event("turn-item.updated", {
+            id: "approval",
+            type: "approval_request",
+            requestId: "child-request",
+            requestKind: "command",
+            prompt: "build",
+            status: "waiting",
+            ordinal: 2,
+          }),
+        );
+        yield* Deferred.await(received);
+        expect(h.launches[0]?.runtimeMode).toBe("full-access");
+        expect(h.commands).toHaveLength(1);
+        expect(h.receipts).toHaveLength(0);
+        yield* Deferred.succeed(accept, undefined);
+        yield* h.push(event("run.updated", run("completed")));
+        yield* Fiber.join(prompted);
+        expect(h.receipts).toEqual([{ sessionId: h.sessionId, requestId: "child-request" }]);
+      }),
+    ),
+);
+
+it.effect("an uncertain stop remains a failed unresolved turn without reporting cancellation", () =>
+  provide(
+    Effect.gen(function* () {
+      const started = yield* Deferred.make<void>();
+      const h = yield* setup({
+        launch: () => Deferred.succeed(started, undefined).pipe(Effect.asVoid),
+        dispatch: () => Effect.fail(new ManagedBridgeError({ message: "Stop outcome unknown." })),
+      });
+      const prompted = yield* h.prompt().pipe(Effect.exit, Effect.forkScoped);
+      yield* Deferred.await(started);
+      yield* h.client.agent.cancel({ sessionId: h.sessionId });
+      expect(Exit.isFailure(yield* Fiber.join(prompted))).toBe(true);
+      expect(h.commands.map((command) => command.type)).toEqual(["thread.stop"]);
+      expect(h.updates.some((value) => value.update.sessionUpdate === "state_update")).toBe(false);
+    }),
+  ),
+);
+
+it.effect.each(["answer", "dismiss"] as const)(
+  "preserves native question answers and acknowledged dismissal: %s",
+  (action) =>
