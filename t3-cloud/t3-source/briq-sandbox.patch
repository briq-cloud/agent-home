+import { it, assert, vi } from "@effect/vitest";
+import { ProviderInstanceId, ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import { ManagedThreadBinding } from "./ManagedThreadBinding.ts";
+import { ManagedBridgeError } from "./managedBridgeLink.ts";
+import {
+  ManagedThreadCreation,
+  managedCommandRejection,
+  managedSessionRejection,
+} from "./managedThreadPolicy.ts";
+
+it.effect(
+  "central managed policy binds creation capability and later commands to the persisted provider and model",
+  () =>
+    Effect.gen(function* () {
+      vi.stubEnv("T3_CLOUD_ROLE", "central");
+      const threadId = ThreadId.make("native/literal%thread");
+      const selection = { instanceId: ProviderInstanceId.make("codex"), model: "model-a" };
+      const binding = {
+        allocation: { threadId, providerInstanceId: "codex" },
+        host: { threadId, modelSelection: selection },
+      } as never;
+      try {
+        const command = {
+          type: "thread.create",
+          threadId,
+          projectId: "metadata-project",
+          modelSelection: selection,
+        };
+        assert.isDefined(yield* managedCommandRejection(command));
+        assert.isUndefined(
+          yield* managedCommandRejection(command).pipe(
+            Effect.provideService(ManagedThreadCreation, {
+              threadId,
+              projectId: "metadata-project",
+              providerInstanceId: "codex",
+            }),
+          ),
+        );
+        assert.isDefined(
+          yield* managedCommandRejection({ ...command, threadId: "foreign" }).pipe(
+            Effect.provideService(ManagedThreadCreation, {
+              threadId,
+              projectId: "metadata-project",
+              providerInstanceId: "codex",
+            }),
+          ),
+        );
+        yield* Effect.gen(function* () {
+          assert.isUndefined(
+            yield* managedCommandRejection({
+              type: "message.dispatch",
+              threadId,
+              modelSelection: selection,
+            }),
+          );
+          assert.isDefined(
+            yield* managedCommandRejection({
+              type: "message.dispatch",
+              threadId,
+              modelSelection: { ...selection, model: "model-b" },
+            }),
+          );
+          assert.isDefined(
+            yield* managedCommandRejection({ type: "message.dispatch", threadId: "foreign" }),
+          );
+          const workspaceMutation = {
+            type: "thread.metadata.update",
+            threadId,
+            worktreePath: "/private/host",
+          };
+          assert.isDefined(yield* managedCommandRejection(workspaceMutation));
+          assert.isDefined(
+            yield* managedCommandRejection({ type: "checkpoint.rollback", threadId }),
+          );
+          assert.isDefined(yield* managedCommandRejection({ type: "thread.fork", threadId }));
+          assert.isUndefined(
+            yield* managedSessionRejection({
+              threadId,
+              instanceId: "codex",
+              persistedDriver: "codex",
+            }),
+          );
+          assert.isDefined(
+            yield* managedSessionRejection({
+              threadId,
+              instanceId: "codex",
+              persistedDriver: "acpRegistry",
+            }),
+          );
+        }).pipe(
+          Effect.provideService(ManagedThreadBinding, {
+            manager: {} as never,
+            allocate: () => Effect.die("Policy must not allocate"),
+            read: (id) =>
+              id === threadId
+                ? Effect.succeed(binding)
+                : Effect.fail(new ManagedBridgeError({ message: "Foreign thread." })),
+          }),
+        );
+      } finally {
+        vi.unstubAllEnvs();
+      }
+    }),
+);
