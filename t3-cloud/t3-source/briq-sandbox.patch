diff --git a/apps/server/src/sandbox/managedBridgeRuntime.ts b/apps/server/src/sandbox/managedBridgeRuntime.ts
new file mode 100644
index 0000000000000000000000000000000000000000..daf7d51f9320fddac10fe317dffe1a5dae845768
--- /dev/null
+++ b/apps/server/src/sandbox/managedBridgeRuntime.ts
@@ -0,0 +1,143 @@
+import * as NodePath from "@effect/platform-node/NodePath";
+import { ThreadId } from "@t3tools/contracts";
+import { AgentScopeThreadId } from "@t3tools/shared/AgentScope";
+import { resolveSelfInvocation, selfInvocationArgs } from "@t3tools/shared/nodeRuntime";
+import * as McpProviderSessions from "@t3tools/provider-core/server/McpProviderSessions";
+import * as AcpSessionRuntime from "@t3tools/provider-acp/server/AcpSessionRuntime";
+import type { AcpAdapterV2RuntimeInput } from "@t3tools/provider-acp/server/adapter";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+import * as AcpErrors from "effect-acp/errors";
+import {
+  ManagedBridgeBootstrapJson,
+  ManagedHostConfiguration,
+  MANAGED_BRIDGE_BOOTSTRAP,
+  MANAGED_BRIDGE_COMMAND,
+} from "./managedBridgeBootstrap.ts";
+import { ManagedAllocation, makeManagedBridgeManager } from "./managedBridgeManager.ts";
+import type { ManagedBridgeError } from "./managedBridgeLink.ts";
+
+const failure = () =>
+  new AcpErrors.AcpTransportError({
+    cause: undefined,
+    detail: "The managed bridge connection ended; the child turn requires reconciliation.",
+  });
+type Manager = Effect.Success<ReturnType<typeof makeManagedBridgeManager>>;
+export interface ManagedRuntimeBinding {
+  readonly allocation: typeof ManagedAllocation.Type;
+  readonly host: typeof ManagedHostConfiguration.Type;
+}
+
+// Apply only while constructing this adapter: makeAcpAdapterV2 captures this
+// session view before any runtime startup/refresh. Other adapters keep theirs.
+export const withoutManagedHostMcp = Effect.fn("withoutManagedHostMcp")(function* <A, E, R>(
+  effect: Effect.Effect<A, E, R>,
+) {
+  const sessions = yield* McpProviderSessions.McpProviderSessions;
+  return yield* effect.pipe(
+    Effect.provideService(McpProviderSessions.McpProviderSessions, {
+      ...sessions,
+      read: () => Effect.undefined,
+    }),
+  );
+});
+
+export function makeManagedRuntimeFactory(options: {
+  readonly manager: Manager;
+  // Reads an existing durable native launch binding. Never allocates here.
+  readonly readBinding: (
+    threadId: ThreadId,
+  ) => Effect.Effect<ManagedRuntimeBinding, ManagedBridgeError>;
+}) {
+  return Effect.fn("ManagedBridge.makeRuntime")(function* (input: AcpAdapterV2RuntimeInput) {
+    const nativeThreadId = yield* AgentScopeThreadId;
+    if (!nativeThreadId) return yield* failure();
+    const threadId = ThreadId.make(nativeThreadId);
+    const binding = yield* options.readBinding(threadId).pipe(Effect.mapError(failure));
+    if (
+      binding.host.threadId !== threadId ||
+      binding.allocation.threadId !== threadId ||
+      binding.host.modelSelection.instanceId !== binding.allocation.providerInstanceId
+    )
+      return yield* failure();
+    const self = yield* resolveSelfInvocation().pipe(
+      Effect.provide(NodePath.layer),
+      Effect.mapError(failure),
+    );
+    if (!self.command.startsWith("/")) return yield* failure();
+    const ready = yield* Deferred.make<
+      AcpSessionRuntime.AcpSessionRuntime["Service"],
+      AcpErrors.AcpError
+    >();
+    const closed = yield* Deferred.make<void>();
+    const terminated = yield* Deferred.make<void>();
+    const terminate = (error: AcpErrors.AcpError) =>
+      Deferred.succeed(terminated, undefined).pipe(
+        Effect.flatMap((first) => (first ? input.onTermination(error) : Effect.void)),
+      );
+    yield* Effect.addFinalizer(() => Deferred.succeed(closed, undefined));
+    yield* options.manager
+      .withLink(binding.allocation, (link) =>
+        Effect.gen(function* () {
+          const bootstrap = yield* Schema.encodeEffect(ManagedBridgeBootstrapJson)({
+            link,
+            host: binding.host,
+          }).pipe(Effect.mapError(failure));
+          const runtime = yield* AcpSessionRuntime.make({
+            spawn: {
+              command: self.command,
+              args: selfInvocationArgs(self, [MANAGED_BRIDGE_COMMAND]),
+              shell: false,
+              extendEnv: false,
+              env: {
+                PATH: "/usr/local/bin:/usr/bin:/bin",
+                LANG: "C.UTF-8",
+                ELECTRON_RUN_AS_NODE: "1",
+                [MANAGED_BRIDGE_BOOTSTRAP]: bootstrap,
+              },
+            },
+            cwd: "/",
+            ownDetachedProcessGroup: true,
+            ownDescendantProcessGroups: true,
+            cancelBehavior: "wait-for-prompt",
+            cancelTimeout: "15 seconds",
+            clientInfo: input.clientInfo,
+            clientCapabilities: {
+              fs: { readTextFile: false, writeTextFile: false },
+              terminal: false,
+              elicitation: { form: {} },
+            },
+            mcpServers: [],
+            acpMcpServers: [],
+            httpMcpServers: [],
+            ...(input.resumeSessionId === undefined
+              ? {}
+              : { resumeSessionId: input.resumeSessionId, resumeMethod: "resume" as const }),
+            onTermination: (error) =>
+              terminate(error).pipe(Effect.ensuring(Deferred.succeed(closed, undefined))),
+            ...(input.onOutgoingResponseFailure === undefined
+              ? {}
+              : { onOutgoingResponseFailure: input.onOutgoingResponseFailure }),
+            ...(input.onOutgoingResponse === undefined
+              ? {}
+              : { onOutgoingResponse: input.onOutgoingResponse }),
+          });
+          yield* Deferred.succeed(ready, runtime);
+          // Returning runtime here would release withLink's lease and child scope.
+          yield* Deferred.await(closed);
+        }),
+      )
+      .pipe(
+        Effect.catch(() =>
+          Effect.gen(function* () {
+            const error = failure();
+            yield* Deferred.fail(ready, error);
+            yield* terminate(error);
+          }),
+        ),
+        Effect.forkScoped,
+      );
+    return yield* Deferred.await(ready);
+  });
+}
