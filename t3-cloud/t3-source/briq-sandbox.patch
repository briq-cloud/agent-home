@@ -0,0 +1,73 @@
+import {
+  ModelSelection,
+  ProviderInteractionMode,
+  RuntimeMode,
+  ThreadId,
+  IsoDateTime,
+  OrchestrationV2ThreadLaunchWorkspaceStrategy,
+} from "@t3tools/contracts";
+import * as Schema from "effect/Schema";
+import { ManagedProjectSource, validateManagedSource } from "./ManagedProjectSource.ts";
+import { ManagedBridgeLink } from "./managedBridgeLink.ts";
+
+export const MANAGED_BRIDGE_BOOTSTRAP = "T3_MANAGED_BRIDGE_BOOTSTRAP";
+export const MANAGED_BRIDGE_COMMAND = "__managed-sandbox-bridge";
+export const MANAGED_BRIDGE_MESSAGE_META = "t3.managedBridge.message";
+export const MANAGED_BRIDGE_REQUEST_META = "t3.managedBridge.request";
+export const MANAGED_BRIDGE_ACCEPTED_METHOD = "_t3/managedBridgeAccepted";
+export const MANAGED_BRIDGE_WITHDRAW_METHOD = "_t3/managedBridgeWithdraw";
+export const MANAGED_BRIDGE_INSTANCE_ID = "managedSandbox";
+export const MANAGED_BRIDGE_MODEL = "managed-child";
+
+export const ManagedHostConfiguration = Schema.Struct({
+  threadId: ThreadId,
+  modelSelection: ModelSelection,
+  runtimeMode: RuntimeMode,
+  interactionMode: ProviderInteractionMode,
+  project: Schema.optional(
+    Schema.Struct({
+      projectSource: ManagedProjectSource,
+      workspaceStrategy: OrchestrationV2ThreadLaunchWorkspaceStrategy,
+      title: Schema.String,
+      createdAt: IsoDateTime,
+    }),
+  ),
+});
+export const ManagedBridgeBootstrap = Schema.Struct({
+  link: ManagedBridgeLink,
+  host: ManagedHostConfiguration,
+});
+export const ManagedBridgeBootstrapJson = Schema.fromJsonString(ManagedBridgeBootstrap);
+
+// The parser consumes the only private bootstrap before loading the ACP agent.
+// Rejections expose a fixed error; schema causes can contain a bearer.
+export function takeManagedBootstrap(
+  environment: NodeJS.ProcessEnv = process.env,
+): typeof ManagedBridgeBootstrap.Type {
+  const encoded = environment[MANAGED_BRIDGE_BOOTSTRAP];
+  delete environment[MANAGED_BRIDGE_BOOTSTRAP];
+  try {
+    if (!encoded || Buffer.byteLength(encoded) > 65_536) throw new Error();
+    const value = Schema.decodeSync(ManagedBridgeBootstrapJson)(encoded);
+    if (
+      value.host.threadId !== value.link.threadId ||
+      value.host.modelSelection.instanceId !== value.link.providerInstanceId
+    )
+      throw new Error();
+    if (value.host.project) {
+      validateManagedSource(value.host.project.projectSource);
+      if (value.host.project.workspaceStrategy.type === "existing_worktree") throw new Error();
+    }
+    const url = new URL(value.link.httpBaseUrl);
+    if (
+      url.protocol !== "https:" ||
+      url.origin !== value.link.httpBaseUrl ||
+      url.username ||
+      url.password
+    )
+      throw new Error();
+    return value;
+  } catch {
+    throw new Error("The managed bridge bootstrap is unavailable.");
+  }
+}
