+++ b/apps/server/src/briqSandbox.test.ts
@@ -0,0 +1,33 @@
+import { describe, expect, it } from "vite-plus/test";
+import { sandboxCommandRejection, sandboxCreationRejection, sandboxRole } from "./briqSandbox.ts";
+
+const child = { T3_CLOUD_ROLE: "child", T3_CLOUD_THREAD_ID: "allocated" };
+const created = { type: "thread.created", threadId: "allocated", payload: {
+  createdBy: "user", modelSelection: { instanceId: "codex" },
+} };
+
+describe("sandbox creation authority", () => {
+  it("denies every home creation source before event append", () => {
+    for (const createdBy of ["user", "agent", "automation", undefined])
+      expect(sandboxCreationRejection({ ...created, payload: { ...created.payload, createdBy } },
+        { T3_CLOUD_ROLE: "central" })).toBeDefined();
+    for (const type of ["thread.create", "thread.fork", "message.dispatch", "thread.created.record", "subagent.start"])
+      expect(sandboxCommandRejection({ type, threadId: "allocated" }, { T3_CLOUD_ROLE: "central" })).toBeDefined();
+  });
+  it("allows only the bound user thread and Codex provider", () => {
+    expect(sandboxCreationRejection(created, child)).toBeUndefined();
+    expect(sandboxCreationRejection({ ...created, threadId: "other" }, child)).toBeDefined();
+    expect(sandboxCreationRejection({ ...created, payload: { ...created.payload, createdBy: "agent" } }, child)).toBeDefined();
+    expect(sandboxCreationRejection({ ...created, payload: { ...created.payload,
+      modelSelection: { instanceId: "claude" } } }, child)).toBeDefined();
+    for (const type of ["thread.fork", "thread.created.record", "subagent.start", "automation.run", "multi-model.start"])
+      expect(sandboxCommandRejection({ type, threadId: "allocated" }, child)).toBeDefined();
+    expect(sandboxCommandRejection({ type: "message.dispatch", threadId: "allocated" }, child)).toBeUndefined();
+  });
+  it("fails closed on missing binding or invalid role, preserving standalone", () => {
+    expect(sandboxRole({ T3_CLOUD_ROLE: "typo" })).toBe("invalid");
+    expect(sandboxCreationRejection(created, { T3_CLOUD_ROLE: "typo" })).toBeDefined();
+    expect(sandboxCreationRejection(created, { T3_CLOUD_ROLE: "child" })).toBeDefined();
+    expect(sandboxCreationRejection(created, {})).toBeUndefined();
+  });
+});
diff --git a/apps/server/src/briqSandbox.ts b/apps/server/src/briqSandbox.ts
new file mode 100644
index 00000000..2b50805d
--- /dev/null
+++ b/apps/server/src/briqSandbox.ts
@@ -0,0 +1,34 @@
+type SandboxEnvironment = Readonly<Record<string, string | undefined>>;
+
+export function sandboxRole(env: SandboxEnvironment = process.env) {
+  const role = env.T3_CLOUD_ROLE;
+  if (role === undefined || role === "standalone") return "standalone";
+  return role === "central" || role === "child" ? role : "invalid";
+}
+
+export function sandboxCommandRejection(
+  command: { readonly type: string; readonly threadId?: string; readonly modelSelection?: { readonly instanceId: string } },
+  env: SandboxEnvironment = process.env,
+): string | undefined {
+  const role = sandboxRole(env);
+  if (role === "standalone") return;
+  if (role === "invalid") return "Invalid sandbox role.";
+  if (command.type.startsWith("project.")) return;
+  if (role === "central") return "Create a sandbox through the cloud allocator before running a thread.";
+  if (!env.T3_CLOUD_THREAD_ID || command.threadId !== env.T3_CLOUD_THREAD_ID)
+    return "This environment is bound to one allocated thread.";
+  if (command.modelSelection && command.modelSelection.instanceId !== "codex")
+    return "Only the central Codex bridge is supported in this sandbox.";
+  if (/fork|multi-model|automation|delegated|thread.created.record|subagent.start/.test(command.type))
+    return "This operation requires a broker allocation and is unavailable in this sandbox.";
+}
+
+export function sandboxCreationRejection(
+  event: { readonly type: string; readonly threadId: string; readonly payload?: { readonly modelSelection?: { readonly instanceId: string }; readonly createdBy?: string } },
+  env: SandboxEnvironment = process.env,
+): string | undefined {
+  if (event.type !== "thread.created" || sandboxRole(env) === "standalone") return;
+  return sandboxCommandRejection({ type: "thread.create", threadId: event.threadId,
+    ...(event.payload?.modelSelection ? { modelSelection: event.payload.modelSelection } : {}) }, env)
+    ?? (event.payload?.createdBy !== "user" ? "Only the allocated user thread can be created in this sandbox." : undefined);
+}
