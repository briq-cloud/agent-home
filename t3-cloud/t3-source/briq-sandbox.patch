+import { describe, expect, it } from "vite-plus/test";
+import {
+  sandboxCommandRejection,
+  sandboxCreationRejection,
+  sandboxRole,
+  sandboxSessionRejection,
+  sandboxAdmittedProviders,
+} from "./briqSandbox.ts";
+
+const child = { T3_CLOUD_ROLE: "child", T3_CLOUD_THREAD_ID: "allocated" };
+const created = {
+  type: "thread.created",
+  threadId: "allocated",
+  payload: {
+    createdBy: "user",
+    modelSelection: { instanceId: "codex" },
+  },
+};
+
+describe("sandbox creation authority", () => {
+  it("denies every home creation source before event append", () => {
+    for (const createdBy of ["user", "agent", "automation", undefined])
+      expect(
+        sandboxCreationRejection(
+          { ...created, payload: { ...created.payload, createdBy } },
+          { T3_CLOUD_ROLE: "central" },
+        ),
+      ).toBeDefined();
+    for (const type of [
+      "thread.create",
+      "thread.fork",
+      "message.dispatch",
+      "thread.created.record",
+      "subagent.start",
+    ])
+      expect(
+        sandboxCommandRejection({ type, threadId: "allocated" }, { T3_CLOUD_ROLE: "central" }),
+      ).toBeDefined();
+  });
+  it("allows only the bound user thread and Codex provider", () => {
+    expect(sandboxCreationRejection(created, child)).toBeUndefined();
+    expect(sandboxCreationRejection({ ...created, threadId: "other" }, child)).toBeDefined();
+    expect(
+      sandboxCreationRejection(
+        { ...created, payload: { ...created.payload, createdBy: "agent" } },
+        child,
+      ),
+    ).toBeDefined();
+    expect(
+      sandboxCreationRejection(
+        { ...created, payload: { ...created.payload, modelSelection: { instanceId: "claude" } } },
+        child,
+      ),
+    ).toBeDefined();
+    for (const type of [
+      "thread.fork",
+      "thread.created.record",
+      "subagent.start",
+      "automation.run",
+      "multi-model.start",
+    ])
+      expect(sandboxCommandRejection({ type, threadId: "allocated" }, child)).toBeDefined();
+    expect(
+      sandboxCommandRejection({ type: "message.dispatch", threadId: "allocated" }, child),
+    ).toBeUndefined();
+  });
+  it("fails closed on missing binding or invalid role, preserving standalone", () => {
+    expect(sandboxRole({ T3_CLOUD_ROLE: "typo" })).toBe("invalid");
+    expect(sandboxCreationRejection(created, { T3_CLOUD_ROLE: "typo" })).toBeDefined();
+    expect(sandboxCreationRejection(created, { T3_CLOUD_ROLE: "child" })).toBeDefined();
+    expect(sandboxCreationRejection(created, {})).toBeUndefined();
+  });
+});
+
+describe("immutable sandbox provider admission", () => {
+  it("admits only runtime-derived central providers and rejects malformed admission", () => {
+    expect(sandboxAdmittedProviders({ T3_CLOUD_ROLE: "central" })).toEqual(["codex"]);
+    expect(
+      sandboxAdmittedProviders({
+        T3_CLOUD_ROLE: "central",
+        T3_CLOUD_ADMITTED_PROVIDERS: '["codex","claudeAgent"]',
+      }),
+    ).toEqual(["codex", "claudeAgent"]);
+    for (const value of ['["claude"]', '["codex","codex"]', "true", "[]"])
+      expect(
+        sandboxAdmittedProviders({ T3_CLOUD_ROLE: "central", T3_CLOUD_ADMITTED_PROVIDERS: value }),
+      ).toEqual([]);
+    expect(
+      sandboxAdmittedProviders({ ...child, T3_CLOUD_ADMITTED_PROVIDERS: '["claudeAgent"]' }),
+    ).toEqual([]);
+  });
+  it("rejects omitted creation, cross-provider defaults and persisted restart identity", () => {
+    const assigned = { ...child, T3_CLOUD_PROVIDER_INSTANCE_ID: "claudeAgent" };
+    const selection = { instanceId: "claudeAgent" };
+    expect(
+      sandboxCommandRejection(
+        { type: "thread.create", threadId: "allocated", modelSelection: selection },
+        assigned,
+      ),
+    ).toBeUndefined();
+    expect(
+      sandboxCommandRejection({ type: "thread.create", threadId: "allocated" }, assigned),
+    ).toBeDefined();
+    expect(
+      sandboxCommandRejection(
+        { type: "project.update", defaultModelSelection: { instanceId: "codex" } },
+        assigned,
+      ),
+    ).toBeDefined();
+    for (const instanceId of ["codex", "claude", "custom-claude"])
+      expect(
+        sandboxSessionRejection({ threadId: "allocated", instanceId }, assigned),
+      ).toBeDefined();
+    expect(
+      sandboxSessionRejection(
+        { threadId: "allocated", instanceId: "claudeAgent", persistedInstanceId: "codex" },
+        assigned,
+      ),
+    ).toBeDefined();
+    expect(
+      sandboxSessionRejection(
+        { threadId: "allocated", instanceId: "claudeAgent", persistedDriver: "codex" },
+        assigned,
+      ),
+    ).toBeDefined();
+    expect(
+      sandboxSessionRejection(
+        { threadId: "allocated", instanceId: "claudeAgent", persistedDriver: "claudeAgent" },
+        assigned,
+      ),
+    ).toBeUndefined();
+    expect(
+      sandboxSessionRejection({ threadId: "other", instanceId: "claudeAgent" }, assigned),
+    ).toBeDefined();
+  });
+});
