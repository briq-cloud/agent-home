+import { describe, expect, it } from "vite-plus/test";
+import { ORCHESTRATION_V2_WS_METHODS, WS_METHODS, WsRpcGroup } from "@t3tools/contracts";
+import { sandboxHttpAllowed, sandboxRpcAllowed } from "./briqSandboxAccess.ts";
+
+const home = { T3_CLOUD_ROLE: "central" };
+describe("home access boundary", () => {
+  it("allows only the audited native bootstrap and allocator RPCs, failing closed for new methods", () => {
+    const allowed = new Set<string>([
+      WS_METHODS.serverProbe, WS_METHODS.serverGetConfig, WS_METHODS.subscribeServerConfig,
+      WS_METHODS.subscribeServerLifecycle, WS_METHODS.subscribeAuthAccess,
+      WS_METHODS.serverReportClientActivity, ORCHESTRATION_V2_WS_METHODS.subscribeShell,
+      ORCHESTRATION_V2_WS_METHODS.allocateSandboxThread,
+    ]);
+    for (const method of [...WsRpcGroup.requests.keys(), "future.readFile"])
+      expect(sandboxRpcAllowed(method, home)).toBe(allowed.has(method));
+  });
+  it("denies workspace discovery, reads, signed assets, and internal thread creation even with write grants", () => {
+    for (const method of [WS_METHODS.projectsReadFile, WS_METHODS.projectsListEntries,
+      WS_METHODS.assetsCreateUrl, ORCHESTRATION_V2_WS_METHODS.dispatchCommand]) {
+      expect(sandboxRpcAllowed(method, home)).toBe(false);
+      expect(sandboxRpcAllowed(method, { T3_CLOUD_ROLE: "invalid" })).toBe(false);
+      expect(sandboxRpcAllowed(method, { T3_CLOUD_ROLE: "child" })).toBe(true);
+    }
+  });
+  it("matches registered HTTP routes rather than attacker-selected path prefixes", () => {
+    for (const [method, route] of [["GET", "/api/assets/*"], ["POST", "/api/attachments/upload/*"],
+      ["GET", "/api/guest/media"], ["*", "/api/device-hub/*"], ["*", "/mcp"],
+      ["POST", "/oauth/mcp/token"]]) {
+      expect(sandboxHttpAllowed(method!, route!, home)).toBe(false);
+      expect(sandboxHttpAllowed(method!, route!, { T3_CLOUD_ROLE: "child" })).toBe(true);
+    }
+    expect(sandboxHttpAllowed("GET", "*", home)).toBe(true);
+    expect(sandboxHttpAllowed("POST", "*", home)).toBe(false);
+    expect(sandboxHttpAllowed("GET", "*", { T3_CLOUD_ROLE: "invalid" })).toBe(false);
+  });
+});
diff --git a/apps/server/src/briqSandboxAccess.ts b/apps/server/src/briqSandboxAccess.ts
new file mode 100644
index 00000000..861e5d85
--- /dev/null
+++ b/apps/server/src/briqSandboxAccess.ts
@@ -0,0 +1,49 @@
+import { ORCHESTRATION_V2_WS_METHODS, WS_METHODS } from "@t3tools/contracts";
+import { sandboxRole } from "./briqSandbox.ts";
+
+type Environment = Readonly<Record<string, string | undefined>>;
+const HOME_RPCS: ReadonlySet<string> = new Set([
+  WS_METHODS.serverProbe,
+  WS_METHODS.serverGetConfig,
+  WS_METHODS.subscribeServerConfig,
+  WS_METHODS.subscribeServerLifecycle,
+  WS_METHODS.subscribeAuthAccess,
+  WS_METHODS.serverReportClientActivity,
+  ORCHESTRATION_V2_WS_METHODS.subscribeShell,
+  ORCHESTRATION_V2_WS_METHODS.allocateSandboxThread,
+]);
+
+// A home is a connection/allocation surface, never a workspace. New RPCs are
+// unavailable until deliberately audited here; ordinary grants cannot widen it.
+export function sandboxRpcAllowed(method: string, env: Environment = process.env): boolean {
+  const role = sandboxRole(env);
+  return role === "standalone" || role === "child" || (role === "central" && HOME_RPCS.has(method));
+}
+
+const HOME_HTTP_ROUTES: ReadonlySet<string> = new Set([
+  "GET /.well-known/t3/environment",
+  "GET /ws",
+  "GET /api/auth/session",
+  "GET /api/orchestration/shell",
+  "GET /api/projects",
+  "POST /api/auth/browser-session",
+  "POST /oauth/token",
+  "POST /api/auth/websocket-ticket",
+  "POST /api/auth/websocket-ticket/:use",
+  "POST /api/auth/pairing-token",
+  "POST /api/auth/pairing-links/revoke",
+  "POST /api/auth/clients/revoke",
+  "POST /api/auth/clients/revoke-others",
+]);
+
+// Match the server's registered route, not a request-controlled path prefix.
+// The sole GET wildcard is the packaged static/SPA handler, whose filesystem
+// root and traversal checks remain upstream's. No API wildcard is admitted.
+export function sandboxHttpAllowed(
+  method: string, route: string, env: Environment = process.env,
+): boolean {
+  const role = sandboxRole(env);
+  if (role === "standalone" || role === "child") return true;
+  if (role === "invalid") return false;
+  return (method === "GET" && route === "*") || HOME_HTTP_ROUTES.has(`${method} ${route}`);
+}
