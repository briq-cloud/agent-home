+    expect(receipts.complete(entry!)).toBe(false);
+    if (receiptFirst) receipts.written("transport", 1);
+    else receipts.observe("child-request", "session", 1, false);
+    expect(receipts.complete(entry!)).toBe(true);
+    expect(receipts.complete(entry!)).toBe(false);
+    expect(receipts.bind("child-request", "session", 1, "replay")).toBe(false);
+  }
+});
