diff --git a/apps/server/src/sandbox/ManagedThreadBinding.ts b/apps/server/src/sandbox/ManagedThreadBinding.ts
new file mode 100644
index 0000000000000000000000000000000000000000..79da071c8f415b9a521e6fd31fab656acf873320
--- /dev/null
+++ b/apps/server/src/sandbox/ManagedThreadBinding.ts
@@ -0,0 +1,209 @@
+import { hashTelemetryId as sha256Hex } from "@t3tools/shared/telemetryId";
+import { ManagedProjectReceipt, ThreadId } from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import * as SqlClient from "effect/sql/SqlClient";
+import { FetchHttpClient } from "effect/http";
+import { canonicalManagedJson, validateManagedSource } from "./ManagedProjectSource.ts";
+import { prepareManagedProject } from "./managedBridgeClient.ts";
+import { ManagedHostConfiguration } from "./managedBridgeBootstrap.ts";
+import { ManagedBridgeError } from "./managedBridgeLink.ts";
+import { ManagedAllocation, makeManagedBridgeManager } from "./managedBridgeManager.ts";
+
+const Binding = Schema.Struct({
+  allocation: ManagedAllocation,
+  host: ManagedHostConfiguration,
+  projectReceipt: Schema.optional(ManagedProjectReceipt),
+});
+export type ManagedThreadBindingValue = typeof Binding.Type;
+const sameHost = Schema.toEquivalence(ManagedHostConfiguration);
+const sameBinding = Schema.toEquivalence(Binding);
+const unavailable = () =>
+  new ManagedBridgeError({
+    message: "The managed thread requires reconciliation before it can continue.",
+  });
+
+export class ManagedThreadBinding extends Context.Service<
+  ManagedThreadBinding,
+  {
+    readonly manager: Effect.Success<ReturnType<typeof makeManagedBridgeManager>>;
+    readonly allocate: (
+      host: typeof ManagedHostConfiguration.Type,
+    ) => Effect.Effect<ManagedThreadBindingValue, ManagedBridgeError>;
+    readonly read: (
+      threadId: ThreadId,
+    ) => Effect.Effect<ManagedThreadBindingValue, ManagedBridgeError>;
+  }
+>()("t3/sandbox/ManagedThreadBinding") {}
+
+export const make = Effect.fn("ManagedThreadBinding.make")(function* (
+  manager: Effect.Success<ReturnType<typeof makeManagedBridgeManager>>,
+) {
+  const sql = yield* SqlClient.SqlClient;
+  const readOptional = Effect.fn("ManagedThreadBinding.readOptional")(function* (
+    threadId: ThreadId,
+  ) {
+    const rows = yield* sql<{
+      binding_json: string;
+    }>`SELECT binding_json FROM managed_thread_bindings WHERE thread_id = ${threadId}`;
+    if (rows[0] === undefined) return undefined;
+    const binding = yield* Schema.decodeEffect(Schema.fromJsonString(Binding))(
+      rows[0].binding_json,
+    );
+    if (
+      binding.host.threadId !== threadId ||
+      binding.allocation.threadId !== threadId ||
+      binding.host.modelSelection.instanceId !== binding.allocation.providerInstanceId
+    )
+      return yield* unavailable();
+    if (binding.host.project) {
+      yield* Effect.try({
+        try: () => validateManagedSource(binding.host.project!.projectSource),
+        catch: unavailable,
+      });
+      const source = binding.host.project.projectSource;
+      if (
+        binding.allocation.project.workspaceRoot !== `/work/projects/${source.sourceId}` ||
+        binding.host.project.workspaceStrategy.type === "existing_worktree"
+      )
+        return yield* unavailable();
+      const receipt = binding.projectReceipt;
+      if (
+        receipt &&
+        (receipt.phase !== "done" ||
+          receipt.sourceId !== source.sourceId ||
+          receipt.sourceDigest !== source.sourceDigest ||
+          receipt.allocationId !== binding.allocation.allocationId ||
+          receipt.projectId !== binding.allocation.project.id ||
+          receipt.workspaceRoot !== binding.allocation.project.workspaceRoot ||
+          receipt.remoteUrl !== source.clone.remoteUrl ||
+          !receipt.headCommit)
+      )
+        return yield* unavailable();
+    }
+    const intents = yield* sql<{
+      host_json: string;
+    }>`SELECT host_json FROM managed_thread_launch_intents WHERE thread_id = ${threadId}`;
+    if (intents[0]) {
+      const intent = yield* Schema.decodeEffect(Schema.fromJsonString(ManagedHostConfiguration))(
+        intents[0].host_json,
+      );
+      if (!sameHost(intent, binding.host)) return yield* unavailable();
+    } else if (binding.host.project) return yield* unavailable();
+    return binding;
+  }, Effect.mapError(unavailable));
+  const read = (threadId: ThreadId) =>
+    readOptional(threadId).pipe(
+      Effect.filterOrFail(
+        (binding): binding is ManagedThreadBindingValue =>
+          binding !== undefined &&
+          (!binding.host.project || binding.projectReceipt?.phase === "done"),
+        unavailable,
+      ),
+    );
+  const finishPreparation = Effect.fn("ManagedThreadBinding.finishPreparation")(function* (
+    binding: ManagedThreadBindingValue,
+    start: boolean,
+  ) {
+    if (!binding.host.project || binding.projectReceipt) return binding;
+    const project = binding.host.project;
+    const projectSource = project.projectSource;
+    const cloneOperationId = sha256Hex(
+      canonicalManagedJson({
+        allocationId: binding.allocation.allocationId,
+        sourceDigest: projectSource.sourceDigest,
+      }),
+    );
+    const receipt = yield* manager.withPreparation(binding.allocation, projectSource, (link) =>
+      prepareManagedProject(
+        link,
+        {
+          sourceId: projectSource.sourceId,
+          sourceDigest: projectSource.sourceDigest,
+          allocationId: binding.allocation.allocationId,
+          cloneOperationId,
+          projectId: binding.allocation.project.id,
+          workspaceRoot: binding.allocation.project.workspaceRoot,
+          projectSource,
+          title: project.title,
+          createdAt: project.createdAt,
+        },
+        start,
+      ).pipe(Effect.provide(FetchHttpClient.layer)),
+    );
+    const ready = { ...binding, projectReceipt: receipt };
+    const encoded = yield* Schema.encodeEffect(Schema.fromJsonString(Binding))(ready);
+    yield* sql`UPDATE managed_thread_bindings SET binding_json = ${encoded} WHERE thread_id = ${binding.host.threadId}`;
+    return yield* read(binding.host.threadId);
+  });
+  return ManagedThreadBinding.of({
+    manager,
+    read,
+    allocate: Effect.fn("ManagedThreadBinding.allocate")(function* (host) {
+      const provider = host.modelSelection.instanceId;
+      if (provider !== "codex" && provider !== "claudeAgent") return yield* unavailable();
+      const existing = yield* readOptional(host.threadId);
+      if (existing !== undefined) {
+        if (!sameHost(existing.host, host)) return yield* unavailable();
+        return yield* finishPreparation(existing, false);
+      }
+      if (host.project) {
+        yield* Effect.try({
+          try: () => validateManagedSource(host.project!.projectSource),
+          catch: unavailable,
+        });
+        if (host.project.workspaceStrategy.type === "existing_worktree")
+          return yield* unavailable();
+      }
+      const hostJson = yield* Schema.encodeEffect(Schema.fromJsonString(ManagedHostConfiguration))(
+        host,
+      );
+      yield* sql`INSERT INTO managed_thread_launch_intents (thread_id, host_json) VALUES (${host.threadId}, ${hostJson}) ON CONFLICT(thread_id) DO NOTHING`;
+      const intents = yield* sql<{
+        host_json: string;
+      }>`SELECT host_json FROM managed_thread_launch_intents WHERE thread_id = ${host.threadId}`;
+      if (!intents[0]) return yield* unavailable();
+      const intent = yield* Schema.decodeEffect(Schema.fromJsonString(ManagedHostConfiguration))(
+        intents[0].host_json,
+      );
+      if (!sameHost(intent, host)) return yield* unavailable();
+      // This call is safe to reconcile only because native thread.create already
+      // durably chose this thread ID, and the manager deduplicates that literal ID.
+      const allocation = yield* manager.allocate({
+        threadId: host.threadId,
+        providerInstanceId: provider === "codex" ? "codex" : "claudeAgent",
+        ...(host.project
+          ? {
+              project: {
+                projectSource: host.project.projectSource,
+                workspaceStrategy: host.project.workspaceStrategy,
+              },
+            }
+          : {}),
+      });
+      const binding = { allocation, host };
+      const encoded = yield* Schema.encodeEffect(Schema.fromJsonString(Binding))(binding);
+      const inserted = yield* sql<{
+        thread_id: string;
+      }>`INSERT INTO managed_thread_bindings (thread_id, binding_json) VALUES (${host.threadId}, ${encoded}) ON CONFLICT(thread_id) DO NOTHING RETURNING thread_id`;
+      const persisted = yield* readOptional(host.threadId);
+      if (!persisted) return yield* unavailable();
+      if (!sameBinding(persisted, binding)) return yield* unavailable();
+      return yield* finishPreparation(persisted, inserted.length === 1);
+    }, Effect.mapError(unavailable)),
+  });
+});
+
+export const layer = Layer.effect(
+  ManagedThreadBinding,
+  Effect.gen(function* () {
+    const manager = yield* makeManagedBridgeManager({
+      role: process.env.T3_CLOUD_ROLE,
+      allocatorUrl: process.env.T3_CLOUD_ALLOCATOR_URL,
+      allocatorToken: process.env.T3_CLOUD_ALLOCATOR_TOKEN,
+    }).pipe(Effect.orDie);
+    return yield* make(manager);
+  }),
+).pipe(Layer.provide(FetchHttpClient.layer));
