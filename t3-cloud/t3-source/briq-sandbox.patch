+import { expect, it } from "@effect/vitest";
+import { ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Layer from "effect/Layer";
+import { FetchHttpClient } from "effect/http";
+import { afterEach, vi } from "vite-plus/test";
+import * as BriqSandboxAllocator from "./briqSandboxAllocator.ts";
+
+afterEach(() => vi.unstubAllEnvs());
+
+const allocation =
+  '{"allocationId":"allocation-a","providerInstanceId":"codex","environmentId":"environment-a","threadId":"thread-a","project":{"id":"project-a","title":"Sandbox","workspaceRoot":"/work"},"connection":{"url":"https://child.example","credential":"test-pairing"}}';
+const configure = () => {
+  vi.stubEnv("T3_CLOUD_ROLE", "central");
+  vi.stubEnv("T3_CLOUD_ALLOCATOR_URL", "http://127.0.0.1:8080/_cloud/threads");
+  vi.stubEnv("T3_CLOUD_ALLOCATOR_TOKEN", "test-allocation-capability");
+};
+const allocate = (fetch: typeof globalThis.fetch, providerInstanceId?: "codex" | "claudeAgent") =>
+  BriqSandboxAllocator.BriqSandboxAllocator.pipe(
+    Effect.flatMap((service) =>
+      service.allocate({
+        threadId: ThreadId.make("thread-a"),
+        ...(providerInstanceId ? { providerInstanceId } : {}),
+      }),
+    ),
+    Effect.provide(BriqSandboxAllocator.layer.pipe(Layer.provide(FetchHttpClient.layer))),
+    Effect.provideService(FetchHttpClient.Fetch, fetch),
+  );
+
+it.effect("uses only the fixed allocator and rejects redirects in the injected HTTP client", () =>
+  Effect.gen(function* () {
+    configure();
+    const requests: Array<{ url: string; options: RequestInit | undefined; body: string }> = [];
+    const result = yield* allocate(async (url, options) => {
+      const body = await new Request(url, options).text();
+      requests.push({ url: String(url), options, body });
+      return new Response(allocation.padEnd(65_536, " "));
+    });
+    expect(result.threadId).toBe("thread-a");
+    expect(requests).toHaveLength(1);
+    expect(requests[0]?.url).toBe("http://127.0.0.1:8080/_cloud/threads");
+    expect(requests[0]?.options?.redirect).toBe("error");
+    expect(requests[0]?.body).toBe('{"threadId":"thread-a"}');
+  }),
+);
+
+it.effect("rejects invalid destination configuration before requesting an allocation", () =>
+  Effect.gen(function* () {
+    configure();
+    vi.stubEnv("T3_CLOUD_ALLOCATOR_URL", "https://untrusted.example/_cloud/threads");
+    let requests = 0;
+    const result = yield* Effect.exit(
+      allocate(async () => {
+        requests++;
+        return new Response(allocation);
+      }),
+    );
+    expect(Exit.isFailure(result)).toBe(true);
+    expect(requests).toBe(0);
+  }),
+);
+
+it.effect("rejects cross-thread allocator responses", () =>
+  Effect.gen(function* () {
+    configure();
+    const result = yield* Effect.exit(
+      allocate(async () => new Response(allocation.replace('"thread-a"', '"thread-b"'))),
+    );
+    expect(Exit.isFailure(result)).toBe(true);
+  }),
+);
+
+it.effect("bounds the streamed allocator response before decoding", () =>
+  Effect.gen(function* () {
+    configure();
+    let cancelled = false;
+    const result = yield* Effect.exit(
+      allocate(
+        async () =>
+          new Response(
+            new ReadableStream({
+              start(controller) {
+                controller.enqueue(new Uint8Array(65_537));
+              },
+              cancel() {
+                cancelled = true;
+              },
+            }),
+          ),
+      ),
+    );
+    expect(Exit.isFailure(result)).toBe(true);
+    expect(cancelled).toBe(true);
+  }),
+);
+
+it.effect("rejects cross-provider allocator responses", () =>
+  Effect.gen(function* () {
+    configure();
+    const result = yield* Effect.exit(
+      allocate(
+        async () =>
+          new Response(
+            allocation.replace(
+              '"providerInstanceId":"codex"',
+              '"providerInstanceId":"claudeAgent"',
+            ),
+          ),
+      ),
+    );
+    expect(Exit.isFailure(result)).toBe(true);
+  }),
+);
+
+it.effect(
+  "rejects Claude before allocation when the supervised home has its legacy admission",
+  () =>
+    Effect.gen(function* () {
+      configure();
+      let requests = 0;
+      const result = yield* Effect.exit(
+        allocate(async () => {
+          requests++;
+          return new Response(allocation);
+        }, "claudeAgent"),
+      );
+      expect(Exit.isFailure(result)).toBe(true);
+      expect(requests).toBe(0);
+    }),
+);
diff --git a/apps/server/src/briqSandboxAllocator.ts b/apps/server/src/briqSandboxAllocator.ts
new file mode 100644
index 00000000..22c3bb78
--- /dev/null
+++ b/apps/server/src/briqSandboxAllocator.ts
@@ -0,0 +1,104 @@
+import {
+  BriqSandboxAllocation,
+  BriqSandboxAllocationError,
+  BriqSandboxAllocationInput,
+} from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import * as Stream from "effect/Stream";
+import { FetchHttpClient, HttpClient, HttpClientRequest, HttpClientResponse } from "effect/http";
+import { sandboxRole, sandboxAdmittedProviders } from "./briqSandbox.ts";
+
+export class BriqSandboxAllocator extends Context.Service<
+  BriqSandboxAllocator,
+  {
+    readonly allocate: (
+      input: typeof BriqSandboxAllocationInput.Type,
+    ) => Effect.Effect<typeof BriqSandboxAllocation.Type, BriqSandboxAllocationError>;
+  }
+>()("t3/briqSandboxAllocator") {}
+
+const unavailable = () =>
+  new BriqSandboxAllocationError({
+    message:
+      "Sandbox allocation is unavailable. Check the cloud home before retrying; no local thread was created.",
+  });
+
+const encodeInput = Schema.encodeEffect(Schema.fromJsonString(BriqSandboxAllocationInput));
+const decodeAllocation = Schema.decodeUnknownEffect(Schema.fromJsonString(BriqSandboxAllocation));
+
+const allocatorDestination = (endpoint: string | undefined): URL | undefined => {
+  try {
+    const url = new URL(endpoint ?? "");
+    if (
+      url.protocol === "http:" &&
+      url.hostname === "127.0.0.1" &&
+      url.port &&
+      url.pathname === "/_cloud/threads" &&
+      !url.username &&
+      !url.password &&
+      !url.search &&
+      !url.hash
+    )
+      return url;
+  } catch {
+    /* Missing or invalid configuration fails closed at allocation. */
+  }
+  return undefined;
+};
+
+const make = Effect.gen(function* () {
+  const client = yield* HttpClient.HttpClient;
+  // Only the supervised home receives this allocation-only capability. Never use
+  // the manager owner key or a request's headers as the allocator identity.
+  const role = sandboxRole();
+  const destination = allocatorDestination(process.env.T3_CLOUD_ALLOCATOR_URL);
+  const token = process.env.T3_CLOUD_ALLOCATOR_TOKEN;
+  const admitted = sandboxAdmittedProviders();
+  return BriqSandboxAllocator.of({
+    allocate: Effect.fn("BriqSandboxAllocator.allocate")(function* (input) {
+      if (role !== "central" || !destination || !token) return yield* unavailable();
+      const requested = input.providerInstanceId ?? "codex";
+      if (!admitted.includes(requested)) return yield* unavailable();
+      const body = yield* encodeInput(input).pipe(Effect.mapError(unavailable));
+      const request = HttpClientRequest.post(destination.href).pipe(
+        HttpClientRequest.setHeader("authorization", `Bearer ${token}`),
+        HttpClientRequest.bodyText(body, "application/json"),
+      );
+      const allocation = yield* Effect.gen(function* () {
+        const response = yield* client
+          .execute(request)
+          .pipe(Effect.flatMap(HttpClientResponse.filterStatusOk));
+        const collected = yield* response.stream.pipe(
+          Stream.runFoldEffect(
+            () => ({ chunks: [] as Uint8Array[], length: 0 }),
+            (current, chunk) => {
+              const length = current.length + chunk.length;
+              return length > 65_536
+                ? Effect.fail(unavailable())
+                : Effect.succeed({ chunks: [...current.chunks, chunk], length });
+            },
+          ),
+        );
+        const bytes = new Uint8Array(collected.length);
+        let offset = 0;
+        for (const chunk of collected.chunks) {
+          bytes.set(chunk, offset);
+          offset += chunk.length;
+        }
+        return yield* decodeAllocation(new TextDecoder().decode(bytes));
+      }).pipe(
+        Effect.provideService(FetchHttpClient.RequestInit, { redirect: "error" }),
+        Effect.timeout("60 seconds"),
+        Effect.mapError(unavailable),
+      );
+      if (allocation.threadId !== input.threadId || allocation.providerInstanceId !== requested)
+        return yield* unavailable();
+      return allocation;
+    }),
+  });
+});
+
+export const layer = Layer.effect(BriqSandboxAllocator, make);
