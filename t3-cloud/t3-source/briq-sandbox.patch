+  ) => Stream.Stream<OrchestrationV2ThreadStreamItem, ManagedBridgeError>;
+}
+
+export interface ManagedBridgePorts {
+  readonly readHostThread: () => Effect.Effect<HostThread, ManagedBridgeError>;
+  readonly findLink: (threadId: ThreadId) => Effect.Effect<Option.Option<Link>, ManagedBridgeError>;
+  readonly connect: (link: Link) => Effect.Effect<SandboxSession, ManagedBridgeError, Scope.Scope>;
