+        ),
+      providerStatus: () => Effect.die("No provider status in binding test"),
+      revokeSource: () => Effect.die("No source revocation in binding test"),
+      allocateSource: () => Effect.die("No source allocation"),
+      withPreparation: () => Effect.die("No clone before allocation"),
