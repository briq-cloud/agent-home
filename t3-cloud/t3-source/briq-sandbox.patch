+  receipts.attach("transport", "native-runtime-request", 2);
+  const entry = receipts.written("transport", 2)!;
+  for (const [key, session, generation] of [
+    ["foreign", "session", 2],
+    ["child-request", "foreign", 2],
+    ["child-request", "session", 1],
