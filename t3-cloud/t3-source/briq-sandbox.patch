+  "sandbox reserves one competing intent and preserves it when the losing writer retries",
+  () =>
+    Effect.gen(function* () {
+      const sink = yield* EventSink.EventSinkV2;
+      const sql = yield* SqlClient.SqlClient;
+      const now = yield* DateTime.now;
+      const threadId = ThreadId.make("sandbox-intent-thread");
+      const attempt: OrchestrationV2RunAttempt = {
+        id: RunAttemptId.make("sandbox-intent-attempt"),
+        runId: RunId.make("sandbox-intent-run"),
+        attemptOrdinal: 1,
+        rootNodeId: NodeId.make("sandbox-intent-node"),
+        providerInstanceId: ProviderInstanceId.make("codex"),
+        providerThreadId: ProviderThreadId.make("sandbox-intent-provider-thread"),
+        providerTurnId: null,
+        reason: "initial",
+        status: "running",
+        startedAt: now,
+        completedAt: null,
+      };
+      const event = (
+        name: string,
+        payload: OrchestrationV2RunAttempt,
+      ): OrchestrationV2DomainEvent => ({
+        id: EventId.make(name),
+        type: "run-attempt.updated",
+        threadId,
+        runId: attempt.runId,
+        occurredAt: now,
+        payload,
+      });
+      const missing = yield* sink.writeIfRunAttemptUnchanged({
+        expected: attempt,
+        events: [event("missing-attempt", attempt)],
+      });
+      assert.isFalse(missing.committed);
+      assert.isEmpty(missing.storedEvents);
+      yield* sink.write({ events: [event("seed-attempt", attempt)] });
+      const requestJson =
+        ' \n{"threadId":"native-a","input":[{"type":"text","text":"immutable"}]}\t ';
+      const crypto = yield* Crypto.Crypto;
+      const requestHash = Hex.encode(
+        yield* crypto.digest("SHA-256", new TextEncoder().encode(requestJson)),
+      );
+      const root: OrchestrationV2SandboxOperationIntent = {
+        key: "root-operation",
+        method: "turn/start",
+        trigger: { kind: "root" },
+        requestJson,
+        requestHash,
+        ordinal: 1,
+      };
+      const continuation: OrchestrationV2SandboxOperationIntent = {
+        ...root,
+        key: "continuation-operation",
+        trigger: {
+          kind: "continuation",
+          predecessorNativeTurnId: "native-turn-a",
+          reason: "capacity-retry",
+        },
+        ordinal: 2,
+      };
+      const first = yield* sink.writeIfRunAttemptUnchanged({
+        expected: attempt,
+        events: [event("reserve-root", { ...attempt, sandboxIntents: { root } })],
+      });
+      assert.isTrue(first.committed);
+      const stale = yield* sink.writeIfRunAttemptUnchanged({
+        expected: attempt,
+        events: [event("stale-reservation", { ...attempt, sandboxIntents: { continuation } })],
+      });
+      assert.isFalse(stale.committed);
+      assert.isEmpty(stale.storedEvents);
+      const rows = yield* sql<{ readonly payload_json: string }>`
+      SELECT payload_json FROM orchestration_v2_projection_run_attempts
+      WHERE attempt_id = ${attempt.id}
+    `;
+      const committed = yield* decodeAttempt(rows[0]!.payload_json);
+      assert.deepEqual(committed.sandboxIntents, { root });
+      assert.equal(committed.sandboxIntents?.root?.requestJson, requestJson);
+      assert.equal(
+        Hex.encode(
+          yield* crypto.digest(
+            "SHA-256",
+            new TextEncoder().encode(committed.sandboxIntents!.root!.requestJson),
+          ),
+        ),
+        requestHash,
+      );
+      const merged = yield* sink.writeIfRunAttemptUnchanged({
+        expected: committed,
+        events: [
+          event("reserve-continuation", {
+            ...committed,
+            sandboxIntents: { ...committed.sandboxIntents, continuation },
+          }),
+        ],
+      });
+      assert.isTrue(merged.committed);
+      const stored = yield* sql<{ readonly payload_json: string }>`
+      SELECT payload_json FROM orchestration_v2_projection_run_attempts
+      WHERE attempt_id = ${attempt.id}
+    `;
+      assert.deepEqual((yield* decodeAttempt(stored[0]!.payload_json)).sandboxIntents, {
+        root,
+        continuation,
+      });
+      assert.isAbove(merged.storedEvents[0]!.sequence, first.storedEvents[0]!.sequence);
+      const completedRoot = {
+        ...root,
+        result: { nativeId: "native-root", resultHash: "e".repeat(64) },
+      };
+      yield* sink.write({
+        events: [
+          event("receipt-upsert", { ...attempt, sandboxIntents: { root: completedRoot } }),
+          {
+            id: EventId.make("stale-created-upsert"),
+            threadId,
+            runId: attempt.runId,
+            occurredAt: now,
+            payload: { ...attempt, status: "completed", completedAt: now },
+            type: "run-attempt.created",
+          },
+        ],
+      });
+      const preserved = yield* sql<{
+        readonly payload_json: string;
+      }>`SELECT payload_json FROM orchestration_v2_projection_run_attempts WHERE attempt_id = ${attempt.id}`;
+      assert.deepEqual((yield* decodeAttempt(preserved[0]!.payload_json)).sandboxIntents, {
+        root: completedRoot,
+        continuation,
+      });
+      const adoptedRoot = {
+        ...completedRoot,
+        adoption: { ...completedRoot.result, eventSequence: first.storedEvents[0]!.sequence },
+      };
+      yield* sink.write({
+        events: [
+          event("adoption-ack", { ...attempt, sandboxIntents: { root: adoptedRoot } }),
+          event("stale-after-adoption", { ...attempt, sandboxIntents: { root: completedRoot } }),
+        ],
+      });
+      const adopted = yield* sql<{ readonly payload_json: string }>`
+        SELECT payload_json FROM orchestration_v2_projection_run_attempts WHERE attempt_id = ${attempt.id}
+      `;
+      assert.deepEqual(
+        (yield* decodeAttempt(adopted[0]!.payload_json)).sandboxIntents?.root,
