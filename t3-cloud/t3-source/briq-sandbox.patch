+        yield* router.add(
+          "GET",
+          "/api/guest/media",
+          Effect.sync(() => {
+            handled.push("guest");
+            return HttpServerResponse.text("synthetic guest bytes");
+          }),
+        );
+        yield* router.add(
+          "GET",
+          "/api/device-hub/*",
+          Effect.sync(() => {
+            handled.push("device");
+            return HttpServerResponse.empty();
