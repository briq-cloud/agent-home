@@ -0,0 +1,146 @@
+import { describe, expect, it } from "@effect/vitest";
+import {
+  EnvironmentAuthorizationError,
+  OrchestrationV2GetThreadProjectionError,
+  ThreadId,
+} from "@t3tools/contracts";
+import * as Schema from "effect/Schema";
+import * as Effect from "effect/Effect";
+import * as Socket from "effect/socket/Socket";
+import { OrchestratorProjectionError } from "../../src/orchestration-v2/Orchestrator.ts";
+import { ProjectionStoreThreadNotFoundError } from "../../src/orchestration-v2/ProjectionStore.ts";
+import { expectedMissingProjection, makeAcceptanceSocketLayer } from "./acceptance.ts";
+
+const foreign = ThreadId.make("foreign-allocated-thread");
+const other = ThreadId.make("different-thread");
+const codec = Schema.toCodecJson(
+  Schema.Union([OrchestrationV2GetThreadProjectionError, EnvironmentAuthorizationError]),
+);
+const isThreadProjectionError = Schema.is(OrchestrationV2GetThreadProjectionError);
+const roundtrip = (error: OrchestrationV2GetThreadProjectionError) => {
+  const decoded = Schema.decodeUnknownSync(codec)(
+    JSON.parse(JSON.stringify(Schema.encodeSync(codec)(error))),
+  );
+  if (!isThreadProjectionError(decoded)) throw new Error("Unexpected RPC error variant");
+  return decoded;
+};
+const outer = (
+  cause: unknown,
+  threadId = foreign,
+  message = `Failed to load orchestration V2 thread ${threadId}`,
+) => new OrchestrationV2GetThreadProjectionError({ threadId, message, cause });
+const missing = (threadId = foreign) => new ProjectionStoreThreadNotFoundError({ threadId });
+const middle = (cause: unknown = missing(), threadId = foreign) =>
+  new OrchestratorProjectionError({ threadId, cause });
+const namedError = (name: string, message: string, cause?: unknown) =>
+  Object.assign(new Error(message, cause === undefined ? undefined : { cause }), { name });
+
+describe("native child foreign-read recognition through the installed RPC error codec", () => {
+  it("recognizes the actual missing-projection wire shape without nested custom fields", () => {
+    const error = roundtrip(outer(middle()));
+    expect(expectedMissingProjection(error, foreign)).toBe(true);
+    expect(error).toBeInstanceOf(OrchestrationV2GetThreadProjectionError);
+    expect(error.cause).toBeInstanceOf(Error);
+    const cause = error.cause as Error;
+    expect(cause.name).toBe("OrchestratorProjectionError");
+    expect(cause.message).toBe(`Failed to load orchestration projection for thread ${foreign}.`);
+    expect(cause).not.toHaveProperty("_tag");
+    expect(cause).not.toHaveProperty("threadId");
+    expect(cause.cause).toBeInstanceOf(Error);
+    const leaf = cause.cause as Error;
+    expect(leaf.name).toBe("ProjectionStoreThreadNotFoundError");
+    expect(leaf.message).toBe(`No orchestration projection exists for thread ${foreign}.`);
+    expect(leaf.cause).toBeUndefined();
+    expect(leaf).not.toHaveProperty("_tag");
+    expect(leaf).not.toHaveProperty("threadId");
+  });
+
+  it.each([
+    ["wrong outer identity", () => outer(middle(), other)],
+    ["wrong outer message", () => outer(middle(), foreign, "Failed to load thread")],
+    ["wrong middle identity", () => outer(middle(missing(), other))],
+    ["wrong leaf identity", () => outer(middle(missing(other)))],
+    ["absent middle cause", () => outer(undefined)],
+    ["absent leaf cause", () => outer(new OrchestratorProjectionError({ threadId: foreign }))],
+    [
+      "database read failure",
+      () => outer(middle(namedError("ProjectionStoreReadError", "Database unavailable"))),
+    ],
+    [
+      "wrong middle name",
+      () =>
+        outer(
+          namedError(
+            "Error",
+            `Failed to load orchestration projection for thread ${foreign}.`,
+            missing(),
+          ),
+        ),
+    ],
+    [
+      "wrong leaf name",
+      () =>
+        outer(
+          middle(namedError("Error", `No orchestration projection exists for thread ${foreign}.`)),
+        ),
+    ],
+    [
+      "unexpected deeper cause",
+      () =>
+        outer(
+          middle(
+            namedError(
+              "ProjectionStoreThreadNotFoundError",
+              `No orchestration projection exists for thread ${foreign}.`,
+              new Error("database unavailable"),
+            ),
+          ),
+        ),
+    ],
+    [
+      "tagged object instead of decoded Error",
+      () => outer({ _tag: "OrchestratorProjectionError", threadId: foreign, cause: missing() }),
+    ],
+  ] as const)("rejects %s after real codec roundtrip", (_label, makeError) => {
+    expect(expectedMissingProjection(roundtrip(makeError()), foreign)).toBe(false);
+  });
+
+  it.each([
+    new Error("WebSocket disconnected"),
+    { _tag: "RpcClientError", reason: "transport" },
+    { _tag: "EnvironmentAuthorizationError", message: "session expired" },
+    {
+      _tag: "OrchestrationV2GetThreadProjectionError",
+      threadId: foreign,
+      message: `Failed to load orchestration V2 thread ${foreign}`,
+      cause: {
+        name: "OrchestratorProjectionError",
+        message: `Failed to load orchestration projection for thread ${foreign}.`,
+        cause: {
+          name: "ProjectionStoreThreadNotFoundError",
+          message: `No orchestration projection exists for thread ${foreign}.`,
+        },
+      },
+    },
+  ])("rejects transport/auth failures and undecoded nested shapes", (error) => {
+    expect(expectedMissingProjection(error, foreign)).toBe(false);
+  });
+});
+
+// Import the executable driver itself; building its declared Node layer must not dial or read stdin.
+it.effect(
+  "imports the executable driver and constructs its real Node WebSocket service without dialing",
+  () =>
+    Effect.gen(function* () {
+      const constructor = yield* Socket.WebSocketConstructor;
+      expect(typeof constructor).toBe("function");
+    }).pipe(Effect.provide(makeAcceptanceSocketLayer())),
+);
+it.effect(
+  "constructs the actual executable WebSocket service with the optional edge-cookie configuration",
+  () =>
+    Effect.gen(function* () {
+      const constructor = yield* Socket.WebSocketConstructor;
+      expect(typeof constructor).toBe("function");
+    }).pipe(Effect.provide(makeAcceptanceSocketLayer("briq_token=FIXTURE_IMPORT_GUARD_ONLY"))),
+);
