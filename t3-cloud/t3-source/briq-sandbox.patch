+// @effect-diagnostics nodeBuiltinImport:off - hashes the fake provider receipt.
+import * as NodeAssert from "node:assert/strict";
+import * as NodeCrypto from "node:crypto";
+import { vi } from "vite-plus/test";
+import { assert, it } from "@effect/vitest";
+import {
+  Channel,
+  claudeBridgeConfiguration,
+  validateClaudeEventEnvelope,
+  validateClaudeBridgeCapability,
+} from "./briqClaudeQuery.ts";
+const transport = vi.hoisted(() => ({
+  methods: [] as string[],
+  authStatus: "unknown",
+  models: [] as Array<{ slug: string }>,
+}));
+vi.mock("@effect/platform-node/NodeSocket", async () => {
+  const { EventEmitter } = await import("node:events");
+  return {
+    NodeWS: {
+      WebSocket: class extends EventEmitter {
+        constructor() {
+          super();
+          queueMicrotask(() => this.emit("open"));
+        }
+        send(bytes: string, callback: (error?: Error) => void) {
+          const { id, method } = JSON.parse(bytes);
+          transport.methods.push(method);
+          const result =
+            method === "bridge/capabilities"
+              ? {
+                  providerInstanceId: "claudeAgent",
+                  threadId: "allocated",
+                  authStatus: transport.authStatus,
+                  models: transport.models,
+                }
+              : { nativeId: "22222222-2222-4222-8222-222222222222" };
+          this.emit("message", Buffer.from(JSON.stringify({ id, result })));
+          callback();
+        }
+        terminate() {
+          this.emit("close");
+        }
+      },
+    },
+  };
+});
+const nativeId = "22222222-2222-4222-8222-222222222222";
+const key = "11111111-1111-4111-8111-111111111111";
+it("rejects cross-thread, control, delegated and stale turn events", () => {
+  const event = { type: "assistant", uuid: key, session_id: nativeId, parent_tool_use_id: null };
+  const envelope = { nativeId, threadId: "thread-a", key, event };
+  assert.equal(
+    validateClaudeEventEnvelope(envelope, nativeId, "thread-a", key).event.type,
+    "assistant",
+  );
+  for (const bad of [
+    { ...envelope, threadId: "thread-b" },
+    { ...envelope, key: nativeId },
+    { ...envelope, event: { ...event, type: "auth_status" } },
+    { ...envelope, event: { ...event, parent_tool_use_id: "subagent" } },
+    { ...envelope, event: { ...event, type: "system", subtype: "hook_started" } },
+  ]) {
+    assert.throws(() => validateClaudeEventEnvelope(bad, nativeId, "thread-a", key));
+  }
+});
+it("requires a canonical exact result hash bound to the submitted SDK prompt uuid", () => {
+  const event = { session_id: nativeId, type: "result", user_message_uuid: key, uuid: key };
+  const resultHash = NodeCrypto.createHash("sha256").update(JSON.stringify(event)).digest("hex");
+  const envelope = { nativeId, threadId: "thread-a", key, event, resultHash };
+  assert.deepEqual(validateClaudeEventEnvelope(envelope, nativeId, "thread-a", key).receipt, {
+    nativeId,
+    key,
+    resultHash,
+  });
+  assert.throws(() =>
+    validateClaudeEventEnvelope(
+      { ...envelope, event: { ...event, user_message_uuid: nativeId } },
+      nativeId,
+      "thread-a",
+      key,
+    ),
+  );
+  assert.throws(() =>
+    validateClaudeEventEnvelope(
+      { ...envelope, resultHash: "0".repeat(64) },
+      nativeId,
+      "thread-a",
+      key,
+    ),
+  );
+});
+it("rejects bridge routing and credential confusion before opening a socket", () => {
+  assert.throws(() =>
+    claudeBridgeConfiguration({
+      T3_CLOUD_ROLE: "child",
+      T3_CLOUD_BRIDGE_URL: "wss://cloud.example/other",
+    }),
+  );
+});
+
+it("requires authoritative matching bridge capability and never treats admission as authentication", () => {
+  const capability = {
+    providerInstanceId: "claudeAgent",
+    threadId: "allocated",
+    models: [{ slug: "claude-haiku-4-5-20251001" }],
+    authStatus: "unknown",
+  };
+  assert.equal(validateClaudeBridgeCapability(capability, "allocated").authStatus, "unknown");
+  for (const authStatus of ["unknown", "unauthenticated", "authenticated"] as const)
+    assert.deepEqual(
+      validateClaudeBridgeCapability({ ...capability, authStatus, models: [] }, "allocated"),
+      { authStatus, models: [] },
+    );
+  for (const bad of [
+    { ...capability, providerInstanceId: "codex" },
+    { ...capability, threadId: "other" },
+    { ...capability, authStatus: true },
+    { ...capability, token: "forbidden" },
+  ])
+    assert.throws(() => validateClaudeBridgeCapability(bad, "allocated"));
+});
+
+it("recovers bound lifecycle requests without metadata and gates each new effect against fresh authority", async () => {
+  transport.methods = [];
+  transport.authStatus = "unknown";
+  transport.models = [];
+  const channel = new Channel({
+    T3_CLOUD_ROLE: "child",
+    T3_CLOUD_PROVIDER_INSTANCE_ID: "claudeAgent",
+    T3_CLOUD_THREAD_ID: "allocated",
+    T3_CLOUD_BRIDGE_URL: "wss://cloud.example/_cloud/bridge",
+    T3_CLOUD_BRIDGE_TOKEN: "a".repeat(43),
+    T3_CLOUD_EDGE_TOKEN: "b".repeat(43),
+  });
+  try {
+    for (const method of [
+      "claude/allocate",
+      "claude/pending",
+      "claude/receipt",
+      "claude/adopt",
+      "claude/interrupt",
+      "claude/close",
+    ])
+      await channel.request(method, { nativeId });
+    assert.deepEqual(transport.methods, [
+      "claude/allocate",
+      "claude/pending",
+      "claude/receipt",
+      "claude/adopt",
+      "claude/interrupt",
+      "claude/close",
+    ]);
+    for (const authStatus of ["unknown", "unauthenticated", "authenticated"] as const) {
+      transport.authStatus = authStatus;
+      for (const method of ["claude/open", "claude/model", "claude/offer"])
+        await NodeAssert.rejects(channel.request(method, { model: "claude-sonnet-4-6" }));
+    }
+    transport.authStatus = "authenticated";
+    transport.models = [{ slug: "claude-sonnet-4-6" }];
+    await channel.request("claude/open", { model: "claude-sonnet-4-6" });
+    transport.authStatus = "unauthenticated";
+    await NodeAssert.rejects(channel.request("claude/offer"));
+    transport.authStatus = "authenticated";
+    transport.models = [];
+    await NodeAssert.rejects(channel.request("claude/model", { model: "claude-sonnet-4-6" }));
+    await channel.request("claude/adopt", { nativeId });
+    assert.equal(transport.methods.filter((method) => method === "claude/open").length, 1);
+    assert.equal(transport.methods.includes("claude/offer"), false);
+    assert.equal(transport.methods.includes("claude/model"), false);
+  } finally {
+    channel.close();
+  }
+});
diff --git a/apps/server/src/briqClaudeQuery.ts b/apps/server/src/briqClaudeQuery.ts
new file mode 100644
index 00000000..1bd47484
--- /dev/null
+++ b/apps/server/src/briqClaudeQuery.ts
@@ -0,0 +1,426 @@
+// @effect-diagnostics nodeBuiltinImport:off globalTimers:off - the WebSocket transport owns and clears request deadlines.
+import * as NodeTimers from "node:timers";
+import * as NodeCrypto from "node:crypto";
+import { NodeWS } from "@effect/platform-node/NodeSocket";
+import type { SDKMessage } from "@anthropic-ai/claude-agent-sdk";
+import * as Effect from "effect/Effect";
+import * as Stream from "effect/Stream";
+import type {
+  ClaudeRemoteResultReceipt,
+  ClaudeAgentSdkQueryOpenInput,
+  ClaudeAgentSdkQueryRunnerError,
+  ClaudeAgentSdkQueryRunnerShape,
+} from "./orchestration-v2/Adapters/ClaudeAdapterV2.ts";
+
+type Environment = Readonly<Record<string, string | undefined>>;
+type Failure = (cause: unknown, method: string) => ClaudeAgentSdkQueryRunnerError;
+export function claudeBridgeConfiguration(env: Environment) {
+  const url = new URL(env.T3_CLOUD_BRIDGE_URL ?? "");
+  const token = env.T3_CLOUD_BRIDGE_TOKEN;
+  const edge = env.T3_CLOUD_EDGE_TOKEN;
+  if (
+    env.T3_CLOUD_ROLE !== "child" ||
+    env.T3_CLOUD_PROVIDER_INSTANCE_ID !== "claudeAgent" ||
+    !/^[a-zA-Z0-9_-]{1,128}$/.test(env.T3_CLOUD_THREAD_ID ?? "") ||
+    url.protocol !== "wss:" ||
+    url.pathname !== "/_cloud/bridge" ||
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash ||
+    !/^[a-zA-Z0-9_-]{43}$/.test(token ?? "") ||
+    !edge ||
+    !/^[\x21\x23-\x2b\x2d-\x3a\x3c-\x5b\x5d-\x7e]{32,512}$/.test(edge) ||
+    edge === token
+  )
+    throw Error("Invalid Claude bridge binding");
+  return { url: url.href, token: token!, edge, threadId: env.T3_CLOUD_THREAD_ID! };
+}
+
+const uuid = (value: unknown): value is string =>
+  typeof value === "string" &&
+  /^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/.test(value);
+function canonical(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+  if (value && typeof value === "object")
+    return `{${Object.keys(value)
+      .sort()
+      .map((key) => `${JSON.stringify(key)}:${canonical((value as Record<string, unknown>)[key])}`)
+      .join(",")}}`;
+  return JSON.stringify(value) ?? "null";
+}
+export function validateClaudeEventEnvelope(
+  value: unknown,
+  nativeId: string | undefined,
+  threadId: string,
+  key: string | undefined,
+) {
+  if (!value || typeof value !== "object") throw Error("Invalid Claude event");
+  const envelope = value as Record<string, unknown>;
+  const event = envelope.event as Record<string, unknown> | undefined;
+  if (
+    Object.keys(envelope).some(
+      (name) => !["nativeId", "threadId", "key", "event", "resultHash"].includes(name),
+    ) ||
+    envelope.nativeId !== nativeId ||
+    envelope.threadId !== threadId ||
+    !event ||
+    !uuid(event.uuid) ||
+    event.session_id !== nativeId ||
+    ![
+      "assistant",
+      "user",
+      "result",
+      "stream_event",
+      "tool_progress",
+      "tool_use_summary",
+      "system",
+    ].includes(String(event.type)) ||
+    (event.parent_tool_use_id !== undefined && event.parent_tool_use_id !== null) ||
+    (event.type === "system" &&
+      !["init", "status", "prompt_lifecycle"].includes(String(event.subtype))) ||
+    !(
+      envelope.key === key ||
+      (envelope.key === null &&
+        event.type === "system" &&
+        ["init", "status"].includes(String(event.subtype)))
+    )
+  )
+    throw Error("Claude event binding mismatch");
+  if (
+    event.type === "result" &&
+    (!key ||
+      !/^[a-f0-9]{64}$/.test(String(envelope.resultHash)) ||
+      envelope.resultHash !==
+        NodeCrypto.createHash("sha256").update(canonical(event)).digest("hex") ||
+      (event.user_message_uuid !== key &&
+        !(Array.isArray(event.user_message_uuids) && event.user_message_uuids.includes(key))))
+  )
+    throw Error("Claude result receipt mismatch");
+  return {
+    event: event as SDKMessage,
+    ...(event.type === "result"
+      ? {
+          receipt: {
+            key: key!,
+            nativeId: nativeId!,
+            resultHash: String(envelope.resultHash),
+          },
+        }
+      : {}),
+  };
+}
+
+export class Channel {
+  private sequence = 0;
+  private failed = false;
+  private nativeId: string | undefined;
+  private turnKey: string | undefined;
+  private model: string | undefined;
+  private readonly receipts = new WeakMap<SDKMessage, ClaudeRemoteResultReceipt>();
+  private readonly threadId: string;
+  private queue: Array<SDKMessage> = [];
+  private waiting: ((value: IteratorResult<SDKMessage>) => void) | undefined;
+  private rejection: ((error: Error) => void) | undefined;
+  private pending = new Map<
+    number,
+    {
+      resolve: (value: Record<string, unknown>) => void;
+      reject: (error: Error) => void;
+      timer: ReturnType<typeof NodeTimers.setTimeout>;
+    }
+  >();
+  readonly socket: NodeWS.WebSocket;
+  readonly ready: Promise<void>;
+  constructor(env: Environment) {
+    const config = claudeBridgeConfiguration(env);
+    this.threadId = config.threadId;
+    this.socket = new NodeWS.WebSocket(config.url, {
+      headers: { authorization: `Bearer ${config.token}`, cookie: `briq_token=${config.edge}` },
+      maxPayload: 2097152,
+      perMessageDeflate: false,
+      handshakeTimeout: 15000,
+    });
+    this.ready = new Promise((resolve, reject) => {
+      this.socket.once("open", resolve);
+      this.socket.once("error", () => reject(Error("Claude bridge unavailable")));
+    });
+    this.socket.on("error", () => this.fail());
+    this.socket.on("close", () => this.fail());
+    this.socket.on("message", (data) => {
+      try {
+        const value = JSON.parse(data.toString());
+        if (typeof value.id === "number") {
+          const pending = this.pending.get(value.id);
+          if (!pending) throw Error();
+          this.pending.delete(value.id);
+          NodeTimers.clearTimeout(pending.timer);
+          if (value.error) pending.reject(Error("Central Claude request rejected"));
+          else if (value.result && typeof value.result === "object") pending.resolve(value.result);
+          else throw Error();
+        } else if (value.method === "claude/event" && this.queue.length < 256) {
+          const { event, receipt } = validateClaudeEventEnvelope(
+            value.params,
+            this.nativeId,
+            this.threadId,
+            this.turnKey,
+          );
+          if (receipt) this.receipts.set(event, receipt);
+          if (this.waiting) {
+            const waiting = this.waiting;
+            this.waiting = undefined;
+            this.rejection = undefined;
+            waiting({ value: event, done: false });
+          } else this.queue.push(event);
+        } else throw Error();
+      } catch {
+        this.fail();
+      }
+    });
+  }
+  private fail() {
+    if (this.failed) return;
+    this.failed = true;
+    for (const pending of this.pending.values()) {
+      NodeTimers.clearTimeout(pending.timer);
+      pending.reject(Error("Claude bridge outcome unknown"));
+    }
+    this.pending.clear();
+    this.queue = [];
+    this.rejection?.(Error("Claude bridge disconnected; no automatic replay"));
+    this.waiting = undefined;
+    this.rejection = undefined;
+    this.socket.terminate();
+  }
+  bind(nativeId: string) {
+    this.nativeId = nativeId;
+  }
+  offer(key: string, text: string) {
+    if (this.turnKey && this.turnKey !== key)
+      return Promise.reject(Error("Claude previous result requires adoption"));
+    this.turnKey = key;
+    return this.request("claude/offer", { nativeId: this.nativeId, key, text });
+  }
+  resultReceipt(message: SDKMessage) {
+    return this.receipts.get(message);
+  }
+  async adopt(receipt: ClaudeRemoteResultReceipt, eventSequence: number) {
+    await this.request("claude/adopt", { ...receipt, eventSequence });
+    if (this.turnKey === receipt.key) this.turnKey = undefined;
+  }
+  close() {
+    this.fail();
+  }
+  async request(method: string, params: Record<string, unknown> = {}) {
+    await this.ready;
+    if (this.failed) throw Error("Claude bridge unavailable");
+    if (["claude/open", "claude/offer", "claude/model"].includes(method)) {
+      const capability = validateClaudeBridgeCapability(
+        await this.request("bridge/capabilities"),
+        this.threadId,
+      );
+      if (capability.authStatus !== "authenticated")
+        throw Error("Central Claude authentication is unavailable");
+      const model = method === "claude/offer" ? this.model : params.model;
+      if (typeof model !== "string" || !capability.models.includes(model))
+        throw Error("Model is not admitted by the central Claude catalog");
+    }
+    const result = await new Promise<Record<string, unknown>>((resolve, reject) => {
+      const id = ++this.sequence;
+      const timer = NodeTimers.setTimeout(() => this.fail(), 30000);
+      this.pending.set(id, { resolve, reject, timer });
+      this.socket.send(JSON.stringify({ id, method, params }), (error) => {
+        if (error) this.fail();
+      });
+    });
+    if (method === "claude/open" || method === "claude/model") this.model = String(params.model);
+    return result;
+  }
+  messages: AsyncIterable<SDKMessage> = {
+    [Symbol.asyncIterator]: () => ({
+      next: () => {
+        if (this.failed) return Promise.reject(Error("Claude bridge unavailable"));
+        if (this.queue.length)
+          return Promise.resolve({ value: this.queue.shift()!, done: false as const });
+        return new Promise<IteratorResult<SDKMessage>>((resolve, reject) => {
+          this.waiting = resolve;
+          this.rejection = reject;
+        });
+      },
+    }),
+  };
+}
+
+export function remoteClaudeRunner(
+  env: Environment,
+  failure: Failure,
+): ClaudeAgentSdkQueryRunnerShape {
+  const denied = (method: string) =>
+    Effect.fail(failure("Unavailable in sandbox Claude policy", method));
+  const attempt = <A>(method: string, operation: () => Promise<A>) =>
+    Effect.tryPromise({ try: operation, catch: (cause) => failure(cause, method) });
+  return {
+    allocateSessionId: attempt("allocateSessionId", async () => {
+      const channel = new Channel(env);
+      try {
+        const result = await channel.request("claude/allocate");
+        if (typeof result.nativeId !== "string" || !/^[a-f0-9-]{36}$/.test(result.nativeId))
+          throw Error("Invalid native identity");
+        return result.nativeId;
+      } finally {
+        channel.close();
+      }
+    }),
+    open: Effect.fn("remoteClaude.open")(function* (input: ClaudeAgentSdkQueryOpenInput) {
+      const config = yield* Effect.try({
+        try: () => claudeBridgeConfiguration(env),
+        catch: (cause) => failure(cause, "binding"),
+      });
+      if (input.threadId !== config.threadId) return yield* denied("open");
+      const nativeId = input.options.sessionId ?? input.options.resume;
+      const channel = new Channel(env);
+      channel.bind(nativeId);
+      yield* attempt("open", async () => {
+        try {
+          const result = await channel.request("claude/open", {
+            nativeId,
+            key: NodeCrypto.randomUUID(),
+            model: input.options.model,
+          });
+          if (result.nativeId !== nativeId) throw Error("Claude native identity mismatch");
+        } catch (error) {
+          channel.close();
+          throw error;
+        }
+      });
+      const request = (method: string, params: Record<string, unknown> = {}) =>
+        attempt(method, () => channel.request(method, { nativeId, ...params })).pipe(Effect.asVoid);
+      return {
+        messages: Stream.fromAsyncIterable(channel.messages, (cause) => failure(cause, "messages")),
+        offer: (message, onQueued) => {
+          const content = message.message.content;
+          // Remote attachments and structured tool results require their own audited transfer path.
+          if (
+            message.type !== "user" ||
+            typeof content !== "string" ||
+            message.parent_tool_use_id !== null ||
+            !uuid(message.uuid) ||
+            (message.session_id !== undefined && message.session_id !== nativeId) ||
+            message.isSynthetic ||
+            message.origin !== undefined ||
+            message.priority !== undefined
+          )
+            return denied("offer");
+          return attempt("offer", () => channel.offer(message.uuid!, content)).pipe(
+            Effect.asVoid,
+            Effect.tap(() => Effect.sync(() => onQueued?.())),
+          );
+        },
+        remoteResultReceipt: (message) => channel.resultReceipt(message),
+        adoptRemoteResult: (receipt, eventSequence) =>
+          attempt("adoptResult", () => channel.adopt(receipt, eventSequence)),
+        setModel: (model) => request("claude/model", { model }),
+        applyFlagSettings: () => denied("applyFlagSettings"),
+        setPermissionMode: (mode) =>
+          mode === "dontAsk" ? Effect.void : denied("setPermissionMode"),
+        stopTask: () => denied("stopTask"),
+        backgroundTasks: () => Effect.succeed(false),
+        interrupt: request("claude/interrupt"),
+        close: request("claude/close").pipe(Effect.ensuring(Effect.sync(() => channel.close()))),
+      };
+    }),
+    reconcileRemoteResults: Effect.fn("remoteClaude.reconcileResults")(
+      function* (threadId, readCommitted) {
+        const config = yield* Effect.try({
+          try: () => claudeBridgeConfiguration(env),
+          catch: (cause) => failure(cause, "binding"),
+        });
+        if (threadId !== config.threadId) return yield* denied("reconcileResults");
+        const channel = new Channel(env);
+        yield* Effect.gen(function* () {
+          const allocation = yield* attempt("allocateSessionId", () =>
+            channel.request("claude/allocate"),
+          );
+          if (!uuid(allocation.nativeId)) return yield* denied("reconcileResults");
+          const nativeId = allocation.nativeId;
+          channel.bind(nativeId);
+          const pending = yield* attempt("pendingResults", () =>
+            channel.request("claude/pending", { nativeId }),
+          );
+          if (!Array.isArray(pending.results) || pending.results.length > 1)
+            return yield* denied("reconcileResults");
+          for (const value of pending.results) {
+            if (
+              !value ||
+              typeof value !== "object" ||
+              Object.keys(value).sort().join(",") !== "key,nativeId,resultHash" ||
+              value.nativeId !== nativeId ||
+              !uuid(value.key) ||
+              !/^[a-f0-9]{64}$/.test(value.resultHash)
+            )
+              return yield* denied("reconcileResults");
+            const receipt: ClaudeRemoteResultReceipt = {
+              nativeId,
+              key: value.key,
+              resultHash: value.resultHash,
+            };
+            const sequence = yield* readCommitted(receipt).pipe(
+              Effect.mapError((cause) => failure(cause, "committedResult")),
+            );
+            if (sequence === undefined) return yield* denied("uncommittedResult");
+            yield* attempt("adoptResult", () => channel.adopt(receipt, sequence));
+          }
+        }).pipe(Effect.ensuring(Effect.sync(() => channel.close())));
+      },
+    ),
+    forkSession: () => denied("forkSession"),
+    subagentLaunchToolUseId: () => denied("subagentLaunchToolUseId"),
+    assertComplete: Effect.void,
+  };
+}
+
+export function validateClaudeBridgeCapability(value: Record<string, unknown>, threadId: string) {
+  if (
+    value.providerInstanceId !== "claudeAgent" ||
+    value.threadId !== threadId ||
+    typeof value.authStatus !== "string" ||
+    !["authenticated", "unauthenticated", "unknown"].includes(value.authStatus) ||
+    Object.keys(value).some(
+      (key) => !["providerInstanceId", "threadId", "authStatus", "models"].includes(key),
+    ) ||
+    !Array.isArray(value.models) ||
+    value.models.length > 128 ||
+    new Set(
+      value.models.map((model: unknown) =>
+        model && typeof model === "object" && "slug" in model ? model.slug : undefined,
+      ),
+    ).size !== value.models.length ||
+    !value.models.every(
+      (model: unknown) =>
+        typeof model === "object" &&
+        model !== null &&
+        Object.keys(model).length === 1 &&
+        "slug" in model &&
+        typeof model.slug === "string" &&
+        /^claude-[a-z0-9][a-z0-9-]{0,120}$/.test(model.slug),
+    )
+  )
+    throw Error("Invalid central Claude capability");
+  return {
+    authStatus: value.authStatus as "authenticated" | "unauthenticated" | "unknown",
+    models: [...new Set((value.models as Array<{ slug: string }>).map((model) => model.slug))],
+  };
+}
+
+export async function readClaudeBridgeCapability(env: Environment) {
+  const config = claudeBridgeConfiguration(env);
+  const channel = new Channel(env);
+  try {
+    return validateClaudeBridgeCapability(
+      await channel.request("bridge/capabilities"),
+      config.threadId,
+    );
+  } finally {
+    channel.close();
+  }
+}
