index 0000000000000000000000000000000000000000..fffbe40b77b64b87164064c03b92dea2d21367e8
--- /dev/null
+++ b/apps/server/src/sandbox/ManagedProjectPreparation.ts
@@ -0,0 +1,554 @@
+import {
+  ManagedProjectBindingInput,
+  ManagedProjectPrepareRequest,
+  ManagedProjectReceipt,
+} from "@t3tools/contracts";
+import * as Crypto from "effect/Crypto";
+import {
+  CommandId,
+  OrchestrationDispatchCommandError,
+  IsoDateTime,
+  ProjectId,
+  OrchestrationV2ThreadLaunchWorkspaceStrategy,
+  type ProjectCloneSnapshot,
+} from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as ProjectService from "../project/ProjectService.ts";
+import * as GitVcsDriver from "../vcs/GitVcsDriver.ts";
+import * as Schema from "effect/Schema";
+import * as SqlClient from "effect/sql/SqlClient";
+import * as Stream from "effect/Stream";
+import * as ProjectCloneTracker from "../project/ProjectCloneTracker.ts";
+import {
+  ManagedProjectError,
+  ManagedProjectSource,
+  SourceId,
+  SourceDigest,
+  canonicalManagedJson,
+  validateManagedSource,
+} from "./ManagedProjectSource.ts";
+
+export const ManagedPreparationBinding = ManagedProjectBindingInput;
+export type ManagedPreparationBinding = typeof ManagedPreparationBinding.Type;
+export const ManagedProjectPrepareInput = ManagedProjectPrepareRequest;
+export type ManagedProjectPrepareInput = typeof ManagedProjectPrepareInput.Type;
+export const MANAGED_PROJECT_RPC = {
+  prepare: "managedProject.prepare",
+  read: "managedProject.read",
+  cancel: "managedProject.cancel",
+} as const;
+export const MANAGED_PREPARATION_SCOPES = [
+  "orchestration:read",
+  "orchestration:operate",
+  "source-control:write",
+] as const;
+export const MANAGED_PREPARATION_TTL_SECONDS = 300;
+export const ManagedCloneReceipt = ManagedProjectReceipt;
+export type ManagedCloneReceipt = typeof ManagedCloneReceipt.Type;
+const StoredPreparation = Schema.Struct({
+  intent: ManagedProjectPrepareInput,
+  receipt: ManagedCloneReceipt,
+  environmentId: Schema.String,
+  ownerGeneration: Schema.String,
+  purpose: Schema.Literals(["thread", "project-source"]),
+});
+const codec = Schema.fromJsonString(StoredPreparation);
+
+export interface ManagedNativeCloneHooks extends Omit<
+  ProjectCloneTracker.ProjectCloneHooks,
+  "beforeDone" | "onTerminal"
+> {
+  /** Invoked after successful Git exit, before native done publication. Failure must fail the clone. */
+  readonly beforeDone: () => Effect.Effect<void, ManagedProjectError>;
+  readonly onTerminal: (phase: "failed" | "cancelled") => Effect.Effect<void, ManagedProjectError>;
+}
+export class ManagedPreparationNative extends Context.Service<
+  ManagedPreparationNative,
+  {
+    readonly createProject: ProjectCloneTracker.ProjectCloneHooks["createProject"];
+    readonly onCloned: ProjectCloneTracker.ProjectCloneHooks["onCloned"];
+    readonly inspect: (
+      projectId: ProjectId,
+      workspaceRoot: string,
+    ) => Effect.Effect<
+      {
+        readonly projectId: ProjectId;
+        readonly workspaceRoot: string;
+        readonly repositoryRoot: string;
+        readonly remoteUrl: string;
+        readonly headCommit: string;
+      },
+      ManagedProjectError
+    >;
+    // The adapter must install durable terminal hooks in ProjectCloneTracker, never derive success from admission.
+    readonly start: (
+      input: Parameters<ProjectCloneTracker.ProjectCloneTracker["Service"]["start"]>[0],
+      hooks: ManagedNativeCloneHooks,
+    ) => ReturnType<ProjectCloneTracker.ProjectCloneTracker["Service"]["start"]>;
+  }
+>()("t3/sandbox/ManagedProjectPreparation/ManagedPreparationNative") {}
+
+export interface ManagedPreparationConfiguration {
+  readonly sourceId: string;
+  readonly sourceDigest: string;
+  readonly allocationId: string;
+  readonly projectId: ProjectId;
+  readonly workspaceRoot: string;
+  readonly environmentId: string;
+  readonly ownerGeneration: string;
+  readonly purpose: "thread" | "project-source";
+}
+
+export class ManagedProjectPreparation extends Context.Service<
+  ManagedProjectPreparation,
+  {
+    readonly prepare: (
+      input: ManagedProjectPrepareInput,
+    ) => Effect.Effect<ManagedCloneReceipt, ManagedProjectError>;
+    readonly read: (
+      binding: ManagedPreparationBinding,
+    ) => Effect.Effect<ManagedCloneReceipt, ManagedProjectError>;
+    readonly cancel: (
+      binding: ManagedPreparationBinding,
+    ) => Effect.Effect<boolean, ManagedProjectError>;
+    readonly snapshot: (
+      binding: ManagedPreparationBinding,
+    ) => Effect.Effect<ProjectCloneSnapshot, ManagedProjectError>;
+    readonly subscribeClones: Stream.Stream<
+      ReadonlyArray<ProjectCloneSnapshot>,
+      ManagedProjectError
+    >;
+  }
+>()("t3/sandbox/ManagedProjectPreparation") {}
+
+export const make = Effect.fn("ManagedProjectPreparation.make")(function* (
+  config: ManagedPreparationConfiguration,
+) {
+  const sql = yield* SqlClient.SqlClient;
+  const tracker = yield* ProjectCloneTracker.ProjectCloneTracker;
+  const native = yield* ManagedPreparationNative;
+  const activeOperations = new Set<string>();
+  const sameBinding = (a: ManagedPreparationBinding, b: ManagedPreparationBinding) =>
+    a.sourceId === b.sourceId &&
+    a.sourceDigest === b.sourceDigest &&
+    a.allocationId === b.allocationId &&
+    a.projectId === b.projectId &&
+    a.workspaceRoot === b.workspaceRoot &&
+    a.cloneOperationId === b.cloneOperationId;
+  const validateBinding = Effect.fn("ManagedProjectPreparation.validateBinding")(function* (
+    binding: ManagedPreparationBinding,
+  ) {
+    if (
+      !Schema.is(ManagedPreparationBinding)(binding) ||
+      !config.ownerGeneration ||
+      !config.environmentId ||
+      binding.sourceId !== config.sourceId ||
+      binding.sourceDigest !== config.sourceDigest ||
+      binding.allocationId !== config.allocationId ||
+      binding.projectId !== config.projectId ||
+      binding.workspaceRoot !== config.workspaceRoot ||
+      binding.workspaceRoot !== `/work/projects/${binding.sourceId}`
+    )
+      return yield* new ManagedProjectError({ reason: "identity" });
+  });
+  const readStored = Effect.fn("ManagedProjectPreparation.readStored")(function* (
+    binding: ManagedPreparationBinding,
+  ) {
+    yield* validateBinding(binding);
+    const rows = yield* sql<{
+      preparation_json: string;
+    }>`SELECT preparation_json FROM managed_project_preparations WHERE allocation_id = ${binding.allocationId}`.pipe(
+      Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+    );
+    if (!rows[0]) return yield* new ManagedProjectError({ reason: "not-found" });
+    const stored = yield* Schema.decodeEffect(codec)(rows[0].preparation_json).pipe(
+      Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+    );
+    if (
+      stored.environmentId !== config.environmentId ||
+      stored.ownerGeneration !== config.ownerGeneration ||
+      stored.purpose !== config.purpose ||
+      stored.intent.projectSource.sourceId !== binding.sourceId ||
+      stored.intent.projectSource.sourceDigest !== binding.sourceDigest ||
+      !sameBinding(stored.receipt, binding) ||
+      !sameBinding(stored.intent, binding) ||
+      stored.receipt.remoteUrl !== stored.intent.projectSource.clone.remoteUrl
+    )
+      return yield* new ManagedProjectError({ reason: "identity" });
+    yield* Effect.try({
+      try: () => validateManagedSource(stored.intent.projectSource),
+      catch: () => new ManagedProjectError({ reason: "identity" }),
+    });
+    return stored;
+  });
+  const transition = Effect.fn("ManagedProjectPreparation.transition")(function* (
+    binding: ManagedPreparationBinding,
+    phase: "done" | "failed" | "cancelled",
+    headCommit?: string,
+  ) {
+    const stored = yield* readStored(binding);
+    if (stored.receipt.phase === phase) return stored.receipt;
+    if (stored.receipt.phase !== "started")
+      return yield* new ManagedProjectError({ reason: "conflict" });
+    const receipt: ManagedCloneReceipt = {
+      ...stored.receipt,
+      phase,
+      ...(headCommit === undefined ? {} : { headCommit }),
+    };
+    const previous = yield* Schema.encodeEffect(codec)(stored).pipe(
+      Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+    );
+    const next = yield* Schema.encodeEffect(codec)({ ...stored, receipt }).pipe(
+      Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+    );
+    yield* sql`UPDATE managed_project_preparations SET preparation_json = ${next} WHERE allocation_id = ${binding.allocationId} AND preparation_json = ${previous}`.pipe(
+      Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+    );
+    const persisted = yield* readStored(binding);
+    if (canonicalManagedJson(persisted.receipt) !== canonicalManagedJson(receipt))
+      return yield* new ManagedProjectError({ reason: "conflict" });
+    return receipt;
+  });
+  const beforeDone = Effect.fn("ManagedProjectPreparation.beforeDone")(function* (
+    binding: ManagedPreparationBinding,
+  ) {
+    const stored = yield* readStored(binding);
+    const evidence = yield* native.inspect(binding.projectId, binding.workspaceRoot);
+    if (
+      evidence.projectId !== binding.projectId ||
+      evidence.workspaceRoot !== binding.workspaceRoot ||
+      evidence.repositoryRoot !== binding.workspaceRoot ||
+      evidence.remoteUrl !== stored.receipt.remoteUrl ||
+      !/^[a-f0-9]{40,64}$/.test(evidence.headCommit)
+    )
+      return yield* new ManagedProjectError({ reason: "identity" });
+    yield* transition(binding, "done", evidence.headCommit);
+    activeOperations.delete(binding.cloneOperationId);
+  });
+  const read = Effect.fn("ManagedProjectPreparation.read")(function* (
+    binding: ManagedPreparationBinding,
+  ) {
+    const stored = yield* readStored(binding);
+    if (stored.receipt.phase !== "started") return stored.receipt;
+    const live = yield* tracker.get(binding.projectId);
+    // Native snapshots have no operation id. Only the bound durable completion hook proves success.
+    if (!activeOperations.has(binding.cloneOperationId) || !live || live.phase === "done")
+      return { ...stored.receipt, phase: "unknown" as const };
+    return stored.receipt;
+  });
+  const snapshot = Effect.fn("ManagedProjectPreparation.snapshot")(function* (
+    binding: ManagedPreparationBinding,
+  ) {
+    const stored = yield* readStored(binding);
+    const receipt = yield* read(binding);
+    const live = yield* tracker.get(binding.projectId);
+    if (
+      live &&
+      (live.destinationPath !== binding.workspaceRoot || live.remoteUrl !== receipt.remoteUrl)
+    )
+      return yield* new ManagedProjectError({ reason: "identity" });
+    const phase =
+      receipt.phase === "done"
+        ? ("done" as const)
+        : receipt.phase === "failed" || receipt.phase === "cancelled"
+          ? receipt.phase
+          : ("running" as const);
+    return {
+      ...(live ?? {
+        projectId: binding.projectId,
+        remoteUrl: receipt.remoteUrl,
+        destinationPath: binding.workspaceRoot,
+        repository: null,
+        stage: "connecting" as const,
+        percent: null,
+        detail: null,
+        error: null,
+        startedAt: stored.intent.createdAt,
+        endedAt: null,
+        sequence: 0,
+      }),
+      phase,
+      percent: phase === "done" ? 100 : (live?.percent ?? null),
+      detail:
+        receipt.phase === "unknown"
+          ? "Clone outcome requires reconciliation."
+          : (live?.detail ?? null),
+      stalled: receipt.phase === "unknown" || live?.stalled === true,
+    };
+  });
+  return ManagedProjectPreparation.of({
+    read,
+    snapshot,
+    prepare: Effect.fn("ManagedProjectPreparation.prepare")(function* (input) {
+      yield* Schema.decodeEffect(ManagedProjectPrepareInput, { onExcessProperty: "error" })(
+        input,
+      ).pipe(Effect.mapError(() => new ManagedProjectError({ reason: "invalid-source" })));
+      yield* validateBinding(input);
+      yield* Effect.try({
+        try: () => validateManagedSource(input.projectSource),
+        catch: () => new ManagedProjectError({ reason: "invalid-source" }),
+      });
+      if (
+        input.projectSource.sourceId !== input.sourceId ||
+        input.projectSource.sourceDigest !== input.sourceDigest
+      )
+        return yield* new ManagedProjectError({ reason: "identity" });
+      const receipt: ManagedCloneReceipt = {
+        version: 1,
+        sourceId: input.sourceId,
+        sourceDigest: input.sourceDigest,
+        allocationId: input.allocationId,
+        cloneOperationId: input.cloneOperationId,
+        projectId: input.projectId,
+        workspaceRoot: input.workspaceRoot,
+        remoteUrl: input.projectSource.clone.remoteUrl,
+        phase: "started",
+      };
+      const value = yield* Schema.encodeEffect(codec)({
+        intent: input,
+        receipt,
+        environmentId: config.environmentId,
+        ownerGeneration: config.ownerGeneration,
+        purpose: config.purpose,
+      }).pipe(Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })));
+      const inserted = yield* sql<{
+        allocation_id: string;
+      }>`INSERT INTO managed_project_preparations (allocation_id, clone_operation_id, preparation_json) VALUES (${input.allocationId}, ${input.cloneOperationId}, ${value}) ON CONFLICT(allocation_id) DO NOTHING RETURNING allocation_id`.pipe(
+        Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+      );
+      const persisted = yield* readStored(input);
+      if (canonicalManagedJson(persisted.intent) !== canonicalManagedJson(input))
+        return yield* new ManagedProjectError({ reason: "conflict" });
+      if (inserted.length === 0) return yield* read(input);
+      // Persisted started survives interruption and forbids replay after uncertain native admission.
+      activeOperations.add(input.cloneOperationId);
+      yield* native
+        .start(
+          {
+            projectId: input.projectId,
+            title: input.title,
+            createdAt: input.createdAt,
+            remoteUrl: input.projectSource.clone.remoteUrl,
+            protocol: "https",
+            destinationPath: input.workspaceRoot,
+          },
+          {
+            createProject: native.createProject,
+            onCloned: native.onCloned,
+            beforeDone: () => beforeDone(input),
+            onTerminal: (phase) =>
+              transition(input, phase).pipe(
+                Effect.tap(() =>
+                  Effect.sync(() => {
+                    activeOperations.delete(input.cloneOperationId);
+                  }),
+                ),
+                Effect.asVoid,
+              ),
+          },
+        )
+        .pipe(
+          Effect.tapError(() =>
+            Effect.sync(() => {
+              activeOperations.delete(input.cloneOperationId);
+            }),
+          ),
+          Effect.mapError(() => new ManagedProjectError({ reason: "reconciliation" })),
+        );
+      return yield* read(input);
+    }),
+    cancel: Effect.fn("ManagedProjectPreparation.cancel")(function* (binding) {
+      const stored = yield* readStored(binding);
+      if (stored.receipt.phase !== "started") return false;
+      if (!activeOperations.has(binding.cloneOperationId))
+        return yield* new ManagedProjectError({ reason: "reconciliation" });
+      // Tracker cancellation joins its native fiber and terminal hook before returning.
+      return yield* tracker.cancel(binding.projectId);
+    }),
+    subscribeClones: tracker.stream.pipe(
+      Stream.mapEffect(() =>
+        Effect.gen(function* () {
+          const rows = yield* sql<{
+            preparation_json: string;
+          }>`SELECT preparation_json FROM managed_project_preparations WHERE allocation_id = ${config.allocationId}`.pipe(
+            Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+          );
+          if (!rows[0]) return [];
+          const stored = yield* Schema.decodeEffect(codec)(rows[0].preparation_json).pipe(
+            Effect.mapError(() => new ManagedProjectError({ reason: "persistence" })),
+          );
+          return [yield* snapshot(stored.receipt)];
+        }),
+      ),
+    ),
+  });
+});
+export const layer = (config: ManagedPreparationConfiguration) =>
+  Layer.effect(ManagedProjectPreparation, make(config));
+
+export const ManagedWorkspaceResolution = Schema.Struct({
+  original: OrchestrationV2ThreadLaunchWorkspaceStrategy,
+  resolved: OrchestrationV2ThreadLaunchWorkspaceStrategy,
+  sourceId: SourceId,
+  sourceDigest: SourceDigest,
+  childProjectId: ProjectId,
+  childRoot: Schema.String,
+  existingWorktreeMapping: Schema.optional(
+    Schema.Struct({
+      sourceId: SourceId,
+      sourceDigest: SourceDigest,
+      sourceAllocationId: Schema.String,
+      sourcePath: Schema.String,
+      childPath: Schema.String,
+      repositoryRoot: Schema.String,
+      branch: Schema.String,
+      headCommit: Schema.String,
+      clean: Schema.Literal(true),
+    }),
+  ),
+});
+export type ManagedWorkspaceResolution = typeof ManagedWorkspaceResolution.Type;
+export function validateWorkspaceResolution(
+  source: ManagedProjectSource,
+  binding: ManagedPreparationBinding,
+  resolution: ManagedWorkspaceResolution,
+) {
+  validateManagedSource(source);
+  if (
+    resolution.sourceId !== source.sourceId ||
+    resolution.sourceDigest !== source.sourceDigest ||
+    binding.sourceId !== source.sourceId ||
+    binding.sourceDigest !== source.sourceDigest ||
+    resolution.childProjectId !== binding.projectId ||
+    resolution.childRoot !== binding.workspaceRoot
+  )
+    throw new ManagedProjectError({ reason: "identity" });
+  if (resolution.original.type !== "existing_worktree") {
+    if (canonicalManagedJson(resolution.original) !== canonicalManagedJson(resolution.resolved))
+      throw new ManagedProjectError({ reason: "conflict" });
+    return resolution;
+  }
+  const mapping = resolution.existingWorktreeMapping;
+  if (
+    !mapping ||
+    resolution.resolved.type !== "existing_worktree" ||
+    mapping.sourceId !== source.sourceId ||
+    mapping.sourceDigest !== source.sourceDigest ||
+    !mapping.sourceAllocationId ||
+    mapping.sourcePath !== resolution.original.worktreePath ||
+    mapping.childPath !== resolution.resolved.worktreePath ||
+    mapping.repositoryRoot !== binding.workspaceRoot ||
+    !mapping.clean ||
+    !/^[a-f0-9]{40,64}$/.test(mapping.headCommit) ||
+    resolution.original.branch !== resolution.resolved.branch ||
+    (resolution.original.branch !== undefined && mapping.branch !== resolution.original.branch)
+  )
+    throw new ManagedProjectError({ reason: "identity" });
+  return resolution;
+}
+
+export const nativeLayer = Layer.effect(
+  ManagedPreparationNative,
+  Effect.gen(function* () {
+    const tracker = yield* ProjectCloneTracker.ProjectCloneTracker;
+    const projects = yield* ProjectService.ProjectService;
+    const git = yield* GitVcsDriver.GitVcsDriver;
+    const crypto = yield* Crypto.Crypto;
+    return ManagedPreparationNative.of({
+      start: Effect.fn("ManagedPreparationNative.start")((input, hooks) =>
+        tracker.start(input, {
+          ...hooks,
+          beforeDone: () =>
+            hooks
+              .beforeDone()
+              .pipe(
+                Effect.mapError(
+                  (cause) =>
+                    new OrchestrationDispatchCommandError({
+                      message: "Managed project completion could not be committed.",
+                      cause,
+                    }),
+                ),
+              ),
+          onTerminal: (phase) =>
+            hooks
+              .onTerminal(phase)
+              .pipe(
+                Effect.mapError(
+                  (cause) =>
+                    new OrchestrationDispatchCommandError({
+                      message: "Managed project outcome could not be committed.",
+                      cause,
+                    }),
+                ),
+              ),
+        }),
+      ),
+      createProject: Effect.fn("ManagedPreparationNative.createProject")(function* (input) {
+        yield* projects
+          .create({
+            ...input,
+            commandId: CommandId.make(
+              yield* crypto
+                .randomUUIDv4()
+                .pipe(
+                  Effect.mapError(
+                    (cause) =>
+                      new OrchestrationDispatchCommandError({
+                        message: "Managed project command identity could not be allocated.",
+                        cause,
+                      }),
+                  ),
+                ),
+            ),
+          })
+          .pipe(
+            Effect.mapError(
+              (cause) =>
+                new OrchestrationDispatchCommandError({
+                  message: "Managed project registration failed.",
+                  cause,
+                }),
+            ),
+          );
+      }),
+      onCloned: Effect.fn("ManagedPreparationNative.onCloned")(() => Effect.void),
+      inspect: Effect.fn("ManagedPreparationNative.inspect")(function* (projectId, workspaceRoot) {
+        const project = yield* projects
+          .getById(projectId)
+          .pipe(Effect.mapError(() => new ManagedProjectError({ reason: "identity" })));
+        if (Option.isNone(project) || project.value.workspaceRoot !== workspaceRoot)
+          return yield* new ManagedProjectError({ reason: "identity" });
+        const execute = (args: readonly string[]) =>
+          git
+            .execute({
+              operation: "ManagedPreparationNative.inspect",
+              cwd: workspaceRoot,
+              args,
+              maxOutputBytes: 8192,
+            })
+            .pipe(
+              Effect.flatMap((result) =>
+                result.stdoutTruncated || result.exitCode !== 0
+                  ? Effect.fail(new ManagedProjectError({ reason: "identity" }))
+                  : Effect.succeed(result.stdout.trim()),
+              ),
+              Effect.mapError(() => new ManagedProjectError({ reason: "identity" })),
+            );
+        const repositoryRoot = yield* execute(["rev-parse", "--show-toplevel"]);
+        const remoteUrl = yield* execute(["config", "--get", "remote.origin.url"]);
+        const headCommit = yield* execute(["rev-parse", "--verify", "HEAD"]);
+        return {
+          projectId,
+          workspaceRoot: project.value.workspaceRoot,
+          repositoryRoot,
+          remoteUrl,
+          headCommit,
+        };
+      }),
+    });
+  }),
+);
