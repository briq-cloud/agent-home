+  const source = { T3_CLOUD_ROLE: "child", T3_CLOUD_PURPOSE: "project-source" };
+  expect(sandboxRpcAllowed(WS_METHODS.serverRefreshProviders, source)).toBe(false);
+  for (const role of ["standalone", "child"]) {
