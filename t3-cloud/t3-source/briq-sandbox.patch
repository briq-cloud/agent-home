+++ b/apps/server/src/briqSandboxAccess.ts
@@ -0,0 +1,147 @@
+import { ORCHESTRATION_V2_WS_METHODS, WS_METHODS } from "@t3tools/contracts";
+import { sandboxAdmittedProviders, sandboxRole } from "./briqSandbox.ts";
+
+type Environment = Readonly<Record<string, string | undefined>>;
+const HOME_RPCS: ReadonlySet<string> = new Set([
+  WS_METHODS.projectCloneStart,
+  WS_METHODS.projectCloneCancel,
+  WS_METHODS.projectCloneRetry,
+  WS_METHODS.subscribeProjectClones,
+  WS_METHODS.projectsMutate,
+  WS_METHODS.filesystemBrowse,
+  WS_METHODS.filesystemGetMetadata,
+  WS_METHODS.serverDiscoverSourceControl,
+  WS_METHODS.vcsListRefs,
+  WS_METHODS.vcsRefreshStatus,
+  WS_METHODS.subscribeVcsStatus,
+  WS_METHODS.assetsCreateUrl,
+  WS_METHODS.assetsPersistChatAttachments,
+  WS_METHODS.attachmentsCreateUploadUrl,
+  WS_METHODS.attachmentsDelete,
+  WS_METHODS.serverProbe,
+  WS_METHODS.serverGetConfig,
+  WS_METHODS.serverRefreshProviders,
+  WS_METHODS.subscribeServerConfig,
+  WS_METHODS.subscribeServerLifecycle,
+  WS_METHODS.subscribeAuthAccess,
+  WS_METHODS.serverReportClientActivity,
+  ORCHESTRATION_V2_WS_METHODS.subscribeShell,
+  ORCHESTRATION_V2_WS_METHODS.allocateSandboxThread,
+  ORCHESTRATION_V2_WS_METHODS.launchThread,
+  ORCHESTRATION_V2_WS_METHODS.dispatchCommand,
+  ORCHESTRATION_V2_WS_METHODS.getThreadProjection,
+  ORCHESTRATION_V2_WS_METHODS.subscribeThread,
+  ORCHESTRATION_V2_WS_METHODS.getTurnItem,
+  ORCHESTRATION_V2_WS_METHODS.subscribeCommandOutput,
+  ORCHESTRATION_V2_WS_METHODS.getArchivedShellSnapshot,
+  ORCHESTRATION_V2_WS_METHODS.getOlderSettledThreads,
+  ORCHESTRATION_V2_WS_METHODS.getThreadFamily,
+  ORCHESTRATION_V2_WS_METHODS.searchThreads,
+  ORCHESTRATION_V2_WS_METHODS.searchThread,
+  ORCHESTRATION_V2_WS_METHODS.searchThreadStream,
+]);
+
+const SOURCE_RPCS = new Set<string>([
+  "managedProject.prepare",
+  "managedProject.read",
+  "managedProject.cancel",
+  WS_METHODS.serverProbe,
+  WS_METHODS.serverGetConfig,
+  WS_METHODS.subscribeProjectClones,
+  WS_METHODS.vcsListRefs,
+  WS_METHODS.vcsRefreshStatus,
+  WS_METHODS.subscribeVcsStatus,
+]);
+
+// A home stores chat attachments, never project files or workspace assets. New RPCs are
+// unavailable until deliberately audited here; ordinary grants cannot widen it.
+export function sandboxRpcAllowed(method: string, env: Environment = process.env): boolean {
+  const role = sandboxRole(env);
+  if (role === "child" && env.T3_CLOUD_PURPOSE === "project-source") return SOURCE_RPCS.has(method);
+  if (method.startsWith("managedProject.")) return role === "child" && !!env.T3_CLOUD_SOURCE_ID;
+  return role === "standalone" || role === "child" || (role === "central" && HOME_RPCS.has(method));
+}
+
+export function sandboxRpcPayloadAllowed(
+  method: string,
+  payload: unknown,
+  env: Environment = process.env,
+): boolean {
+  if (
+    sandboxRole(env) === "child" &&
+    env.T3_CLOUD_PURPOSE === "project-source" &&
+    [WS_METHODS.vcsListRefs, WS_METHODS.vcsRefreshStatus, WS_METHODS.subscribeVcsStatus].includes(
+      method as never,
+    )
+  )
+    return (
+      typeof payload === "object" &&
+      payload !== null &&
+      "cwd" in payload &&
+      payload.cwd === env.T3_CLOUD_PROJECT_ROOT
+    );
+  if (sandboxRole(env) !== "central") return sandboxRole(env) !== "invalid";
+  if (method === WS_METHODS.serverRefreshProviders) {
+    if (typeof payload !== "object" || payload === null) return false;
+    const input = payload as Readonly<Record<string, unknown>>;
+    return (
+      !("cwd" in input) &&
+      input.refreshModels !== true &&
+      input.fresh !== true &&
+      (input.instanceId === undefined ||
+        sandboxAdmittedProviders(env).some((id) => id === input.instanceId))
+    );
+  }
+  if (method !== WS_METHODS.assetsCreateUrl && method !== WS_METHODS.attachmentsCreateUploadUrl)
+    return true;
+  if (typeof payload !== "object" || payload === null) return false;
+  if (method === WS_METHODS.attachmentsCreateUploadUrl)
+    return !("type" in payload) || payload.type === "image";
+  if (!("resource" in payload) || typeof payload.resource !== "object" || payload.resource === null)
+    return false;
+  return "_tag" in payload.resource && payload.resource._tag === "attachment";
+}
+
+const HOME_HTTP_ROUTES: ReadonlySet<string> = new Set([
+  "GET /api/assets/*",
+  "POST /api/attachments/upload/*",
+  "GET /.well-known/t3/environment",
+  "GET /ws",
+  "GET /api/auth/session",
+  "GET /api/orchestration/shell",
+  "GET /api/projects",
+  "GET /api/orchestration/threads/:threadId",
+  "GET /api/orchestration/threads/:threadId/transcript",
+  "GET /api/orchestration/threads/:threadId/bounded",
+  "GET /api/orchestration/threads/:threadId/history",
+
+  "POST /api/auth/browser-session",
+  "POST /oauth/token",
+  "POST /api/auth/websocket-ticket",
+  "POST /api/auth/websocket-ticket/:use",
+  "POST /api/auth/pairing-token",
+  "POST /api/auth/pairing-links/revoke",
+  "POST /api/auth/clients/revoke",
+  "POST /api/auth/clients/revoke-others",
+]);
+
+// Match the server's registered route, not a request-controlled path prefix.
+// The SPA wildcard retains upstream traversal checks; the two API wildcard
+// handlers require native signed asset/upload tokens.
+export function sandboxHttpAllowed(
+  method: string,
+  route: string,
+  env: Environment = process.env,
+): boolean {
+  const role = sandboxRole(env);
+  if (role === "child" && env.T3_CLOUD_PURPOSE === "project-source")
+    return new Set([
+      "GET /.well-known/t3/environment",
+      "GET /ws",
+      "POST /api/auth/websocket-ticket",
+      "POST /api/auth/websocket-ticket/:use",
+    ]).has(`${method} ${route}`);
+  if (role === "standalone" || role === "child") return true;
+  if (role === "invalid") return false;
+  return (method === "GET" && route === "*") || HOME_HTTP_ROUTES.has(`${method} ${route}`);
+}
