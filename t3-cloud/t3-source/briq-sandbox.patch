@@ -0,0 +1,56 @@
+import { expect, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import { FetchHttpClient } from "effect/http";
+import { makeManagedBridgeManager } from "./managedBridgeManager.ts";
+
+it.effect(
+  "provider status binds private identity and rejects raw, inconsistent or foreign metadata",
+  () => {
+    const config = {
+      role: "central",
+      allocatorUrl: "http://127.0.0.1:8080/_cloud/threads",
+      allocatorToken: "private-allocation-only-capability-test",
+    };
+    const metadata = {
+      providerInstanceId: "codex",
+      available: true,
+      version: "0.166.0",
+      ready: true,
+      authStatus: "authenticated",
+    };
+    let response: unknown = metadata;
+    return Effect.gen(function* () {
+      const manager = yield* makeManagedBridgeManager(config);
+      expect(yield* manager.providerStatus("codex")).toEqual(metadata);
+      for (const invalid of [
+        { ...metadata, account: { email: "never-return@example.test" } },
+        { ...metadata, providerInstanceId: "claudeAgent" },
+        { ...metadata, authStatus: "unknown" },
+        { ...metadata, available: false },
+        { ...metadata, authStatus: "installed" },
+        { ...metadata, version: "private garbage" },
+        { ...metadata, version: "0.166.0\n" },
+        { ...metadata, version: 166 },
+        { ...metadata, ready: false, available: false, authStatus: "unknown" },
+      ]) {
+        response = invalid;
+        expect(Exit.isFailure(yield* manager.providerStatus("codex").pipe(Effect.exit))).toBe(true);
+      }
+      response = { ...metadata, ready: false, authStatus: "unknown" };
+      expect(yield* manager.providerStatus("codex")).toEqual(response);
+    }).pipe(
+      Effect.provide(FetchHttpClient.layer),
+      Effect.provideService(FetchHttpClient.Fetch, async (url, init) => {
+        expect(String(url)).toBe("http://127.0.0.1:8080/_cloud/providers/status");
+        expect(init?.redirect).toBe("error");
+        const request = new Request(url, init);
+        expect(request.headers.get("authorization")).toBe(`Bearer ${config.allocatorToken}`);
+        expect(request.headers.get("origin")).toBeNull();
+        expect(request.headers.get("cookie")).toBeNull();
+        expect(await request.json()).toEqual({ providerInstanceId: "codex" });
+        return Response.json(response);
+      }),
+    );
+  },
+);
diff --git a/apps/server/src/sandbox/managedBridgeRuntime.test.ts b/apps/server/src/sandbox/managedBridgeRuntime.test.ts
