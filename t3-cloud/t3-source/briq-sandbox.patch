+import { expect, it } from "@effect/vitest";
+import { vi } from "vite-plus/test";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as ProviderAdapter from "@t3tools/provider-core/server/ProviderAdapter";
+import * as Stream from "effect/Stream";
+import { EnvironmentId, ProjectId, ProviderInstanceId, ThreadId } from "@t3tools/contracts";
+import { AgentScopeThreadId } from "@t3tools/shared/AgentScope";
+import * as HostProcess from "@t3tools/shared/HostProcess";
+import type * as AcpSessionRuntime from "@t3tools/provider-acp/server/AcpSessionRuntime";
+import type { AcpAdapterV2RuntimeInput } from "@t3tools/provider-acp/server/adapter";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Redacted from "effect/Redacted";
+import * as Schema from "effect/Schema";
+import * as Scope from "effect/Scope";
+import { makeManagedRuntimeFactory, type ManagedRuntimeBinding } from "./managedBridgeRuntime.ts";
+import { ManagedBridgeError, type ManagedBridgeLink } from "./managedBridgeLink.ts";
+import { MANAGED_BRIDGE_BOOTSTRAP, ManagedBridgeBootstrapJson } from "./managedBridgeBootstrap.ts";
+
+const unusedRuntimeOperation = () =>
+  Effect.die("Unexpected runtime operation in lifecycle fixture");
+const runtimeFixture: AcpSessionRuntime.AcpSessionRuntime["Service"] = {
+  handleRequestPermission: unusedRuntimeOperation,
+  handleElicitation: unusedRuntimeOperation,
+  handleMcpConnect: unusedRuntimeOperation,
+  handleMcpMessage: unusedRuntimeOperation,
+  handleMcpDisconnect: unusedRuntimeOperation,
+  handleMcpNotification: unusedRuntimeOperation,
+  handleReadTextFile: unusedRuntimeOperation,
+  handleWriteTextFile: unusedRuntimeOperation,
+  handleCreateTerminal: unusedRuntimeOperation,
+  handleTerminalOutput: unusedRuntimeOperation,
+  handleTerminalWaitForExit: unusedRuntimeOperation,
+  handleTerminalKill: unusedRuntimeOperation,
+  handleTerminalRelease: unusedRuntimeOperation,
+  handleSessionUpdate: unusedRuntimeOperation,
+  handleElicitationComplete: unusedRuntimeOperation,
+  handleUnknownExtRequest: unusedRuntimeOperation,
+  handleUnknownExtNotification: unusedRuntimeOperation,
+  handleExtRequest: unusedRuntimeOperation,
+  handleExtNotification: unusedRuntimeOperation,
+  initialize: unusedRuntimeOperation,
+  start: unusedRuntimeOperation,
+  loadSession: unusedRuntimeOperation,
+  resumeSession: unusedRuntimeOperation,
+  forkSession: unusedRuntimeOperation,
+  listSessions: unusedRuntimeOperation,
+  closeSession: unusedRuntimeOperation,
+  deleteSession: unusedRuntimeOperation,
+  setProvider: unusedRuntimeOperation,
+  disableProvider: unusedRuntimeOperation,
+  prompt: unusedRuntimeOperation,
+  setMode: unusedRuntimeOperation,
+  setSessionModel: unusedRuntimeOperation,
+  setConfigOption: unusedRuntimeOperation,
+  setModel: unusedRuntimeOperation,
+  request: unusedRuntimeOperation,
+  notify: unusedRuntimeOperation,
+  drainEvents: unusedRuntimeOperation(),
+  getModeState: unusedRuntimeOperation(),
+  getConfigOptions: unusedRuntimeOperation(),
+  listProviders: unusedRuntimeOperation(),
+  logout: unusedRuntimeOperation(),
+  cancel: unusedRuntimeOperation(),
+  getEvents: () => Stream.empty,
+};
+const runtimeInput = (
+  onTermination: AcpAdapterV2RuntimeInput["onTermination"],
+): AcpAdapterV2RuntimeInput => ({
+  cwd: "/host-repository",
+  runtimePolicy: ProviderAdapter.ProviderAdapterV2RuntimePolicy.make({
+    cwd: "/host-repository",
+    runtimeMode: "approval-required",
+    interactionMode: "default",
+  }),
+  mcpServers: [],
+  clientCapabilities: {},
+  protocolLogging: {},
+  clientInfo: { name: "native", version: "1" },
+  onTermination,
+});
+const processMock = vi.hoisted(() => ({ make: vi.fn() }));
+vi.mock("@t3tools/provider-acp/server/AcpSessionRuntime", () => ({ make: processMock.make }));
+const threadId = ThreadId.make("thread:runtime");
+const binding: ManagedRuntimeBinding = {
+  allocation: {
+    allocationId: "allocation",
+    threadId,
+    environmentId: EnvironmentId.make("child"),
+    providerInstanceId: "codex",
+    project: { id: ProjectId.make("child-project"), title: "Child", workspaceRoot: "/work" },
+  },
+  host: {
+    threadId,
+    modelSelection: { instanceId: ProviderInstanceId.make("codex"), model: "mock" },
+    runtimeMode: "approval-required",
+    interactionMode: "default",
+  },
+};
+const link: typeof ManagedBridgeLink.Type = {
+  ...binding.allocation,
+  projectId: binding.allocation.project.id,
+  httpBaseUrl: "https://child.example",
+  token: Redacted.make("child-bearer-sentinel"),
+  sessionId: "session",
+  ownerGeneration: "generation",
+};
+const host = <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+  effect.pipe(
+    Effect.provideService(AgentScopeThreadId, threadId),
+    Effect.provideService(HostProcess.ExecutablePath, "/trusted/node"),
+    Effect.provideService(HostProcess.Arguments, ["/trusted/node", "/trusted/bin.mjs"]),
+    Effect.provideService(HostProcess.IsExecutable, false),
+    Effect.provide(NodeServices.layer),
+  );
+
+it.effect(
+  "holds the manager lease and owned process until native runtime scope closes, with minimal bootstrap env",
+  () =>
+    host(
+      Effect.gen(function* () {
+        const scope = yield* Scope.make();
+        let leaseClosed = false,
+          processClosed = false;
+        let captured: AcpSessionRuntime.AcpSessionRuntimeOptions | undefined;
+        const runtime = runtimeFixture;
+        processMock.make.mockImplementation(
+          (options: AcpSessionRuntime.AcpSessionRuntimeOptions) => {
+            captured = options;
+            return Effect.addFinalizer(() =>
+              Effect.sync(() => {
+                processClosed = true;
+              }),
+            ).pipe(Effect.as(runtime));
+          },
+        );
+        const manager = {
+          providerStatus: () => Effect.die("No provider status in runtime startup"),
+          revokeSource: () => Effect.die("No source revocation in runtime startup"),
+          allocateSource: () => Effect.die("No source allocation in runtime startup"),
+          withPreparation: () => Effect.die("No preparation in runtime startup"),
+          allocate: () =>
+            Effect.fail(
+              new ManagedBridgeError({ message: "Must not allocate in runtime startup." }),
+            ),
+          withLink: <A, E, R>(
+            _allocation: ManagedRuntimeBinding["allocation"],
+            use: (value: typeof link) => Effect.Effect<A, E, R>,
+          ) =>
+            Effect.scoped(
+              Effect.addFinalizer(() =>
+                Effect.sync(() => {
+                  leaseClosed = true;
+                }),
+              ).pipe(Effect.andThen(use(link))),
+            ),
+        };
+        const input = {
+          ...runtimeInput(() => Effect.void),
+          processEnvironment: {
