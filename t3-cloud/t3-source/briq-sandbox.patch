+  }),
+);
diff --git a/apps/server/src/sandbox/managedBridgeManager.ts b/apps/server/src/sandbox/managedBridgeManager.ts
new file mode 100644
index 0000000000000000000000000000000000000000..610bbcc58eaeb219bf898462c566b033d4390689
--- /dev/null
+++ b/apps/server/src/sandbox/managedBridgeManager.ts
@@ -0,0 +1,347 @@
+import {
+  BriqSandboxProviderInstanceId,
+  EnvironmentId,
+  ProjectId,
+  ThreadId,
+  OrchestrationV2ThreadLaunchWorkspaceStrategy,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+import * as Semaphore from "effect/Semaphore";
+import * as Stream from "effect/Stream";
+import { FetchHttpClient, HttpClient, HttpClientRequest, HttpClientResponse } from "effect/http";
+import {
+  ManagedProjectSource,
+  ManagedSourceAllocation,
+  validateManagedSource,
+  assertSourceAllocation,
+} from "./ManagedProjectSource.ts";
+import { ManagedBridgeError, ManagedBridgeLink } from "./managedBridgeLink.ts";
+
+export const ManagedPreparationLink = Schema.Struct({
+  purpose: Schema.Literals(["thread", "project-source"]),
+  sourceId: Schema.String,
+  sourceDigest: Schema.String,
+  workspaceRoot: Schema.String,
+  allocationId: Schema.String,
+  environmentId: EnvironmentId,
+  projectId: ProjectId,
+  httpBaseUrl: Schema.String,
+  token: Schema.RedactedFromValue(Schema.NonEmptyString),
+  sessionId: Schema.NonEmptyString,
+  ownerGeneration: Schema.NonEmptyString,
+  threadId: Schema.optional(ThreadId),
+  providerInstanceId: Schema.optional(BriqSandboxProviderInstanceId),
+});
+export const ManagedAllocation = Schema.Struct({
+  allocationId: Schema.NonEmptyString,
+  threadId: ThreadId,
+  environmentId: EnvironmentId,
+  providerInstanceId: BriqSandboxProviderInstanceId,
+  project: Schema.Struct({ id: ProjectId, title: Schema.String, workspaceRoot: Schema.String }),
+});
+const isProviderInstanceId = Schema.is(BriqSandboxProviderInstanceId);
+const isWorkspaceStrategy = Schema.is(OrchestrationV2ThreadLaunchWorkspaceStrategy);
+const fail = () =>
+  new ManagedBridgeError({
+    message:
+      "The private managed bridge is unavailable; inspect the existing allocation before retrying.",
+  });
+
+export function managedManagerOrigin(endpoint: string | undefined): string | undefined {
+  try {
+    const url = new URL(endpoint ?? "");
+    if (
+      url.protocol === "http:" &&
+      url.hostname === "127.0.0.1" &&
+      url.port &&
+      url.pathname === "/_cloud/threads" &&
+      !url.username &&
+      !url.password &&
+      !url.search &&
+      !url.hash
+    )
+      return url.origin;
+  } catch {
+    /* Configuration is server-owned and fails closed. */
+  }
+  return undefined;
+}
+
+// This service stays in the native host. Never pass its allocator capability to
+// ACP subprocesses, projections, requests, provider configuration or child env.
+export const makeManagedBridgeManager = Effect.fn("ManagedBridgeManager.make")(function* (config: {
+  readonly role: string | undefined;
+  readonly allocatorUrl: string | undefined;
+  readonly allocatorToken: string | undefined;
+}) {
+  const http = yield* HttpClient.HttpClient;
+  const origin = managedManagerOrigin(config.allocatorUrl);
+  const capability = config.allocatorToken;
+  if (config.role !== "central" || !origin || !capability || capability.length < 32)
+    return yield* fail();
+
+  const post = (path: string, input: unknown) =>
+    http
+      .execute(
+        HttpClientRequest.post(`${origin}/_cloud/${path}`).pipe(
+          HttpClientRequest.setHeader("authorization", `Bearer ${capability}`),
+          HttpClientRequest.bodyText(JSON.stringify(input), "application/json"),
+        ),
+      )
+      .pipe(
+        Effect.flatMap(HttpClientResponse.filterStatusOk),
+        Effect.provideService(FetchHttpClient.RequestInit, { redirect: "error" }),
+        Effect.timeout("60 seconds"),
+        Effect.mapError(fail),
+      );
+  const read = <A, I>(
+    response: HttpClientResponse.HttpClientResponse,
+    schema: Schema.Codec<A, I>,
+    strict = false,
+  ) =>
+    response.stream.pipe(
+      Stream.runFoldEffect(
+        () => ({ chunks: [] as Uint8Array[], length: 0 }),
+        (current, chunk) => {
+          const length = current.length + chunk.length;
+          return length > 65_536
+            ? Effect.fail(fail())
+            : Effect.succeed({ chunks: [...current.chunks, chunk], length });
+        },
+      ),
+      Effect.flatMap(({ chunks }) =>
+        Schema.decodeEffect(
+          Schema.fromJsonString(schema),
+          strict ? { onExcessProperty: "error" } : undefined,
+        )(Buffer.concat(chunks).toString("utf8")),
+      ),
+      Effect.timeout("15 seconds"),
+      Effect.mapError(fail),
+    );
+
+  const providerStatusSchema = Schema.Struct({
+    providerInstanceId: BriqSandboxProviderInstanceId,
+    available: Schema.Boolean,
+    version: Schema.NullOr(Schema.String),
+    ready: Schema.Boolean,
+    authStatus: Schema.Literals(["authenticated", "unauthenticated", "unknown"]),
+  });
+  const unresolvedPreparationReleases = new Set<string>();
+  const preparationGates = new Map<
+    string,
+    { readonly gate: Semaphore.Semaphore; pending: number }
+  >();
+  const inPreparationOrder = <A, E, R>(key: string, effect: Effect.Effect<A, E, R>) =>
+    Effect.suspend(() => {
+      const held = preparationGates.get(key);
+      const entry = held ?? { gate: Semaphore.makeUnsafe(1), pending: 0 };
+      if (held === undefined) preparationGates.set(key, entry);
+      entry.pending += 1;
+      return entry.gate
+        .withPermits(1)(effect)
+        .pipe(
+          Effect.ensuring(
+            Effect.sync(() => {
+              entry.pending -= 1;
+              if (entry.pending === 0) preparationGates.delete(key);
+            }),
+          ),
+        );
+    });
+  return {
+    providerStatus: Effect.fn("ManagedBridgeManager.providerStatus")(function* (
+      providerInstanceId: string,
+    ) {
+      if (!isProviderInstanceId(providerInstanceId)) return yield* fail();
+      const result = yield* post("providers/status", { providerInstanceId }).pipe(
+        Effect.flatMap((response) => read(response, providerStatusSchema, true)),
+      );
+      if (
+        result.providerInstanceId !== providerInstanceId ||
+        (result.version !== null &&
+          (result.version.trim() !== result.version || !/^\d+\.\d+\.\d+$/.test(result.version))) ||
+        (!result.available && result.version !== null) ||
+        result.ready !== (result.available && result.authStatus === "authenticated") ||
+        (!result.available && result.authStatus !== "unknown")
+      )
+        return yield* fail();
+      return result;
+    }),
+    revokeSource: Effect.fn("ManagedBridgeManager.revokeSource")(function* (
+      source: ManagedProjectSource,
+      allocation: ManagedSourceAllocation,
+    ) {
+      yield* Effect.try({
+        try: () => {
+          validateManagedSource(source);
+          assertSourceAllocation(source, allocation);
+        },
+        catch: fail,
+      });
+      yield* post("projects/source-revoke", {
+        sourceId: source.sourceId,
+        allocationId: allocation.allocationId,
+      }).pipe(
+        Effect.flatMap((response) =>
+          read(response, Schema.Struct({ revoked: Schema.Literal(true) }), true),
+        ),
+      );
+    }),
+    // Native accepted thread.create receipts must exist before calling allocate.
+    allocate: Effect.fn("ManagedBridgeManager.allocate")(function* (input: {
+      readonly threadId: ThreadId;
+      readonly providerInstanceId: typeof BriqSandboxProviderInstanceId.Type;
+      readonly project?: {
+        readonly projectSource: ManagedProjectSource;
+        readonly workspaceStrategy: OrchestrationV2ThreadLaunchWorkspaceStrategy;
+      };
+    }) {
+      if (input.project) {
+        yield* Effect.try({
+          try: () => validateManagedSource(input.project!.projectSource),
+          catch: fail,
+        });
+        if (
+          !isWorkspaceStrategy(input.project.workspaceStrategy) ||
+          input.project.workspaceStrategy.type === "existing_worktree"
+        )
+          return yield* fail();
+      }
+      const response = yield* post("threads/managed", input);
+      const allocation = yield* read(response, ManagedAllocation);
+      if (
+        allocation.threadId !== input.threadId ||
+        allocation.providerInstanceId !== input.providerInstanceId
+      )
+        return yield* fail();
+      if (
+        input.project &&
+        allocation.project.workspaceRoot !==
+          `/work/projects/${input.project.projectSource.sourceId}`
+      )
+        return yield* fail();
+      return allocation;
+    }),
+    allocateSource: Effect.fn("ManagedBridgeManager.allocateSource")(function* (
+      projectSource: ManagedProjectSource,
+    ) {
+      yield* Effect.try({ try: () => validateManagedSource(projectSource), catch: fail });
+      const allocation = yield* post("projects/source", { projectSource }).pipe(
+        Effect.flatMap((response) => read(response, ManagedSourceAllocation)),
+      );
+      yield* Effect.try({
+        try: () => assertSourceAllocation(projectSource, allocation),
+        catch: fail,
+      });
+      return allocation;
+    }),
+    withPreparation: <A, E, R>(
+      allocation: typeof ManagedAllocation.Type | ManagedSourceAllocation,
+      source: ManagedProjectSource,
+      use: (link: typeof ManagedPreparationLink.Type) => Effect.Effect<A, E, R>,
+    ) =>
+      inPreparationOrder(
+        `${"threadId" in allocation ? "threads" : "projects"}:${allocation.allocationId}`,
+        Effect.scoped(
+          Effect.gen(function* () {
+            yield* Effect.try({ try: () => validateManagedSource(source), catch: fail });
+            const thread = "threadId" in allocation;
+            const projectId = thread ? allocation.project.id : allocation.projectId;
+            const workspaceRoot = thread
+              ? allocation.project.workspaceRoot
+              : allocation.workspaceRoot;
+            if (workspaceRoot !== `/work/projects/${source.sourceId}`) return yield* fail();
+            const identity = {
+              ...(thread ? { threadId: allocation.threadId } : { sourceId: source.sourceId }),
+              allocationId: allocation.allocationId,
+              sourceDigest: source.sourceDigest,
+              projectId,
+              workspaceRoot,
+            };
+            const route = thread ? "threads" : "projects";
+            const releaseKey = `${route}:${allocation.allocationId}`;
+            if (unresolvedPreparationReleases.has(releaseKey)) return yield* fail();
+            // Register cleanup on successful issue before decoding or trusting returned identity.
+            return yield* Effect.acquireUseRelease(
+              post(`${route}/preparation-session`, identity),
+              (response) =>
+                Effect.gen(function* () {
+                  const link = yield* read(response, ManagedPreparationLink);
+                  if (
+                    link.purpose !== (thread ? "thread" : "project-source") ||
+                    link.sourceId !== source.sourceId ||
+                    link.sourceDigest !== source.sourceDigest ||
+                    link.allocationId !== allocation.allocationId ||
+                    link.environmentId !== allocation.environmentId ||
+                    link.projectId !== projectId ||
+                    link.workspaceRoot !== workspaceRoot ||
+                    (thread &&
+                      (link.threadId !== allocation.threadId ||
+                        link.providerInstanceId !== allocation.providerInstanceId)) ||
+                    (!thread &&
+                      (link.threadId !== undefined || link.providerInstanceId !== undefined))
+                  )
+                    return yield* fail();
+                  const lease = yield* post(`${route}/preparation-lease`, identity);
+                  return yield* Effect.raceFirst(
+                    use(link),
+                    lease.stream.pipe(
+                      Stream.runDrain,
+                      Effect.andThen(Effect.fail(fail())),
+                      Effect.mapError(fail),
+                    ),
+                  );
+                }),
+              () =>
+                post(`${route}/preparation-revoke`, identity).pipe(
+                  Effect.flatMap((response) =>
+                    read(response, Schema.Struct({ revoked: Schema.Literal(true) })),
+                  ),
+                  Effect.asVoid,
+                  Effect.tapError(() =>
+                    Effect.sync(() => {
+                      unresolvedPreparationReleases.add(releaseKey);
+                    }),
+                  ),
+                  // Release defects combine with the primary cause; uncertain revoke is never retried.
+                  Effect.orDie,
+                  Effect.uninterruptible,
+                ),
+            );
+          }),
+        ),
+      ),
+    withLink: <A, E, R>(
+      allocation: typeof ManagedAllocation.Type,
+      use: (link: typeof ManagedBridgeLink.Type) => Effect.Effect<A, E, R>,
+    ) =>
+      Effect.scoped(
+        Effect.gen(function* () {
+          const identity = { threadId: allocation.threadId, allocationId: allocation.allocationId };
+          const link = yield* post("threads/bridge-session", identity).pipe(
+            Effect.flatMap((response) => read(response, ManagedBridgeLink)),
+          );
+          if (
+            link.threadId !== allocation.threadId ||
+            link.allocationId !== allocation.allocationId ||
+            link.environmentId !== allocation.environmentId ||
+            link.projectId !== allocation.project.id ||
+            link.providerInstanceId !== allocation.providerInstanceId
+          )
+            return yield* fail();
+          // Register manager-side close ownership before opening any child socket.
+          // EOF/error on this lease tears down the entire scoped child connection.
+          const lease = yield* post("threads/bridge-lease", identity);
+          return yield* Effect.raceFirst(
+            use(link),
+            lease.stream.pipe(
+              Stream.runDrain,
+              Effect.andThen(Effect.fail(fail())),
+              Effect.mapError(fail),
+            ),
+          );
+        }),
+      ),
+  };
+});
