+import { describe, expect, it } from "vite-plus/test";
+import { ORCHESTRATION_V2_WS_METHODS, WS_METHODS, WsRpcGroup } from "@t3tools/contracts";
+import { sandboxHttpAllowed, sandboxRpcAllowed } from "./briqSandboxAccess.ts";
+
+const home = { T3_CLOUD_ROLE: "central" };
+describe("home access boundary", () => {
+  it("allows only the audited native bootstrap and allocator RPCs, failing closed for new methods", () => {
+    const allowed = new Set<string>([
+      WS_METHODS.serverProbe, WS_METHODS.serverGetConfig, WS_METHODS.subscribeServerConfig,
+      WS_METHODS.subscribeServerLifecycle, WS_METHODS.subscribeAuthAccess,
+      WS_METHODS.serverReportClientActivity, ORCHESTRATION_V2_WS_METHODS.subscribeShell,
+      ORCHESTRATION_V2_WS_METHODS.allocateSandboxThread,
+    ]);
+    for (const method of [...WsRpcGroup.requests.keys(), "future.readFile"])
+      expect(sandboxRpcAllowed(method, home)).toBe(allowed.has(method));
+  });
+  it("denies workspace discovery, reads, signed assets, and internal thread creation even with write grants", () => {
+    for (const method of [WS_METHODS.projectsReadFile, WS_METHODS.projectsListEntries,
+      WS_METHODS.assetsCreateUrl, ORCHESTRATION_V2_WS_METHODS.dispatchCommand]) {
+      expect(sandboxRpcAllowed(method, home)).toBe(false);
+      expect(sandboxRpcAllowed(method, { T3_CLOUD_ROLE: "invalid" })).toBe(false);
+      expect(sandboxRpcAllowed(method, { T3_CLOUD_ROLE: "child" })).toBe(true);
+    }
+  });
+  it("matches registered HTTP routes rather than attacker-selected path prefixes", () => {
+    for (const [method, route] of [["GET", "/api/assets/*"], ["POST", "/api/attachments/upload/*"],
+      ["GET", "/api/guest/media"], ["*", "/api/device-hub/*"], ["*", "/mcp"],
+      ["POST", "/oauth/mcp/token"]]) {
+      expect(sandboxHttpAllowed(method!, route!, home)).toBe(false);
+      expect(sandboxHttpAllowed(method!, route!, { T3_CLOUD_ROLE: "child" })).toBe(true);
+    }
+    expect(sandboxHttpAllowed("GET", "*", home)).toBe(true);
+    expect(sandboxHttpAllowed("POST", "*", home)).toBe(false);
+    expect(sandboxHttpAllowed("GET", "*", { T3_CLOUD_ROLE: "invalid" })).toBe(false);
+  });
+});
