@@ -0,0 +1,131 @@
+type SandboxEnvironment = Readonly<Record<string, string | undefined>>;
+
+export function sandboxRole(
+  env: SandboxEnvironment = process.env,
+): "central" | "child" | "standalone" | "invalid" {
+  const role = env.T3_CLOUD_ROLE;
+  if (role === undefined || role === "standalone") return "standalone";
+  return role === "central" || role === "child" ? role : "invalid";
+}
+
+export type SandboxProviderInstanceId = "codex" | "claudeAgent";
+
+export function sandboxAssignedProvider(
+  env: SandboxEnvironment = process.env,
+): SandboxProviderInstanceId | undefined {
+  const id = env.T3_CLOUD_PROVIDER_INSTANCE_ID ?? "codex";
+  return id === "codex" || id === "claudeAgent" ? id : undefined;
+}
+
+// Only the supervised central process receives this runtime-derived admission list.
+export function sandboxAdmittedProviders(
+  env: SandboxEnvironment = process.env,
+): ReadonlyArray<SandboxProviderInstanceId> {
+  if (sandboxRole(env) !== "central") return [];
+  if (env.T3_CLOUD_ADMITTED_PROVIDERS === undefined) return ["codex"];
+  try {
+    const ids: unknown = JSON.parse(env.T3_CLOUD_ADMITTED_PROVIDERS);
+    if (
+      Array.isArray(ids) &&
+      ids.length > 0 &&
+      ids.length <= 2 &&
+      ids.every((id) => id === "codex" || id === "claudeAgent") &&
+      new Set(ids).size === ids.length
+    )
+      return ids;
+  } catch {
+    /* Invalid supervised configuration denies allocation. */
+  }
+  return [];
+}
+
+export function sandboxCommandRejection(
+  command: {
+    readonly type: string;
+    readonly threadId?: string | undefined;
+    readonly modelSelection?: { readonly instanceId: string } | undefined;
+    readonly defaultModelSelection?: { readonly instanceId: string } | null | undefined;
+  },
+  env: SandboxEnvironment = process.env,
+): string | undefined {
+  const role = sandboxRole(env);
+  if (role === "standalone") return;
+  if (role === "invalid") return "Invalid sandbox role.";
+  if (command.type.startsWith("project.")) {
+    if (
+      role === "child" &&
+      (command.defaultModelSelection ?? command.modelSelection) &&
+      (command.defaultModelSelection ?? command.modelSelection)?.instanceId !==
+        sandboxAssignedProvider(env)
+    )
+      return "Project defaults must match the allocated provider.";
+    return;
+  }
+  if (role === "central")
+    return "Create a sandbox through the cloud allocator before running a thread.";
+  if (!env.T3_CLOUD_THREAD_ID || command.threadId !== env.T3_CLOUD_THREAD_ID)
+    return "This environment is bound to one allocated thread.";
+  const assigned = sandboxAssignedProvider(env);
+  if (!assigned) return "Invalid sandbox provider assignment.";
+  if (command.modelSelection && command.modelSelection.instanceId !== assigned)
+    return "The effective provider must match this sandbox allocation.";
+  if (command.type === "thread.create" && !command.modelSelection)
+    return "Sandbox thread creation requires its assigned provider explicitly.";
+  if (
+    /fork|multi-model|automation|delegated|thread.created.record|subagent.start/.test(command.type)
+  )
+    return "This operation requires a broker allocation and is unavailable in this sandbox.";
+}
+
+export function sandboxCreationRejection(
+  event: {
+    readonly type: string;
+    readonly threadId: string;
+    readonly payload?: {
+      readonly modelSelection?: { readonly instanceId: string };
+      readonly createdBy?: string | undefined;
+    };
+  },
+  env: SandboxEnvironment = process.env,
+): string | undefined {
+  if (event.type !== "thread.created" || sandboxRole(env) === "standalone") return;
+  return (
+    sandboxCommandRejection(
+      {
+        type: "thread.create",
+        threadId: event.threadId,
+        ...(event.payload?.modelSelection ? { modelSelection: event.payload.modelSelection } : {}),
+      },
+      env,
+    ) ??
+    (event.payload?.createdBy !== "user"
+      ? "Only the allocated user thread can be created in this sandbox."
+      : undefined)
+  );
+}
+
+export function sandboxSessionRejection(
+  input: {
+    readonly threadId: string;
+    readonly instanceId: string;
+    readonly persistedInstanceId?: string;
+    readonly persistedDriver?: string;
+  },
+  env: SandboxEnvironment = process.env,
+): string | undefined {
+  if (sandboxRole(env) === "standalone") return;
+  if (
+    sandboxRole(env) !== "child" ||
+    !env.T3_CLOUD_THREAD_ID ||
+    input.threadId !== env.T3_CLOUD_THREAD_ID
+  )
+    return "Provider execution requires the allocated child thread.";
+  const assigned = sandboxAssignedProvider(env);
+  if (
+    !assigned ||
+    input.instanceId !== assigned ||
+    (input.persistedInstanceId !== undefined && input.persistedInstanceId !== assigned) ||
+    (input.persistedDriver !== undefined && input.persistedDriver !== assigned)
+  )
+    return "Effective and persisted providers must match the sandbox assignment.";
+}
