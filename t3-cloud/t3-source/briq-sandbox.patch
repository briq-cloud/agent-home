diff --git a/apps/server/src/orchestration-v2/SandboxRootRecovery.ts b/apps/server/src/orchestration-v2/SandboxRootRecovery.ts
new file mode 100644
index 00000000..6162ddea
--- /dev/null
+++ b/apps/server/src/orchestration-v2/SandboxRootRecovery.ts
@@ -0,0 +1,93 @@
+// @effect-diagnostics nodeBuiltinImport:off - Validates the existing synchronous immutable operation identity.
+import * as NodeCrypto from "node:crypto";
+import type {
+  OrchestrationV2Run,
+  OrchestrationV2RunAttempt,
+  OrchestrationV2ProviderThread,
+  OrchestrationV2ProviderTurn,
+  OrchestrationV2SandboxOperationIntent,
+} from "@t3tools/contracts";
+import { sandboxRole } from "../briqSandbox.ts";
+
+const hash = (value: string) => NodeCrypto.createHash("sha256").update(value).digest("hex");
+
+/** Only the allocated child's original root operation can outlive its T3 process. */
+export function sandboxRootRecovery(
+  run: OrchestrationV2Run,
+  attempt: OrchestrationV2RunAttempt,
+  providerThread: OrchestrationV2ProviderThread,
+): OrchestrationV2SandboxOperationIntent | undefined {
+  if (
+    sandboxRole() !== "child" ||
+    process.env.T3_CLOUD_THREAD_ID !== run.threadId ||
+    run.providerThreadId !== providerThread.id ||
+    run.activeAttemptId !== attempt.id ||
+    attempt.runId !== run.id ||
+    attempt.rootNodeId !== run.rootNodeId ||
+    attempt.providerThreadId !== providerThread.id ||
+    providerThread.appThreadId !== run.threadId ||
+    providerThread.driver !== "codex" ||
+    run.modelSelection.instanceId !== "codex" ||
+    providerThread.ownerNodeId !== null ||
+    run.restartContinuationOfRunId !== undefined ||
+    run.status === "rolled_back"
+  )
+    return;
+  const nativeThreadId = providerThread.nativeThreadRef?.nativeId;
+  const initial = providerThread.sandboxIntents?.initial;
+  if (!nativeThreadId || initial?.result?.nativeId !== nativeThreadId) return;
+  const roots = Object.values(attempt.sandboxIntents ?? {}).filter(
+    (intent) => intent.trigger.kind === "root",
+  );
+  if (
+    roots.length !== 1 ||
+    Object.values(attempt.sandboxIntents ?? {}).some(
+      (intent) => intent.trigger.kind === "continuation",
+    )
+  )
+    return;
+  const root = roots[0]!;
+  if (
+    root.method !== "turn/start" ||
+    root.key !== `turn_${hash(JSON.stringify([run.threadId, run.id, attempt.id, "root"]))}` ||
+    root.requestHash !== hash(root.requestJson) ||
+    !Number.isSafeInteger(root.ordinal) ||
+    root.ordinal < 1
+  )
+    return;
+  try {
+    const request = JSON.parse(root.requestJson) as { threadId?: unknown };
+    if (request.threadId !== nativeThreadId) return;
+  } catch {
+    return;
+  }
+  return root;
+}
+
+/** Evidence protects retained work even when its immutable binding cannot be executed. */
+export function sandboxRootRecoveryOwned(input: {
+  readonly run: OrchestrationV2Run;
+  readonly attempts: ReadonlyArray<OrchestrationV2RunAttempt>;
+  readonly providerTurns: ReadonlyArray<OrchestrationV2ProviderTurn>;
+}): boolean {
+  const { run } = input;
+  if (
+    sandboxRole() !== "child" ||
+    process.env.T3_CLOUD_THREAD_ID !== run.threadId ||
+    run.modelSelection.instanceId !== "codex" ||
+    run.restartContinuationOfRunId !== undefined ||
+    run.status === "rolled_back"
+  )
+    return false;
+  const attempts = input.attempts.filter(
+    (attempt) => attempt.runId === run.id || attempt.id === run.activeAttemptId,
+  );
+  return (
+    attempts.some((attempt) => Object.keys(attempt.sandboxIntents ?? {}).length > 0) ||
+    input.providerTurns.some(
+      (turn) =>
+        turn.nativeTurnRef?.nativeId != null &&
+        attempts.some((attempt) => turn.runAttemptId === attempt.id),
+    )
+  );
+}
