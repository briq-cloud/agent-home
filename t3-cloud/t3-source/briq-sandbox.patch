+import { ProjectId } from "@t3tools/contracts";
+import { managedSourceDigest } from "./ManagedProjectSource.ts";
+import { expect, it } from "@effect/vitest";
+import { takeManagedBootstrap, MANAGED_BRIDGE_BOOTSTRAP } from "./managedBridgeBootstrap.ts";
+import * as Redacted from "effect/Redacted";
+
+const value = {
+  link: {
+    allocationId: "allocation",
+    threadId: "thread:project:phone",
+    environmentId: "environment",
+    projectId: "project",
+    providerInstanceId: "codex",
+    httpBaseUrl: "https://child.example",
+    token: "private-child-sentinel",
+    sessionId: "session",
+    ownerGeneration: "generation",
+  },
+  host: {
+    threadId: "thread:project:phone",
+    modelSelection: { instanceId: "codex", model: "mock" },
+    runtimeMode: "approval-required",
+    interactionMode: "default",
+  },
+};
+
+it("consumes its only private bootstrap and preserves the child bearer as Redacted", () => {
+  const environment = { [MANAGED_BRIDGE_BOOTSTRAP]: JSON.stringify(value) };
+  const parsed = takeManagedBootstrap(environment);
+  expect(Redacted.value(parsed.link.token)).toBe("private-child-sentinel");
+  expect(JSON.stringify(parsed)).not.toContain("private-child-sentinel");
+  expect(environment[MANAGED_BRIDGE_BOOTSTRAP]).toBeUndefined();
+});
+
+it("denies mismatched identities and origins with a fixed error after deleting private bytes", () => {
+  for (const changed of [
+    { ...value, host: { ...value.host, threadId: "foreign" } },
+    {
+      ...value,
+      host: { ...value.host, modelSelection: { instanceId: "claudeAgent", model: "mock" } },
+    },
+    { ...value, link: { ...value.link, httpBaseUrl: "https://child.example/redirect" } },
+    { ...value, link: { ...value.link, httpBaseUrl: "http://child.example" } },
+  ]) {
+    const environment = { [MANAGED_BRIDGE_BOOTSTRAP]: JSON.stringify(changed) };
+    expect(() => takeManagedBootstrap(environment)).toThrowError(
+      "The managed bridge bootstrap is unavailable.",
+    );
+    expect(environment[MANAGED_BRIDGE_BOOTSTRAP]).toBeUndefined();
+  }
+  for (const encoded of ["private-child-sentinel", "x".repeat(65537)]) {
+    const environment = { [MANAGED_BRIDGE_BOOTSTRAP]: encoded };
+    expect(() => takeManagedBootstrap(environment)).toThrowError(
+      "The managed bridge bootstrap is unavailable.",
+    );
+    expect(environment[MANAGED_BRIDGE_BOOTSTRAP]).toBeUndefined();
+  }
+});
+
+it("preserves a bound repository strategy and refuses unmapped existing worktrees", () => {
+  const identity = {
+    version: 1 as const,
+    sourceId: "source000000000001",
+    hostProjectId: ProjectId.make("host-project"),
+    logicalRoot: "/projects/source000000000001",
+    clone: { remoteUrl: "https://github.com/example/repository", protocol: "https" as const },
+  };
+  const projectSource = { ...identity, sourceDigest: managedSourceDigest(identity) };
+  const project = {
+    projectSource,
+    workspaceStrategy: { type: "worktree", baseRef: "main", startFromOrigin: false },
+    title: "Repository",
+    createdAt: "2026-11-06T00:00:00.000Z",
+  };
+  const host = { ...value.host, project };
+  expect(
+    takeManagedBootstrap({ [MANAGED_BRIDGE_BOOTSTRAP]: JSON.stringify({ ...value, host }) }).host
+      .project,
+  ).toEqual(project);
+  expect(() =>
+    takeManagedBootstrap({
+      [MANAGED_BRIDGE_BOOTSTRAP]: JSON.stringify({
+        ...value,
+        host: {
+          ...host,
+          project: {
+            ...project,
+            workspaceStrategy: { type: "existing_worktree", worktreePath: "/foreign" },
+          },
+        },
+      }),
+    }),
+  ).toThrowError("The managed bridge bootstrap is unavailable.");
+});
