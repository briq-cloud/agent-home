+++ b/apps/server/src/sandbox/managedBridgeClient.ts
@@ -0,0 +1,384 @@
+import {
+  parseThreadSegmentFromAttachmentId,
+  toSafeThreadAttachmentSegment,
+} from "../attachmentStore.ts";
+// MIT License — Copyright (c) 2026 T3 Tools Inc.; see repository LICENSE.
+import {
+  AuthWebSocketTicketResult,
+  ManagedProjectReceipt,
+  type ManagedProjectPrepareRequest,
+  getProviderAttachmentLimitError,
+  isProviderSendTurnSupportedImageMimeType,
+  type ChatAttachment,
+  type PersistChatAttachmentsInput,
+  type OrchestrationV2ShellSnapshot,
+  type OrchestrationV2ThreadProjection,
+  type ThreadId,
+  ORCHESTRATION_PROTOCOL_QUERY_PARAM,
+  ORCHESTRATION_PROTOCOL_VERSION,
+  ORCHESTRATION_V2_WS_METHODS,
+  WS_METHODS,
+  WsRpcGroup,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Redacted from "effect/Redacted";
+import * as Schedule from "effect/Schedule";
+import * as Schema from "effect/Schema";
+import { FetchHttpClient, HttpClient, HttpClientRequest, HttpClientResponse } from "effect/http";
+import * as RpcClient from "effect/rpc/RpcClient";
+import * as RpcSerialization from "effect/rpc/RpcSerialization";
+import * as Socket from "effect/socket/Socket";
+import * as Stream from "effect/Stream";
+
+import type { ManagedPreparationLink } from "./managedBridgeManager.ts";
+import { ManagedBridgeLink, ManagedBridgeError } from "./managedBridgeLink.ts";
+
+export function managedSandboxSocketUrl(origin: string, ticket: string): string {
+  const base = new URL(origin);
+  if (base.protocol !== "https:" || base.origin !== origin || base.username || base.password)
+    throw new Error("Invalid managed child origin.");
+  const url = new URL("/ws", base);
+  url.protocol = "wss:";
+  url.searchParams.set("wsTicket", ticket);
+  url.searchParams.set(ORCHESTRATION_PROTOCOL_QUERY_PARAM, String(ORCHESTRATION_PROTOCOL_VERSION));
+  return url.href;
+}
+
+const failure = (message: string) => () => new ManagedBridgeError({ message });
+
+/** Transport failures are uncertain writes; this client never retries an RPC or a socket. */
+const connectNative = Effect.fn("ManagedBridge.connectNative")(function* (
+  link: Pick<typeof ManagedBridgeLink.Type, "httpBaseUrl" | "environmentId" | "token">,
+) {
+  const http = yield* HttpClient.HttpClient;
+  const origin = new URL(link.httpBaseUrl);
+  if (
+    origin.protocol !== "https:" ||
+    origin.origin !== link.httpBaseUrl ||
+    origin.username ||
+    origin.password
+  )
+    return yield* new ManagedBridgeError({ message: "Invalid managed child origin." });
+  const descriptor = yield* http
+    .execute(HttpClientRequest.get(`${origin.origin}/.well-known/t3/environment`))
+    .pipe(
+      Effect.flatMap(HttpClientResponse.filterStatusOk),
+      Effect.flatMap(
+        HttpClientResponse.schemaBodyJson(Schema.Struct({ environmentId: Schema.String })),
+      ),
+      Effect.provideService(FetchHttpClient.RequestInit, { redirect: "error" }),
+      Effect.timeout("15 seconds"),
+      Effect.mapError(failure("The managed child identity is unavailable.")),
+    );
+  if (descriptor.environmentId !== link.environmentId)
+    return yield* new ManagedBridgeError({ message: "The managed child identity changed." });
+  const ticket = yield* http
+    .execute(
+      HttpClientRequest.post(`${origin.origin}/api/auth/websocket-ticket/rpc`).pipe(
+        HttpClientRequest.bearerToken(Redacted.value(link.token)),
+      ),
+    )
+    .pipe(
+      Effect.flatMap(HttpClientResponse.filterStatusOk),
+      Effect.flatMap(HttpClientResponse.schemaBodyJson(AuthWebSocketTicketResult)),
+      Effect.provideService(FetchHttpClient.RequestInit, { redirect: "error" }),
+      Effect.timeout("15 seconds"),
+      Effect.mapError(failure("The managed child refused its native session.")),
+    );
+  const protocol = yield* Layer.build(
+    Layer.effect(
+      RpcClient.Protocol,
+      RpcClient.makeProtocolSocket({
+        pingTimeout: "15 seconds",
+        retryTransientErrors: false,
+        retryPolicy: Schedule.recurs(0),
+      }),
+    ).pipe(
+      Layer.provide(
+        Layer.mergeAll(
+          Socket.layerWebSocket(
+            managedSandboxSocketUrl(link.httpBaseUrl, Redacted.value(ticket.ticket)),
+            {
+              openTimeout: "15 seconds",
+            },
+          ).pipe(Layer.provide(Socket.layerWebSocketConstructorGlobal)),
+          RpcSerialization.layerJson,
+        ),
+      ),
+    ),
+  );
+  const client = yield* RpcClient.make(WsRpcGroup).pipe(Effect.provide(protocol));
+  const config = yield* client[WS_METHODS.serverGetConfig]({}).pipe(
+    Effect.mapError(failure("The managed child did not answer.")),
+  );
+  if (config.environment.environmentId !== link.environmentId)
+    return yield* new ManagedBridgeError({ message: "The managed child identity changed." });
+  return { client, config };
+});
+
+export const connectManagedPreparation = connectNative;
+
+export const prepareManagedProject = Effect.fn("ManagedBridge.prepareManagedProject")(function* (
+  link: typeof ManagedPreparationLink.Type,
+  input: typeof ManagedProjectPrepareRequest.Type,
+  start: boolean,
+) {
+  if (
+    input.allocationId !== link.allocationId ||
+    input.sourceId !== link.sourceId ||
+    input.sourceDigest !== link.sourceDigest ||
+    input.projectId !== link.projectId ||
+    input.workspaceRoot !== link.workspaceRoot
+  )
+    return yield* new ManagedBridgeError({ message: "The managed preparation identity changed." });
+  const { client } = yield* connectNative(link);
+  const checkReceipt = (receipt: typeof ManagedProjectReceipt.Type) => {
+    if (
+      receipt.allocationId !== input.allocationId ||
+      receipt.sourceId !== input.sourceId ||
+      receipt.sourceDigest !== input.sourceDigest ||
+      receipt.projectId !== input.projectId ||
+      receipt.workspaceRoot !== input.workspaceRoot ||
+      receipt.cloneOperationId !== input.cloneOperationId ||
+      receipt.remoteUrl !== input.projectSource.clone.remoteUrl
+    )
+      throw new Error();
+    return receipt;
+  };
+  const { sourceId, sourceDigest, allocationId, projectId, workspaceRoot, cloneOperationId } =
+    input;
+  const read = client["managedProject.read"]({
+    sourceId,
+    sourceDigest,
+    allocationId,
+    projectId,
+    workspaceRoot,
+    cloneOperationId,
+  }).pipe(Effect.mapError(failure("The managed clone requires reconciliation.")));
+  // Subscribe before native mutation so even a short clone cannot lose its terminal event.
+  const snapshots = client[WS_METHODS.subscribeProjectClones]({}).pipe(Stream.toPull);
+  const pull = yield* snapshots;
+  yield* pull.pipe(Effect.mapError(failure("The managed clone stream is unavailable.")));
+  let receipt = yield* start
+    ? client["managedProject.prepare"](input).pipe(
+        Effect.mapError(failure("The managed clone requires reconciliation.")),
+      )
+    : read;
+  receipt = yield* Effect.try({
+    try: () => checkReceipt(receipt),
+    catch: failure("The managed clone identity changed."),
+  });
+  while (receipt.phase === "started") {
+    yield* pull.pipe(Effect.mapError(failure("The managed clone requires reconciliation.")));
+    receipt = yield* read;
+    yield* Effect.try({
+      try: () => checkReceipt(receipt),
+      catch: failure("The managed clone identity changed."),
+    });
+  }
+  if (
+    receipt.phase !== "done" ||
+    !receipt.headCommit ||
+    !/^[a-f0-9]{40,64}$/.test(receipt.headCommit)
+  )
+    return yield* new ManagedBridgeError({
+      message: "The managed project is not ready; reconcile the native clone.",
+    });
+  return receipt;
+});
+
+export const connectManagedSandbox = Effect.fn("ManagedBridge.connectManagedSandbox")(function* (
+  link: typeof ManagedBridgeLink.Type,
+) {
+  const { client, config } = yield* connectNative(link);
+  const check = (threadId: string): Effect.Effect<void, ManagedBridgeError> =>
+    threadId === link.threadId
+      ? Effect.void
+      : Effect.fail(new ManagedBridgeError({ message: "This bridge belongs to another thread." }));
+  const dispatchable = new Set([
+    "message.dispatch",
+    "runtime-request.respond",
+    "thread.stop",
+    "run.interrupt",
+    "thread.user-input.dismiss",
+  ]);
+  return {
+    config,
+    threadStop: config.environment.capabilities.threadStop === true,
+    defaultModelSelection:
+      config.settings.defaultModelSelection?.instanceId === link.providerInstanceId
+        ? config.settings.defaultModelSelection
+        : null,
+    providers: config.providers.filter(
+      (provider) => provider.instanceId === link.providerInstanceId,
+    ),
+    persistAttachments: Effect.fn("ManagedBridge.persistAttachments")(function* (
+      input: PersistChatAttachmentsInput,
+    ) {
+      yield* check(input.threadId);
+      if (
+        getProviderAttachmentLimitError(input.attachments) ||
+        input.attachments.some(
+          (attachment) => !isProviderSendTurnSupportedImageMimeType(attachment.mimeType),
+        )
+      )
+        return yield* new ManagedBridgeError({
+          message: "Only supported images within message limits can be attached.",
+        });
+      const result = yield* client[WS_METHODS.assetsPersistChatAttachments](input).pipe(
+        Effect.mapError(failure("The managed child image upload requires reconciliation.")),
+      );
+      if (
+        !managedImageAttachmentsAllowed(result.attachments, input.threadId) ||
+        result.attachments.length !== input.attachments.length ||
+        result.attachments.some((attachment, index) => {
+          const image = input.attachments[index];
+          return (
+            image === undefined ||
+            attachment.type !== "image" ||
+            attachment.name !== image.name ||
+            attachment.mimeType !== image.mimeType ||
+            attachment.sizeBytes !== image.sizeBytes
+          );
+        })
+      )
+        return yield* new ManagedBridgeError({
+          message: "The managed child image identity changed.",
+        });
+      return result.attachments;
+    }),
+    projection: Effect.fn("ManagedBridge.projection")(function* (
+      threadId: Parameters<
+        (typeof client)[typeof ORCHESTRATION_V2_WS_METHODS.getThreadProjection]
+      >[0]["threadId"],
+    ) {
+      yield* check(threadId);
+      const shell = yield* client[ORCHESTRATION_V2_WS_METHODS.subscribeShell]({
+        omitIdleSubagents: false,
+        omitOlderSettled: false,
+      }).pipe(
+        Stream.filter((item) => item.kind === "snapshot"),
+        Stream.runHead,
+        Effect.timeout("15 seconds"),
+        Effect.mapError(failure("The managed child shell requires reconciliation.")),
+      );
+      if (Option.isNone(shell))
+        return yield* new ManagedBridgeError({
+          message: "The complete managed child shell is unavailable.",
+        });
+      return yield* managedProjectionFromShell(
+        link,
+        threadId,
+        shell.value.snapshot,
+        client[ORCHESTRATION_V2_WS_METHODS.getThreadProjection]({ threadId }).pipe(
+          Effect.mapError(failure("The managed child projection requires reconciliation.")),
+        ),
+      );
+    }),
+    launch: Effect.fn("ManagedBridge.launch")(function* (
+      input: Parameters<(typeof client)[typeof ORCHESTRATION_V2_WS_METHODS.launchThread]>[0],
+    ) {
+      yield* check(input.threadId ?? "");
+      if (
+        input.projectId !== link.projectId ||
+        input.modelSelection.instanceId !== link.providerInstanceId ||
+        input.workspaceStrategy.type === "existing_worktree" ||
+        !managedImageAttachmentsAllowed(
+          input.initialMessage?.attachments ?? [],
+          input.threadId ?? "",
+        )
+      )
+        return yield* new ManagedBridgeError({
+          message: "Managed child launch binding or image attachments changed.",
+        });
+      return yield* client[ORCHESTRATION_V2_WS_METHODS.launchThread](input).pipe(
+        Effect.asVoid,
+        Effect.mapError(failure("The managed child launch requires reconciliation.")),
+      );
+    }),
+    dispatch: Effect.fn("ManagedBridge.dispatch")(function* (
+      command: Parameters<(typeof client)[typeof ORCHESTRATION_V2_WS_METHODS.dispatchCommand]>[0],
+    ) {
+      if (!("threadId" in command) || !dispatchable.has(command.type))
+        return yield* new ManagedBridgeError({ message: "Only thread commands are supported." });
+      yield* check(command.threadId);
+      if (
+        command.type === "message.dispatch" &&
+        (!managedImageAttachmentsAllowed(command.attachments ?? [], command.threadId) ||
+          (command.modelSelection !== undefined &&
+            command.modelSelection.instanceId !== link.providerInstanceId))
+      )
+        return yield* new ManagedBridgeError({
+          message: "Managed child message binding or image attachments changed.",
+        });
+      return yield* client[ORCHESTRATION_V2_WS_METHODS.dispatchCommand](command).pipe(
+        Effect.asVoid,
+        Effect.mapError(failure("The managed child command requires reconciliation.")),
+      );
+    }),
+    subscribe: (
+      threadId: Parameters<
+        (typeof client)[typeof ORCHESTRATION_V2_WS_METHODS.subscribeThread]
+      >[0]["threadId"],
+    ) =>
+      Stream.unwrap(
+        check(threadId).pipe(
+          Effect.as(
+            client[ORCHESTRATION_V2_WS_METHODS.subscribeThread]({ threadId }).pipe(
+              Stream.mapError(failure("The managed child stream requires reconciliation.")),
+            ),
+          ),
+        ),
+      ),
+  };
+});
+
+export const managedProjectionFromShell = Effect.fn("ManagedBridge.projectionFromShell")(function* (
+  binding: Pick<typeof ManagedBridgeLink.Type, "threadId" | "projectId" | "providerInstanceId">,
+  threadId: ThreadId,
+  snapshot: OrchestrationV2ShellSnapshot,
+  readProjection: Effect.Effect<OrchestrationV2ThreadProjection, ManagedBridgeError>,
+) {
+  if (threadId !== binding.threadId || snapshot.olderSettled !== undefined)
+    return yield* new ManagedBridgeError({
+      message: "The complete managed child shell is unavailable.",
+    });
+  const stored = [...snapshot.threads, ...snapshot.archivedThreads].find(
+    (thread) => thread.id === threadId,
+  );
+  if (stored === undefined) return Option.none();
+  if (
+    stored.projectId !== binding.projectId ||
+    stored.modelSelection.instanceId !== binding.providerInstanceId
+  )
+    return yield* new ManagedBridgeError({ message: "The managed child thread identity changed." });
+  const projection = yield* readProjection;
+  if (
+    projection.thread.id !== threadId ||
+    projection.thread.projectId !== binding.projectId ||
+    projection.thread.modelSelection.instanceId !== binding.providerInstanceId
+  )
+    return yield* new ManagedBridgeError({
+      message: "The managed child projection identity changed.",
+    });
+  return Option.some(projection);
+});
+
+export function managedImageAttachmentsAllowed(
+  attachments: ReadonlyArray<ChatAttachment>,
+  threadId: string,
+): boolean {
+  return (
+    getProviderAttachmentLimitError(attachments) === undefined &&
+    attachments.every(
+      (attachment) =>
+        attachment.type === "image" &&
+        isProviderSendTurnSupportedImageMimeType(attachment.mimeType) &&
+        parseThreadSegmentFromAttachmentId(attachment.id) !== null &&
+        parseThreadSegmentFromAttachmentId(attachment.id) ===
+          toSafeThreadAttachmentSegment(threadId),
+    )
+  );
+}
