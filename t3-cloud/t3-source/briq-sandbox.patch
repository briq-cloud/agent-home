@@ -0,0 +1,598 @@
+import * as NodeAssert from "node:assert/strict";
+import * as NodeURL from "node:url";
+import {
+  CommandId,
+  EnvironmentId,
+  MessageId,
+  ProviderInstanceId,
+  ThreadId,
+  WS_METHODS,
+  ORCHESTRATION_V2_WS_METHODS as RPC,
+  BriqSandboxAllocation,
+  type OrchestrationV2ThreadProjection,
+  type OrchestrationV2Run,
+  type OrchestrationV2TurnItem,
+  type OrchestrationV2ProviderTurn,
+} from "@t3tools/contracts";
+import * as Deferred from "effect/Deferred";
+import * as Crypto from "effect/Crypto";
+import * as FileSystem from "effect/FileSystem";
+import * as Schema from "effect/Schema";
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeFileSystem from "@effect/platform-node/NodeFileSystem";
+import * as HttpObservability from "@t3tools/shared/httpObservability";
+import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as Redacted from "effect/Redacted";
+import * as Stream from "effect/Stream";
+import * as Socket from "effect/socket/Socket";
+import * as NodeSocket from "@effect/platform-node/NodeSocket";
+import {
+  bootstrapRemoteBearerSession,
+  issueRemoteWebSocketTicket,
+} from "../../../../packages/client-runtime/src/authorization/remote.ts";
+import { BearerConnectionTarget } from "../../../../packages/client-runtime/src/connection/model.ts";
+import {
+  make as makeSessions,
+  type RpcSession,
+} from "../../../../packages/client-runtime/src/rpc/session.ts";
+
+const AccessSchema = Schema.Struct({
+  origin: Schema.String,
+  environmentId: Schema.String,
+  token: Schema.String,
+});
+type Access = typeof AccessSchema.Type;
+const SavedThreadSchema = Schema.Struct({
+  allocation: BriqSandboxAllocation,
+  access: AccessSchema,
+  nativeIds: Schema.Array(Schema.String),
+  intentKeys: Schema.Array(Schema.String),
+  receiptBindings: Schema.Array(Schema.String),
+  runIds: Schema.Array(Schema.String),
+});
+type SavedThread = typeof SavedThreadSchema.Type;
+const SavedSchema = Schema.Struct({
+  version: Schema.Literal(2),
+  threads: Schema.Array(SavedThreadSchema),
+});
+const savedJson = Schema.fromJsonString(SavedSchema);
+const InputSchema = Schema.Struct({
+  origin: Schema.String,
+  environmentId: Schema.String,
+  pairingCredential: Schema.String,
+  edgeCookie: Schema.optionalKey(Schema.String),
+  statePath: Schema.String,
+});
+const decodeInputJson = Schema.decodeSync(Schema.fromJsonString(InputSchema));
+type Input = typeof InputSchema.Type;
+type SubscriptionError = Stream.Error<ReturnType<RpcSession["client"][typeof RPC.subscribeThread]>>;
+let input: Input;
+let phase: string | undefined;
+const origin = (value: string) => {
+  const url = new URL(value);
+  NodeAssert.equal(url.protocol, "https:");
+  NodeAssert.equal(url.origin + "/", url.href);
+  return url.origin;
+};
+const uuid = Effect.flatMap(Crypto.Crypto, (crypto) => crypto.randomUUIDv4());
+const commandId = uuid.pipe(Effect.map(CommandId.make));
+const connect = Effect.fn("nativeChildAcceptance.connect")(function* (access: Access) {
+  const httpBaseUrl = origin(access.origin);
+  const ticket = yield* issueRemoteWebSocketTicket({
+    httpBaseUrl,
+    bearerToken: access.token,
+    use: "rpc",
+  });
+  const socketUrl = new URL("/ws", httpBaseUrl);
+  socketUrl.protocol = "wss:";
+  socketUrl.searchParams.set("wsTicket", Redacted.value(ticket.ticket));
+  const environmentId = EnvironmentId.make(access.environmentId);
+  const factory = yield* makeSessions();
+  const session = yield* factory.connect({
+    environmentId,
+    label: "native child acceptance",
+    httpBaseUrl,
+    socketUrl: socketUrl.href,
+    httpAuthorization: null,
+    target: new BearerConnectionTarget({
+      environmentId,
+      label: "native child acceptance",
+      connectionId: yield* uuid,
+    }),
+  });
+  yield* session.ready;
+  return session;
+});
+const pair = Effect.fn("nativeChildAcceptance.pair")(function* (
+  url: string,
+  credential: string,
+  environmentId: string,
+) {
+  const result = yield* bootstrapRemoteBearerSession({ httpBaseUrl: origin(url), credential });
+  return { origin: origin(url), environmentId, token: result.access_token } satisfies Access;
+});
+const nativeIds = (projection: OrchestrationV2ThreadProjection) => {
+  const ids = projection.providerThreads
+    .map((row) => row.nativeThreadRef?.nativeId)
+    .filter((id): id is string => !!id);
+  NodeAssert.ok(ids.length > 0, "native provider identity must be persisted");
+  return [...new Set(ids)].sort();
+};
+const intents = (projection: OrchestrationV2ThreadProjection) =>
+  projection.attempts.flatMap((attempt) => Object.values(attempt.sandboxIntents ?? {}));
+const receiptBindings = (projection: OrchestrationV2ThreadProjection) =>
+  [
+    ...intents(projection)
+      .filter((intent) => intent.result)
+      .map((intent) => `${intent.key}:${intent.result!.nativeId}:${intent.result!.resultHash}`),
+    ...projection.providerTurns
+      .filter((turn) => turn.sandboxResult)
+      .map(
+        (turn) =>
+          `${turn.sandboxResult!.key}:${turn.sandboxResult!.nativeId}:${turn.sandboxResult!.resultHash}`,
+      ),
+  ].sort();
+const turn = Effect.fn("nativeChildAcceptance.turn")(function* (
+  session: RpcSession,
+  threadId: ThreadId,
+  provider: "codex" | "claudeAgent",
+  text: string,
+  marker: string,
+  fileMarker: string,
+  requiredCommand: string,
+  previousKeys: readonly string[],
+) {
+  const messageId = MessageId.make(yield* uuid);
+  const subscribed = yield* Deferred.make<void, SubscriptionError>();
+  const completed = yield* Deferred.make<OrchestrationV2Run, SubscriptionError>();
+  const streamed: OrchestrationV2TurnItem[] = [];
+  const receiptEvents: Array<{ sequence: number; turn: OrchestrationV2ProviderTurn }> = [];
+  let events = 0;
+  const stream = session.client[RPC.subscribeThread]({ threadId, requestCompletionMarker: true });
+  const subscription = yield* stream.pipe(
+    Stream.runForEach((item) =>
+      Effect.gen(function* () {
+        NodeAssert.ok(++events <= 4096, "bounded acceptance event stream");
+        if (item.kind === "snapshot" || item.kind === "synchronized")
+          yield* Deferred.succeed(subscribed, undefined);
+        if (item.kind !== "event") return;
+        const event = item.event;
+        if (
+          event.type === "turn-item.updated" &&
+          event.payload.type === "assistant_message" &&
+          event.payload.streaming
+        )
+          streamed.push(event.payload);
+        if (event.type === "provider-turn.updated")
+          receiptEvents.push({ sequence: item.sequence, turn: event.payload });
+        if (
+          (event.type === "run.created" || event.type === "run.updated") &&
+          event.payload.userMessageId === messageId
+        ) {
+          NodeAssert.equal(event.payload.threadId, threadId);
+          NodeAssert.equal(event.payload.providerInstanceId, provider);
+          NodeAssert.ok(
+            !["failed", "cancelled", "interrupted"].includes(event.payload.status),
+            "native turn must complete",
+          );
+          if (event.payload.status === "completed")
+            yield* Deferred.succeed(completed, event.payload);
+        }
+      }),
+    ),
+    Effect.catchCause((cause) =>
+      Effect.all([Deferred.failCause(subscribed, cause), Deferred.failCause(completed, cause)]),
+    ),
+    Effect.forkScoped,
+  );
+  yield* Deferred.await(subscribed).pipe(Effect.raceFirst(session.closed));
+  yield* session.client[RPC.dispatchCommand]({
+    type: "message.dispatch",
+    commandId: yield* commandId,
+    createdBy: "user",
+    creationSource: "web",
+    threadId,
+    messageId,
+    text,
+    attachments: [],
+    dispatchMode: { type: "start_immediately" },
+  });
+  const completedRun = yield* Deferred.await(completed).pipe(Effect.raceFirst(session.closed));
+  const projection = yield* session.client[RPC.getThreadProjection]({ threadId });
+  const run = projection.runs.find((row) => row.id === completedRun.id);
+  NodeAssert.ok(run && run.providerThreadId);
+  NodeAssert.equal(run.userMessageId, messageId);
+  NodeAssert.equal(run.threadId, threadId);
+  NodeAssert.equal(run.providerInstanceId, provider);
+  NodeAssert.equal(run.status, "completed");
+  NodeAssert.equal(run.providerThreadId, completedRun.providerThreadId);
+  const providerThread = projection.providerThreads.find((row) => row.id === run.providerThreadId);
+  NodeAssert.ok(providerThread?.nativeThreadRef?.nativeId);
+  NodeAssert.equal(providerThread.appThreadId, threadId);
+  NodeAssert.equal(providerThread.providerInstanceId, provider);
+  NodeAssert.equal(providerThread.driver, provider);
+  const nativeId = providerThread.nativeThreadRef.nativeId;
+  const attempts = projection.attempts.filter((row) => row.runId === run.id);
+  NodeAssert.ok(attempts.length > 0);
+  for (const attempt of attempts) {
+    NodeAssert.equal(attempt.providerThreadId, run.providerThreadId);
+    NodeAssert.equal(attempt.providerInstanceId, provider);
+    if (attempt.nativeThreadId !== undefined) NodeAssert.equal(attempt.nativeThreadId, nativeId);
+  }
+  NodeAssert.ok(
+    streamed.some(
+      (item) =>
+        item.threadId === threadId &&
+        item.runId === run.id &&
+        item.providerThreadId === run.providerThreadId &&
+        item.type === "assistant_message" &&
+        item.text.includes(marker),
+    ),
+    "this run must stream its own distinct marker",
+  );
+  const commands = projection.turnItems.filter(
+    (item) =>
+      item.threadId === threadId &&
+      item.runId === run.id &&
+      item.providerThreadId === run.providerThreadId &&
+      item.type === "command_execution",
+  );
+  NodeAssert.ok(commands.length > 0);
+  for (const command of commands) {
+    const { item } = yield* session.client[RPC.getTurnItem]({ threadId, itemId: command.id });
+    NodeAssert.ok(item && item.type === "command_execution");
+    NodeAssert.equal(item.id, command.id);
+    NodeAssert.equal(item.threadId, threadId);
+    NodeAssert.equal(item.runId, run.id);
+    NodeAssert.equal(item.providerThreadId, run.providerThreadId);
+    NodeAssert.equal(item.input, requiredCommand, "only the scripted read command is allowed");
+    NodeAssert.equal(item.exitCode, 0);
+    NodeAssert.ok(
+      item.output?.includes(marker) && item.output.includes(fileMarker),
+      "official item detail must contain this turn marker and the file content",
+    );
+  }
+  if (previousKeys.length > 0)
+    NodeAssert.ok(
+      !projection.turnItems.some((item) => item.runId === run.id && item.type === "file_change"),
+      "followup must read without rewriting",
+    );
+  NodeAssert.ok(
+    projection.messages.some(
+      (message) =>
+        message.threadId === threadId &&
+        message.runId === run.id &&
+        message.role === "assistant" &&
+        !message.streaming &&
+        message.text.includes(marker) &&
+        message.text.includes(fileMarker),
+    ),
+    "this run's assistant must consume its own tool result",
+  );
+  const currentIntents = attempts.flatMap((attempt) => Object.values(attempt.sandboxIntents ?? {}));
+  const keys: string[] = [];
+  if (provider === "codex") {
+    NodeAssert.ok(
+      currentIntents.length > 0,
+      "current attempt needs durable sandbox operation intent",
+    );
+    for (const intent of currentIntents) {
+      NodeAssert.ok(!previousKeys.includes(intent.key), "followup must adopt a new operation");
+      NodeAssert.ok(intent.result && intent.adoption);
+      NodeAssert.equal(intent.adoption.resultHash, intent.result.resultHash);
+      NodeAssert.equal(intent.adoption.nativeId, intent.result.nativeId);
+      NodeAssert.ok(
+        receiptEvents.some(
+          (event) =>
+            event.sequence === intent.adoption?.eventSequence &&
+            event.turn.providerThreadId === run.providerThreadId &&
+            attempts.some((attempt) => attempt.id === event.turn.runAttemptId) &&
+            event.turn.nativeTurnRef?.nativeId === intent.result?.nativeId,
+        ),
+        "adoption must reference this attempt's exact committed native-turn event",
+      );
+      keys.push(intent.key);
+    }
+  } else {
+    const turns = projection.providerTurns.filter(
+      (row) =>
+        row.providerThreadId === run.providerThreadId &&
+        attempts.some((attempt) => attempt.id === row.runAttemptId),
+    );
+    NodeAssert.ok(turns.length > 0);
+    for (const turn of turns) {
+      NodeAssert.ok(turn.sandboxResult && turn.nativeTurnRef?.nativeId);
+      NodeAssert.equal(turn.sandboxResult.nativeId, turn.nativeTurnRef.nativeId);
+      NodeAssert.equal(turn.sandboxResult.provider, provider);
+      NodeAssert.ok(!previousKeys.includes(turn.sandboxResult.key));
+      NodeAssert.ok(
+        receiptEvents.some(
+          (event) =>
+            event.turn.id === turn.id &&
+            event.turn.runAttemptId === turn.runAttemptId &&
+            event.turn.sandboxResult?.key === turn.sandboxResult?.key &&
+            event.turn.sandboxResult?.resultHash === turn.sandboxResult?.resultHash &&
+            event.turn.status === "completed",
+        ),
+        "Claude receipt must match a committed event for this attempt",
+      );
+      keys.push(turn.sandboxResult.key);
+    }
+  }
+  yield* Fiber.interrupt(subscription);
+  return { projection, nativeId, providerThreadId: run.providerThreadId, runId: run.id, keys };
+});
+export const expectedMissingProjection = (error: unknown, foreign: ThreadId) => {
+  if (
+    !error ||
+    typeof error !== "object" ||
+    !("_tag" in error) ||
+    error._tag !== "OrchestrationV2GetThreadProjectionError" ||
+    !("threadId" in error) ||
+    error.threadId !== foreign ||
+    !("message" in error) ||
+    error.message !== `Failed to load orchestration V2 thread ${foreign}` ||
+    !("cause" in error)
+  )
+    return false;
+  const cause = error.cause;
+  if (
+    !(cause instanceof Error) ||
+    cause.name !== "OrchestratorProjectionError" ||
+    cause.message !== `Failed to load orchestration projection for thread ${foreign}.`
+  )
+    return false;
+  const missing = cause.cause;
+  return (
+    missing instanceof Error &&
+    missing.name === "ProjectionStoreThreadNotFoundError" &&
+    missing.message === `No orchestration projection exists for thread ${foreign}.` &&
+    missing.cause === undefined
+  );
+};
+const exercise = Effect.gen(function* () {
+  const central = yield* connect(
+    yield* pair(input.origin, input.pairingCredential, input.environmentId),
+  );
+  const config = yield* central.initialConfig;
+  NodeAssert.equal(config.briqSandboxRole, "central");
+  NodeAssert.deepEqual([...(config.briqSandboxProviders ?? [])].sort(), ["claudeAgent", "codex"]);
+  const savedThreads: SavedThread[] = [];
+  const saved: typeof SavedSchema.Type = { version: 2, threads: savedThreads };
+  const sessions: RpcSession[] = [];
+  for (const providerInstanceId of ["codex", "claudeAgent"] as const) {
+    const threadId = ThreadId.make(yield* uuid);
+    const allocation = yield* central.client[RPC.allocateSandboxThread]({
+      threadId,
+      providerInstanceId,
+    });
+    NodeAssert.equal(allocation.threadId, threadId);
+    NodeAssert.equal(allocation.providerInstanceId, providerInstanceId);
+    origin(allocation.connection.url);
+    const access = yield* pair(
+      allocation.connection.url,
+      allocation.connection.credential,
+      allocation.environmentId,
+    );
+    const child = yield* connect(access);
+    sessions.push(child);
+    const childConfig = yield* child.initialConfig;
+    NodeAssert.equal(childConfig.briqSandboxRole, "child");
+    NodeAssert.equal(childConfig.briqSandboxProviderInstanceId, providerInstanceId);
+    const provider = childConfig.providers.find(
+      (row) =>
+        row.instanceId === providerInstanceId &&
+        row.driver === providerInstanceId &&
+        row.enabled &&
+        row.status === "ready",
+    );
+    NodeAssert.ok(provider?.models[0]?.slug, "assigned native bridge must have a model catalog");
+    if (providerInstanceId === "claudeAgent")
+      NodeAssert.equal(provider.auth.status, "authenticated");
+    const modelSelection = {
+      instanceId: ProviderInstanceId.make(providerInstanceId),
+      model: provider.models[0].slug,
+    };
+    yield* child.client[WS_METHODS.projectsMutate]({
+      type: "project.create",
+      commandId: yield* commandId,
+      projectId: allocation.project.id,
+      title: allocation.project.title,
+      workspaceRoot: allocation.project.workspaceRoot,
+    });
+    yield* child.client[RPC.dispatchCommand]({
+      type: "thread.create",
+      commandId: yield* commandId,
+      createdBy: "user",
+      creationSource: "web",
+      threadId,
+      projectId: allocation.project.id,
+      title: "Native acceptance",
+      modelSelection,
+      runtimeMode: "full-access",
+      interactionMode: "default",
+      branch: null,
+      worktreePath: null,
+    });
+    const firstMarker = `NATIVE_ACCEPTANCE_FIRST_${providerInstanceId}_${threadId}`;
+    const nextMarker = `NATIVE_ACCEPTANCE_FOLLOWUP_${providerInstanceId}_${threadId}`;
+    const firstCommand = "cat /work/native-acceptance.txt";
+    const nextCommand = `printf '%s\n' '${nextMarker}'; cat /work/native-acceptance.txt`;
+    const first = yield* turn(
+      child,
+      threadId,
+      providerInstanceId,
+      `ACCEPTANCE_WRITE_READ ${firstMarker}: write ${firstMarker} to /work/native-acceptance.txt with the native file tool, execute exactly ${firstCommand}, then stream the returned marker.`,
+      firstMarker,
+      firstMarker,
+      firstCommand,
+      [],
+    ).pipe(Effect.scoped);
+    const followup = yield* turn(
+      child,
+      threadId,
+      providerInstanceId,
+      `ACCEPTANCE_FOLLOWUP ${nextMarker}: without writing files execute exactly ${nextCommand}, then stream the complete returned output including both markers.`,
+      nextMarker,
+      firstMarker,
+      nextCommand,
+      first.keys,
+    ).pipe(Effect.scoped);
+    NodeAssert.notEqual(followup.runId, first.runId);
+    NodeAssert.equal(followup.providerThreadId, first.providerThreadId);
+    NodeAssert.equal(
+      followup.nativeId,
+      first.nativeId,
+      "followup must use the same active native conversation",
+    );
+    savedThreads.push({
+      allocation,
+      access,
+      nativeIds: nativeIds(followup.projection),
+      intentKeys: intents(followup.projection)
+        .map((row) => row.key)
+        .sort(),
+      receiptBindings: receiptBindings(followup.projection),
+      runIds: followup.projection.runs.map((row) => row.id).sort(),
+    });
+  }
+  const [firstThread, secondThread] = savedThreads;
+  const [firstSession, secondSession] = sessions;
+  NodeAssert.ok(firstThread && secondThread && firstSession && secondSession);
+  NodeAssert.notEqual(firstThread.allocation.allocationId, secondThread.allocation.allocationId);
+  NodeAssert.notEqual(firstThread.access.origin, secondThread.access.origin);
+  for (const { localThread, foreignThread, session } of [
+    { localThread: firstThread, foreignThread: secondThread, session: firstSession },
+    { localThread: secondThread, foreignThread: firstThread, session: secondSession },
+  ]) {
+    const local = localThread.allocation.threadId;
+    const control = yield* session.client[RPC.getThreadProjection]({ threadId: local });
+    NodeAssert.equal(control.thread.id, local);
+    const foreign = foreignThread.allocation.threadId;
+    const denied = yield* session.client[RPC.getThreadProjection]({ threadId: foreign }).pipe(
+      Effect.result,
+    );
+    NodeAssert.ok(
+      denied._tag === "Failure" && expectedMissingProjection(denied.failure, foreign),
+      "only the exact foreign-thread not-found chain qualifies; unavailable or unrecognized errors fail",
+    );
+    yield* session.probe;
+    const after = yield* session.client[RPC.getThreadProjection]({ threadId: local });
+    NodeAssert.equal(after.thread.id, local);
+  }
+  const fs = yield* FileSystem.FileSystem;
+  const serialized = yield* Schema.encodeEffect(savedJson)(saved);
+  yield* fs.writeFileString(input.statePath, serialized, { mode: 0o600, flag: "wx" });
+});
+const recover = Effect.gen(function* () {
+  const fs = yield* FileSystem.FileSystem;
+  const saved = yield* Schema.decodeEffect(savedJson)(yield* fs.readFileString(input.statePath));
+  NodeAssert.equal(saved.version, 2);
+  NodeAssert.equal(saved.threads.length, 2);
+  for (const thread of saved.threads) {
+    const child = yield* connect(thread.access);
+    const projection = yield* child.client[RPC.getThreadProjection]({
+      threadId: thread.allocation.threadId,
+    });
+    NodeAssert.deepEqual(nativeIds(projection), thread.nativeIds);
+    NodeAssert.deepEqual(
+      projection.runs.map((row) => row.id).sort(),
+      thread.runIds,
+      "reconnection must not create a model run",
+    );
+    NodeAssert.deepEqual(
+      intents(projection)
+        .map((row) => row.key)
+        .sort(),
+      thread.intentKeys,
+      "reconnection must not create another native mutation",
+    );
+    NodeAssert.deepEqual(
+      receiptBindings(projection),
+      thread.receiptBindings,
+      "read-only reconnect must preserve exact native receipt bindings",
+    );
+    for (const intent of intents(projection)) NodeAssert.ok(intent.result && intent.adoption);
+  }
+});
+const makeAcceptanceHttpLayer = (edgeCookie?: string) =>
+  Layer.mergeAll(
+    Layer.effect(
+      HttpClient.HttpClient,
+      Effect.gen(function* () {
+        const client = yield* HttpClient.HttpClient;
+        return edgeCookie === undefined
+          ? client
+          : client.pipe(
+              HttpClient.mapRequest((request) =>
+                HttpClientRequest.setHeader(request, "cookie", edgeCookie),
+              ),
+            );
+      }),
+    ).pipe(Layer.provide(FetchHttpClient.layer)),
+    Layer.succeed(FetchHttpClient.RequestInit, { redirect: "error" }),
+    HttpObservability.layer,
+  );
+export const makeAcceptanceSocketLayer = (edgeCookie?: string) =>
+  Layer.effect(
+    Socket.WebSocketConstructor,
+    Effect.gen(function* () {
+      const makeWebSocket = yield* Socket.WebSocketConstructor;
+      const constructor: Socket.WebSocketConstructor["Service"] = (url, options) => {
+        if (edgeCookie === undefined) return makeWebSocket(url, options);
+        const clientOptions: Socket.WebSocketClientOptions =
+          typeof options === "object" && !Array.isArray(options) ? options : { protocols: options };
+        const headers = new Headers(clientOptions?.headers);
+        headers.set("cookie", edgeCookie);
+        return makeWebSocket(url, { ...clientOptions, headers: Object.fromEntries(headers) });
+      };
+      return constructor;
+    }),
+  ).pipe(Layer.provide(NodeSocket.layerWebSocketConstructor));
+async function main() {
+  try {
+    const chunks: Buffer[] = [];
+    for await (const chunk of process.stdin) chunks.push(Buffer.from(chunk));
+    input = decodeInputJson(Buffer.concat(chunks).toString("utf8"));
+    phase = process.argv[2];
+    NodeAssert.ok(phase === "exercise" || phase === "recover");
+    origin(input.origin);
+    await Effect.runPromise(
+      (phase === "exercise" ? exercise : recover).pipe(
+        Effect.scoped,
+        Effect.provide(
+          Layer.mergeAll(
+            makeAcceptanceHttpLayer(input.edgeCookie),
+            makeAcceptanceSocketLayer(input.edgeCookie),
+            NodeCrypto.layer,
+            NodeFileSystem.layer,
+          ),
+        ),
+      ),
+    );
+    process.stdout.write(
+      JSON.stringify({
+        status: "passed",
+        phase,
+        scope:
+          "official T3 client allocation, pairing, native streamed tool roundtrip, followup identity and persisted per-run native results",
+        subscriptionQualified: false,
+        claudeBrokerAdoptionQualified: false,
+        uncertainReceiptQualified: false,
+        childProcessIsolationQualified: false,
+        nativeIsolationQualified: false,
+        noModelReplayQualified: false,
+      }) + "\n",
+    );
+  } catch {
+    process.stderr.write(
+      "Native child acceptance failed; credentials and RPC payloads suppressed.\n",
+    );
+    process.exitCode = 1;
+  }
+}
+if (process.argv[1] && import.meta.url === NodeURL.pathToFileURL(process.argv[1]).href)
+  await main();
