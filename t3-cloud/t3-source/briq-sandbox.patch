@@ -0,0 +1,122 @@
+import { createAttachmentId } from "../attachmentStore.ts";
+import { expect, it } from "@effect/vitest";
+import {
+  ChatAttachmentId,
+  ProjectId,
+  ProviderInstanceId,
+  ThreadId,
+  type OrchestrationV2ShellSnapshot,
+  type OrchestrationV2ThreadProjection,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Option from "effect/Option";
+import {
+  managedProjectionFromShell,
+  managedImageAttachmentsAllowed,
+} from "./managedBridgeClient.ts";
+import { ManagedBridgeError } from "./managedBridgeLink.ts";
+
+const binding = {
+  threadId: ThreadId.make("native-thread"),
+  projectId: ProjectId.make("child-project"),
+  providerInstanceId: "codex" as const,
+};
+const thread = {
+  id: binding.threadId,
+  projectId: binding.projectId,
+  modelSelection: { instanceId: ProviderInstanceId.make("codex"), model: "mock" },
+};
+const shell = (threads: unknown[]) =>
+  ({
+    schemaVersion: 1,
+    snapshotSequence: 1,
+    threads,
+    archivedThreads: [],
+    projects: [],
+  }) as unknown as OrchestrationV2ShellSnapshot;
+const projection = { thread } as OrchestrationV2ThreadProjection;
+
+it.effect("only a successful complete child shell absence authorizes initial creation", () =>
+  Effect.gen(function* () {
+    const absent = yield* managedProjectionFromShell(
+      binding,
+      binding.threadId,
+      shell([]),
+      Effect.die("Missing threads must not require projection hydration."),
+    );
+    expect(Option.isNone(absent)).toBe(true);
+    const accepted = yield* managedProjectionFromShell(
+      binding,
+      binding.threadId,
+      shell([thread]),
+      Effect.succeed(projection),
+    );
+    expect(Option.getOrThrow(accepted)).toBe(projection);
+    const failed = yield* managedProjectionFromShell(
+      binding,
+      binding.threadId,
+      shell([thread]),
+      Effect.fail(new ManagedBridgeError({ message: "Hydration failed." })),
+    ).pipe(Effect.exit);
+    expect(Exit.isFailure(failed)).toBe(true);
+  }),
+);
+
+it.effect("incomplete shells and foreign child thread or projection identities fail closed", () =>
+  Effect.gen(function* () {
+    const invalid = [
+      managedProjectionFromShell(
+        binding,
+        ThreadId.make("foreign"),
+        shell([]),
+        Effect.succeed(projection),
+      ),
+      managedProjectionFromShell(
+        binding,
+        binding.threadId,
+        {
+          ...shell([]),
+          olderSettled: { before: "2026-01-01T00:00:00Z", asOfSequence: 1, counts: [] },
+        } as OrchestrationV2ShellSnapshot,
+        Effect.succeed(projection),
+      ),
+      managedProjectionFromShell(
+        binding,
+        binding.threadId,
+        shell([{ ...thread, projectId: "foreign" }]),
+        Effect.succeed(projection),
+      ),
+      managedProjectionFromShell(
+        binding,
+        binding.threadId,
+        shell([thread]),
+        Effect.succeed({ thread: { ...thread, id: "foreign" } } as OrchestrationV2ThreadProjection),
+      ),
+    ];
+    for (const effect of invalid) expect(Exit.isFailure(yield* Effect.exit(effect))).toBe(true);
+  }),
+);
+
+it.effect("accepts only supported images scoped to the child thread", () =>
+  Effect.sync(() => {
+    const image = {
+      type: "image" as const,
+      id: ChatAttachmentId.make(createAttachmentId(binding.threadId)!),
+      name: "screen.png",
+      mimeType: "image/png",
+      sizeBytes: 3,
+    };
+    expect(managedImageAttachmentsAllowed([image], binding.threadId)).toBe(true);
+    expect(managedImageAttachmentsAllowed([image], "foreign")).toBe(false);
+    expect(
+      managedImageAttachmentsAllowed([{ ...image, mimeType: "image/svg+xml" }], binding.threadId),
+    ).toBe(false);
+    expect(managedImageAttachmentsAllowed([{ ...image, type: "file" }], binding.threadId)).toBe(
+      false,
+    );
+    expect(
+      managedImageAttachmentsAllowed([{ ...image, sizeBytes: 81 * 1024 * 1024 }], binding.threadId),
+    ).toBe(false);
+  }),
+);
