@@ -0,0 +1,94 @@
+import { modelSelectionsEqual } from "@t3tools/shared/model";
+import type { ModelSelection } from "@t3tools/contracts";
+import { ThreadId } from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import { sandboxCommandRejection, sandboxRole, sandboxSessionRejection } from "../briqSandbox.ts";
+import { ManagedThreadBinding } from "./ManagedThreadBinding.ts";
+
+// A local service capability, never decoded from native RPC input.
+export class ManagedThreadCreation extends Context.Service<
+  ManagedThreadCreation,
+  {
+    readonly threadId: string;
+    readonly projectId: string;
+    readonly providerInstanceId: string;
+  }
+>()("t3/sandbox/managedThreadPolicy/ManagedThreadCreation") {}
+
+export const managedCommandRejection = Effect.fn("managedCommandRejection")(function* (
+  command: Omit<Parameters<typeof sandboxCommandRejection>[0], "modelSelection"> & {
+    readonly projectId?: string;
+    readonly modelSelection?: ModelSelection | undefined;
+  },
+) {
+  if (sandboxRole() !== "central") return sandboxCommandRejection(command);
+  if (command.type === "thread.create") {
+    const creation = yield* Effect.serviceOption(ManagedThreadCreation);
+    if (
+      Option.isSome(creation) &&
+      creation.value.threadId === command.threadId &&
+      creation.value.projectId === command.projectId &&
+      creation.value.providerInstanceId === command.modelSelection?.instanceId
+    )
+      return undefined;
+    return "Managed threads must be created through native launch.";
+  }
+  if (
+    command.type === "thread.metadata.update" &&
+    Object.keys(command).some((key) => !["type", "commandId", "threadId", "title"].includes(key))
+  )
+    return "Only title metadata can change on a managed thread.";
+  const allowed = new Set([
+    "message.dispatch",
+    "runtime-request.respond",
+    "thread.stop",
+    "run.interrupt",
+    "thread.metadata.update",
+    "thread.archive",
+    "thread.unarchive",
+    "thread.delete",
+    "thread.visit",
+    "thread.mark-unread",
+    "thread.pin",
+    "thread.unpin",
+    "thread.user-input.dismiss",
+  ]);
+  if (!allowed.has(command.type) || !command.threadId) return sandboxCommandRejection(command);
+  const bindings = yield* Effect.serviceOption(ManagedThreadBinding);
+  if (Option.isNone(bindings)) return "Managed thread binding is unavailable.";
+  const binding = yield* bindings.value.read(ThreadId.make(command.threadId)).pipe(Effect.option);
+  if (
+    Option.isNone(binding) ||
+    (command.modelSelection !== undefined &&
+      !modelSelectionsEqual(command.modelSelection, binding.value.host.modelSelection))
+  )
+    return "Managed thread binding does not match.";
+  return undefined;
+});
+
+export const managedSessionRejection = Effect.fn("managedSessionRejection")(function* (
+  input: Parameters<typeof sandboxSessionRejection>[0],
+) {
+  if (sandboxRole() !== "central") return sandboxSessionRejection(input);
+  const bindings = yield* Effect.serviceOption(ManagedThreadBinding);
+  if (Option.isNone(bindings)) return "Managed thread binding is unavailable.";
+  const binding = yield* bindings.value.read(ThreadId.make(input.threadId)).pipe(Effect.option);
+  if (
+    Option.isNone(binding) ||
+    input.instanceId !== binding.value.allocation.providerInstanceId ||
+    (input.persistedInstanceId !== undefined && input.persistedInstanceId !== input.instanceId) ||
+    (input.persistedDriver !== undefined && input.persistedDriver !== input.instanceId)
+  )
+    return "Managed thread provider does not match.";
+  return undefined;
+});
+
+export const isManagedThread = Effect.fn("isManagedThread")(function* (threadId: ThreadId) {
+  if (sandboxRole() !== "central") return false;
+  const binding = yield* Effect.serviceOption(ManagedThreadBinding);
+  if (Option.isNone(binding)) return yield* Effect.die("Managed binding unavailable.");
+  yield* binding.value.read(threadId).pipe(Effect.orDie);
+  return true;
+});
