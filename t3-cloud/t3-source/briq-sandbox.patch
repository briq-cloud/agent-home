diff --git a/apps/web/src/hooks/openBriqSandboxThread.test.ts b/apps/web/src/hooks/openBriqSandboxThread.test.ts
new file mode 100644
index 00000000..ba2c42ef
--- /dev/null
+++ b/apps/web/src/hooks/openBriqSandboxThread.test.ts
@@ -0,0 +1,181 @@
+import { describe, expect, it, vi } from "vite-plus/test";
+import { EnvironmentId, ThreadId } from "@t3tools/contracts";
+import type { AnyRouter } from "@tanstack/react-router";
+
+const state = vi.hoisted(() => ({
+  calls: [] as string[],
+  payloads: [] as unknown[],
+  admitted: ["codex", "claudeAgent"],
+  failAllocation: false,
+  provider: "codex" as string | null,
+  returnedProvider: "codex",
+  childProvider: "codex",
+}));
+vi.mock("@t3tools/client-runtime/state/runtime", () => ({
+  runAtomCommand: async (_registry: unknown, operation: string, payload: unknown) => {
+    state.calls.push(operation);
+    state.payloads.push(payload);
+    if (operation === "allocate")
+      return state.failAllocation
+        ? { _tag: "Failure" }
+        : {
+            _tag: "Success",
+            value: {
+              providerInstanceId: state.returnedProvider,
+              allocationId: "allocation",
+              environmentId: "child",
+              threadId: "thread",
+              project: { id: "project", title: "Sandbox", workspaceRoot: "/work" },
+              connection: { url: "https://child.example/", credential: "synthetic-pairing" },
+            },
+          };
+    if (operation === "wait")
+      return {
+        _tag: "Success",
+        value: {
+          briqSandboxRole: "child",
+          briqSandboxProviderInstanceId: state.childProvider,
+          providers: [
+            {
+              instanceId: state.childProvider,
+              driver: state.childProvider,
+              enabled: true,
+              status: "ready",
+              auth: { status: "authenticated" },
+              models: [{ slug: "model" }],
+            },
+          ],
+        },
+      };
+    return { _tag: "Success", value: undefined };
+  },
+}));
+vi.mock("../rpc/atomRegistry", () => ({
+  appAtomRegistry: {
+    get: () =>
+      new Map([["home", { briqSandboxRole: "central", briqSandboxProviders: state.admitted }]]),
+  },
+}));
+vi.mock("../state/server", () => ({ environmentServerConfigsAtom: {} }));
+vi.mock("../localApi", () => ({
+  readLocalApi: () => ({ contextMenu: { show: async () => state.provider } }),
+}));
+vi.mock("../state/briqSandbox", () => ({ allocateSandboxThread: "allocate" }));
+vi.mock("../connection/onboarding", () => ({
+  connectPairing: "pair",
+  waitForSandboxConnection: "wait",
+}));
+vi.mock("../state/projects", () => ({ projectEnvironment: { create: "child-project" } }));
+vi.mock("../state/threads", () => ({ threadEnvironment: { create: "child-thread" } }));
+vi.stubGlobal("window", { innerWidth: 1280, innerHeight: 800 });
+import { openBriqSandboxThread } from "./openBriqSandboxThread";
+
+describe("fresh cloud home thread entry", () => {
+  it("allocates without a home project, pairs the child, then creates only its real native thread", async () => {
+    state.calls = [];
+    state.failAllocation = false;
+    state.provider = state.returnedProvider = state.childProvider = "codex";
+    const navigate = vi.fn();
+    await openBriqSandboxThread(
+      { navigate } as unknown as AnyRouter,
+      EnvironmentId.make("home"),
+      ThreadId.make("thread"),
+    );
+    expect(state.calls).toEqual(["allocate", "pair", "wait", "child-project", "child-thread"]);
+    expect(navigate).toHaveBeenCalledWith({
+      to: "/$environmentId/$threadId",
+      params: { environmentId: "child", threadId: "thread" },
+    });
+  });
+  it("never falls back to home creation after an allocator or read-only permission failure", async () => {
+    state.calls = [];
+    state.failAllocation = true;
+    state.provider = state.returnedProvider = state.childProvider = "codex";
+    const navigate = vi.fn();
+    await expect(
+      openBriqSandboxThread(
+        { navigate } as unknown as AnyRouter,
+        EnvironmentId.make("home"),
+        ThreadId.make("thread"),
+      ),
+    ).rejects.toThrow("no local thread");
+    expect(state.calls).toEqual(["allocate"]);
+    expect(navigate).not.toHaveBeenCalled();
+  });
+});
+
+it("uses the admitted Claude choice and rejects cross-provider allocation or child binding before project creation", async () => {
+  for (const mismatch of ["none", "allocation", "child"]) {
+    state.calls = [];
+    state.failAllocation = false;
+    state.provider = "claudeAgent";
+    state.returnedProvider = mismatch === "allocation" ? "codex" : "claudeAgent";
+    state.childProvider = mismatch === "child" ? "codex" : "claudeAgent";
+    const navigate = vi.fn();
+    const operation = openBriqSandboxThread(
+      { navigate } as unknown as AnyRouter,
+      EnvironmentId.make("home"),
+      ThreadId.make("thread"),
+      "claudeAgent",
+    );
+    if (mismatch === "none") {
+      await operation;
+      expect(navigate).toHaveBeenCalled();
+    } else {
+      await expect(operation).rejects.toThrow();
+      expect(state.calls).not.toContain("child-project");
+    }
+  }
+});
+
+it("uses the sole admitted provider explicitly and never allocates empty admission", async () => {
+  for (const admitted of [["codex"], ["claudeAgent"], []]) {
+    state.admitted = admitted;
+    state.calls = [];
+    state.payloads = [];
+    state.failAllocation = false;
+    state.returnedProvider = state.childProvider = admitted[0] ?? "codex";
+    const navigate = vi.fn();
+    const operation = openBriqSandboxThread(
+      { navigate } as unknown as AnyRouter,
+      EnvironmentId.make("home"),
+      ThreadId.make("thread"),
+    );
+    if (admitted.length === 0) {
+      await expect(operation).rejects.toThrow();
+      expect(state.calls).toEqual([]);
+    } else {
+      await operation;
