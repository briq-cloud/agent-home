--- /dev/null
+++ b/packages/provider-acp/src/server/ResponseReceipts.ts
@@ -0,0 +1,69 @@
+export interface ResponseReceiptBinding {
+  readonly key: string;
+  readonly sessionId: string;
+  readonly generation: number;
+  readonly transportRequestId: string;
+  nativeRequestId?: string;
+  written: boolean;
+  accepted: boolean;
+  withdrawn: boolean;
+  completed: boolean;
+}
+
+// One live ACP runtime owns these transient correlations; no command is replayed here.
+export class ResponseReceipts {
+  private readonly entries = new Map<string, ResponseReceiptBinding>();
+  bind(key: string, sessionId: string, generation: number, transportRequestId: string): boolean {
+    const existing = this.entries.get(key);
+    if (existing !== undefined && existing.generation >= generation) return false;
+    this.entries.set(key, {
+      key,
+      sessionId,
+      generation,
+      transportRequestId,
+      written: false,
+      accepted: false,
+      withdrawn: false,
+      completed: false,
+    });
+    return true;
+  }
+  attach(transportRequestId: string, nativeRequestId: string, generation: number): void {
+    const entry = this.byTransport(transportRequestId, generation);
+    if (entry !== undefined) entry.nativeRequestId = nativeRequestId;
+  }
+  byTransport(transportRequestId: string, generation: number): ResponseReceiptBinding | undefined {
+    return [...this.entries.values()].find(
+      (entry) => entry.transportRequestId === transportRequestId && entry.generation === generation,
+    );
+  }
+  observe(
+    key: string,
+    sessionId: string,
+    generation: number,
+    withdrawn: boolean,
+  ): ResponseReceiptBinding | undefined {
+    const entry = this.entries.get(key);
+    if (
+      entry === undefined ||
+      entry.completed ||
+      entry.generation !== generation ||
+      entry.sessionId !== sessionId ||
+      entry.nativeRequestId === undefined
+    )
+      return undefined;
+    if (withdrawn) entry.withdrawn = true;
+    else entry.accepted = true;
+    return entry;
+  }
+  written(transportRequestId: string, generation: number): ResponseReceiptBinding | undefined {
+    const entry = this.byTransport(transportRequestId, generation);
+    if (entry !== undefined) entry.written = true;
+    return entry;
+  }
+  complete(entry: ResponseReceiptBinding): boolean {
+    if (entry.completed || !entry.written || (!entry.accepted && !entry.withdrawn)) return false;
+    entry.completed = true;
+    return true;
+  }
+}
