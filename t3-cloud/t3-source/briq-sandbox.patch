+import { describe, expect, it, vi } from "vite-plus/test";
+import { EnvironmentId, ThreadId } from "@t3tools/contracts";
+import type { AnyRouter } from "@tanstack/react-router";
+
+const state = vi.hoisted(() => ({ calls: [] as string[], failAllocation: false }));
+vi.mock("@t3tools/client-runtime/state/runtime", () => ({
+  runAtomCommand: async (_registry: unknown, operation: string) => {
+    state.calls.push(operation);
+    if (operation === "allocate") return state.failAllocation ? { _tag: "Failure" } : {
+      _tag: "Success", value: { allocationId: "allocation", environmentId: "child", threadId: "thread",
+        project: { id: "project", title: "Sandbox", workspaceRoot: "/work" },
+        connection: { url: "https://child.example/", credential: "synthetic-pairing" } },
+    };
+    if (operation === "wait") return { _tag: "Success", value: { briqSandboxRole: "child",
+      providers: [{ instanceId: "codex", models: [{ slug: "model" }] }] } };
+    return { _tag: "Success", value: undefined };
+  },
+}));
+vi.mock("../rpc/atomRegistry", () => ({ appAtomRegistry: {} }));
+vi.mock("../state/briqSandbox", () => ({ allocateSandboxThread: "allocate" }));
+vi.mock("../connection/onboarding", () => ({ connectPairing: "pair", waitForSandboxConnection: "wait" }));
+vi.mock("../state/projects", () => ({ projectEnvironment: { create: "child-project" } }));
+vi.mock("../state/threads", () => ({ threadEnvironment: { create: "child-thread" } }));
+import { openBriqSandboxThread } from "./openBriqSandboxThread";
+
+describe("fresh cloud home thread entry", () => {
+  it("allocates without a home project, pairs the child, then creates only its real native thread", async () => {
+    state.calls = []; state.failAllocation = false;
+    const navigate = vi.fn();
+    await openBriqSandboxThread({ navigate } as unknown as AnyRouter,
+      EnvironmentId.make("home"), ThreadId.make("thread"));
+    expect(state.calls).toEqual(["allocate", "pair", "wait", "child-project", "child-thread"]);
+    expect(navigate).toHaveBeenCalledWith({ to: "/$environmentId/$threadId",
+      params: { environmentId: "child", threadId: "thread" } });
+  });
+  it("never falls back to home creation after an allocator or read-only permission failure", async () => {
+    state.calls = []; state.failAllocation = true;
+    const navigate = vi.fn();
+    await expect(openBriqSandboxThread({ navigate } as unknown as AnyRouter,
+      EnvironmentId.make("home"), ThreadId.make("thread"))).rejects.toThrow("no local thread");
+    expect(state.calls).toEqual(["allocate"]);
+    expect(navigate).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/web/src/hooks/openBriqSandboxThread.ts b/apps/web/src/hooks/openBriqSandboxThread.ts
new file mode 100644
index 00000000..f26b1c5d
--- /dev/null
+++ b/apps/web/src/hooks/openBriqSandboxThread.ts
@@ -0,0 +1,46 @@
+import type { AnyRouter } from "@tanstack/react-router";
+import { ProviderInstanceId, type EnvironmentId, type ThreadId } from "@t3tools/contracts";
+import { runAtomCommand } from "@t3tools/client-runtime/state/runtime";
+import { allocateSandboxThread } from "../state/briqSandbox";
+import { appAtomRegistry } from "../rpc/atomRegistry";
+import { connectPairing, waitForSandboxConnection } from "../connection/onboarding";
+import { projectEnvironment } from "../state/projects";
+import { threadEnvironment } from "../state/threads";
+
+export async function openBriqSandboxThread(router: AnyRouter, environmentId: EnvironmentId, threadId: ThreadId) {
+  const options = { reportFailure: false, reportDefect: false };
+  const result = await runAtomCommand(appAtomRegistry, allocateSandboxThread, {
+    environmentId, input: { threadId },
+  }, options);
+  if (result._tag === "Failure") throw new Error("Sandbox allocation failed. Check cloud connections before retrying; no local thread was created.");
+  const allocation = result.value;
+  const destination = new URL(allocation.connection.url);
+  if (allocation.threadId !== threadId || destination.protocol !== "https:" || destination.username ||
+      destination.password || destination.search || destination.hash || destination.pathname !== "/")
+    throw new Error("Invalid sandbox allocation destination.");
+  const connected = await runAtomCommand(appAtomRegistry, connectPairing, {
+    host: destination.origin, pairingCode: allocation.connection.credential,
+    expectedEnvironmentId: allocation.environmentId,
+  }, options);
+  if (connected._tag === "Failure") throw new Error("Could not pair the allocated sandbox.");
+  const ready = await runAtomCommand(appAtomRegistry, waitForSandboxConnection, allocation.environmentId, options);
+  if (ready._tag === "Failure" || ready.value.briqSandboxRole !== "child")
+    throw new Error("The allocated sandbox did not establish its native connection.");
+  const provider = ready.value.providers.find((item) => item.instanceId === "codex");
+  const model = provider?.models[0]?.slug;
+  if (!model) throw new Error("The sandbox Codex bridge has no available model catalog.");
+  const project = await runAtomCommand(appAtomRegistry, projectEnvironment.create, {
+    environmentId: allocation.environmentId,
+    input: { projectId: allocation.project.id, title: allocation.project.title,
+      workspaceRoot: allocation.project.workspaceRoot },
+  }, options);
+  if (project._tag === "Failure") throw new Error("Could not create the sandbox project.");
+  const thread = await runAtomCommand(appAtomRegistry, threadEnvironment.create, {
+    environmentId: allocation.environmentId,
+    input: { threadId, projectId: allocation.project.id, title: "New thread",
+      modelSelection: { instanceId: ProviderInstanceId.make("codex"), model },
+      runtimeMode: "approval-required", interactionMode: "default", branch: null, worktreePath: null },
+  }, options);
+  if (thread._tag === "Failure") throw new Error("Could not create the allocated sandbox thread.");
+  await router.navigate({ to: "/$environmentId/$threadId", params: { environmentId: allocation.environmentId, threadId } });
+}
